def _lamato():
    """The Lamato runs west to the sea across the south of the plain:
    every side between a hex north of it and one south of it."""
    out = []
    for c in range(len(MAP[0])):
        for r in range(len(MAP)):
            if r >= SOUTH[c] or MAP[r][c] == '~':
                continue
            for n in hexgrid.neighbours((c, r)):
                nc, nr = n
                if 0 <= nc < len(MAP[0]) and 0 <= nr < len(MAP) and \
                        nr >= SOUTH[nc] and MAP[nr][nc] != '~':
                    out.append('%s/%s' % (hexgrid.hid((c, r)),
                                          hexgrid.hid(n)))
    return out


