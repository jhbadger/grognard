@grognard.icon('maida')
def draw_icon(p, n):
    """A red line on a yellow plain, with the sea and a hill town."""
    p.fill('#9ac4e0')
    p.rect(0, n * 0.45, n, n * 0.55, '#d4c07a')
    p.rect(0, n * 0.45, n * 0.18, n * 0.55, '#3a6ca8')
    p.disc(n * 0.85, n * 0.5, n * 0.28, '#b8a670')
    p.rect(n * 0.74, n * 0.28, n * 0.16, n * 0.08, '#e8dcc0')
    p.rect(n * 0.78, n * 0.22, n * 0.04, n * 0.06, '#9a4a32')
    for i in range(5):
        x = n * (0.26 + i * 0.1)
        p.rect(x, n * 0.62, n * 0.06, n * 0.14, '#b8443a')
        p.rect(x, n * 0.58, n * 0.06, n * 0.04, '#1a1a1a')
        p.rect(x, n * 0.74, n * 0.06, n * 0.04, '#f0f0e8')
    for i in range(3):
        x = n * (0.3 + i * 0.14)
        p.rect(x, n * 0.84, n * 0.1, n * 0.1, '#4a68a8')


