def TURN_NAME(t):
    """Twenty minutes a turn, from eight in the morning."""
    m = 8 * 60 + (t - 1) * 20
    return ('4 Jul 1806', '%d:%02d %s' % ((m // 60 - 1) % 12 + 1, m % 60,
                                          'AM' if m < 12 * 60 else 'PM'))


