# Each side's steps; half of them gone and it gives up the field.
BREAK = 0.5


def _steps(e, side):
    return sum(u.max_steps for u in e.units.values() if u.side == side)


def _score(e):
    return 'British %d VP, French %d.' % (e.vp('br'), e.vp('fr'))


def ON_TURN(e, side):
    """What happened on the plain, and an army breaking: at the start of
    its own turn, a side that has lost half its steps leaves the field."""
    if side == 'fr':
        if e.turn == 1:
            e.say('Reynier, beaten by the British in Egypt five years '
                  'ago, means to settle the account. The drums beat the '
                  'pas de charge.')
        if e.turn > 1 and e.lost['fr'] >= _steps(e, 'fr') * BREAK:
            e.finish('br', 'British victory. %s The French break and run '
                     'for the Lamato and the road to Catanzaro; the '
                     'Calabrian peasants are waiting for the stragglers.'
                     % _score(e))
    else:
        if e.turn == 1:
            e.say("In Oswald's brigade, de Watteville's Swiss in British "
                  'red look across the plain at the Swiss battalion in '
                  'French service, also in red.')
        if e.turn == ROSS:
            e.say('Colonel Ross brings the 20th Foot up from the boats '
                  'at the double, toward the British left.')
        if e.turn == HEAT:
            e.say('It is ten o\'clock and blazing hot. Men in wool coats '
                  'are falling down without a wound.')
        if e.turn > 1 and e.lost['br'] >= _steps(e, 'br') * BREAK:
            e.finish('fr', 'French victory. %s Stuart falls back on the '
                     "beach at Sant'Eufemia, and the Navy takes what is "
                     'left of his army off to Sicily.' % _score(e))


def COMBAT_SHIFTS(e, target, attackers, support):
    """Line against column: on open ground, French infantry attacking
    British infantry lose a column to the volley, and British infantry
    attacking French infantry gain one (the volley, then the bayonet).
    The 9th Chasseurs charging into the open gain a column.  From 10:00,
    in the heat, every attack is a column worse."""
    out = []
    t = e.board.terrain(target) or {}
    defenders = e.at(target)
    foot = [u for u in attackers if u.kind in FOOT]
    if t.get('open') and attackers and len(foot) == len(attackers) and \
            any(u.kind in FOOT for u in defenders):
        if e.side == 'fr':
            out.append((-1, 'column against line'))
        else:
            out.append((1, 'volley and bayonet'))
    if t.get('open') and any(u.kind == 'chasseur' for u in attackers):
        out.append((1, 'charge'))
    if e.turn >= HEAT:
        out.append((-1, 'heat'))
    return out


