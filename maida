def VICTORY(e):
    """If neither army has broken by noon, the score decides: each
    side scores the enemy's steps destroyed and the objective it holds
    of the enemy's (the ford for the British, the landing beach for the
    French).  The British, who need a clear win to make the landing
    worth it, must finish 3 ahead (set from games between computer
    players: ./maida --simulate 60)."""
    br, fr = e.vp('br'), e.vp('fr')
    m = br - fr
    if m >= 6:
        return 'br', ('British victory. %s Reynier pulls back across the '
                      'Lamato toward Catanzaro, and all Calabria rises '
                      'behind him.' % _score(e))
    if m >= 3:
        return 'br', ('British marginal victory. %s The French go back '
                      'over the river; the British hold the plain.'
                      % _score(e))
    if m > -4:
        return 'fr', ('French marginal victory. %s Stuart holds the '
                      'beach, but Reynier still holds Calabria.'
                      % _score(e))
    return 'fr', ('French victory. %s The British are pushed back to '
                  'their boats, and the revolt in Calabria dies.'
                  % _score(e))


