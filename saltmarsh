@grognard.symbol('hover')
def s_hover(p, x, y, w, h, c):
    """A skimmer: an oval hull on a skirt of air."""
    p.oval(x + (w - 1) / 2, y + (h - 1) / 2 - 1, (w - 1) / 2 - 2,
           max(1, (h - 1) / 2 - 2), c)
    for k in range(3):
        xx = x + 2 + k * (w - 4) // 3
        p.line(xx, y + h - 2, xx + max(1, (w - 4) // 6), y + h - 2, c)


@grognard.symbol('missile')
def s_missile(p, x, y, w, h, c):
    """A missile tank: the armour oval with a missile in it."""
    counters.SYMBOLS['armor'](p, x, y, w, h, c)
    cx = x + w // 2
    p.line(cx - w // 4, y + h // 2, cx + w // 4, y + h // 2, c)
    p.set(cx + w // 4 - 1, y + h // 2 - 1, c)
    p.set(cx + w // 4 - 1, y + h // 2 + 1, c)


@grognard.symbol('missile_hover')
def s_missile_hover(p, x, y, w, h, c):
    s_hover(p, x, y, w, h, c)
    cx = x + w // 2
    p.line(cx - w // 5, y + h // 2 - 1, cx + w // 5, y + h // 2 - 1, c)


@grognard.symbol('convoy')
def s_convoy(p, x, y, w, h, c):
    """Lorries: a load bed on wheels."""
    p.frame(x + 2, y + 2, w - 4, h // 2, c)
    for k in (0.3, 0.7):
        p.oval(x + w * k, y + h - 3, 1, 1, c, fill=c)


