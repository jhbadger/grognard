def VICTORY(e):
    """Victory points: each side scores what it destroys (every unit has
    its value) and its objectives, and the Compact 4 VP a convoy that
    gets through."""
    hd, lc = e.vp('hd'), e.vp('lc')
    m = hd - lc
    score = 'Directorate %d VP, Compact %d.' % (hd, lc)
    if m >= 6:
        return 'hd', 'Directorate victory. %s The delta burns.' % score
    if m >= -1:
        return 'hd', 'Directorate marginal victory. %s' % score
    if m > -8:
        return 'lc', 'Compact marginal victory. %s The road held.' % score
    return 'lc', ('Compact victory. %s The raiders are scattered and the '
                  'convoys rolled on.' % score)


