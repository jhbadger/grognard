def unit(uid, side, kind, a, r, d, m, vp, m2=0, **kw):
    """A unit: attack, range, defence, movement (and second movement)."""
    spec = dict(id=uid, side=side, type=kind, a=a, range=r, d=d, m=m, vp=vp,
                steps=1, size=kw.pop('size', 'I'))
    if m2:
        spec['m2'] = m2
    spec.update(kw)
    return spec


