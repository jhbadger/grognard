@grognard.icon('saltmarsh')
def draw_icon(p, n):
    """A skimmer over a tidal channel at dusk."""
    p.fill('#d98c58')
    p.rect(0, n * 0.55, n, n * 0.45, '#3e6f8c')
    for k in range(4):
        y = n * (0.65 + k * 0.08)
        p.line(n * 0.1 + k * n * 0.07, y, n * 0.35 + k * n * 0.07, y,
               '#6d9cb8', max(1, n // 40))
    p.disc(n * 0.5, n * 0.42, n * 0.3, '#1a1008')
    p.rect(n * 0.15, n * 0.42, n * 0.7, n * 0.12, '#d98c58')
    p.rect(n * 0.18, n * 0.38, n * 0.64, n * 0.08, '#1a1008')
    p.line(n * 0.5, n * 0.2, n * 0.85, n * 0.12, '#1a1008', max(2, n // 20))


