def COMBAT_SHIFTS(e, target, attackers, support):
    """Infantry dug in among buildings are hard to dig out."""
    defenders = [u for u in e.at(target) if u.side != e.side]
    t = e.board.terrain(target)
    if defenders and all(u.kind == 'infantry' for u in defenders) and \
            t.get('pattern') in ('town', 'city'):
        return [(-1, 'dug in')]
    return []


