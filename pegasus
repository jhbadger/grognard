def dark(e):
    return e.weather()['id'] == 'night'


def ON_TURN(e, side):
    """What happened round the bridges."""
    if side == 'de':
        if e.turn == 1:
            e.say('In Bénouville the garrison is stirring. Shots from '
                  'the gardens; flares over the canal.')
        if e.turn == SCHMIDT:
            e.say('Major Schmidt, the bridge commandant, drives up from '
                  'Ranville in his car to see what the firing is about, '
                  'and is taken prisoner at the Orne bridge.')
        if e.turn == DAWN + 1:
            e.say('A Luftwaffe bomber drops a bomb on the canal bridge. '
                  'It bounces off the girders and fails to go off.')
    else:
        if e.turn == PARAS:
            e.say('The first of the 7th Parachute Battalion come over '
                  'the Orne at the double: Lieutenant-Colonel '
                  'Pine-Coffin has a third of his men.')
        if e.turn == DAWN:
            e.say('First light. Out at sea the bombardment of Sword '
                  'Beach rolls like thunder.')
        if e.turn == LOVAT:
            e.say('Bagpipes on the Ouistreham road. Lord Lovat\'s '
                  'commandos are coming, piper Bill Millin playing '
                  '"Blue Bonnets over the Border".')


def ON_MOVE(e, unit, path):
    """The commandos crossing the canal bridge: Lovat apologises for
    being two and a half minutes late, and the British score 2 VP."""
    if unit.id in COMMANDOS and not e.flags.get('relieved') and \
            any(hexgrid.distance(h, CANAL_EAST) == 0 for h in path[1:]):
        e.flags['relieved'] = True
        e.bonus['br'] += RELIEF_VP
        e.say("The commandos march over the canal bridge under fire. "
              "Lovat shakes Howard's hand and apologises for being two "
              "and a half minutes late.")


def COMBAT_SHIFTS(e, target, attackers, support):
    """In the dark, every attack is a column worse.  Major Howard in a
    hex costs a German attack on it a column."""
    out = []
    if attackers and dark(e):
        out.append((-1, 'darkness'))
    if e.side == 'de' and any(u.id == HOWARD for u in e.at(target)):
        out.append((-1, 'Howard'))
    return out


