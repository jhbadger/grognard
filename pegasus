def u(uid, side, a, d, hx, formation, colour, long, **kw):
    """A unit: attack, defence, and the hex it starts in (None if it
    arrives later, with arrive and at)."""
    spec = dict(id=uid, name=kw.pop('name', uid.upper()), side=side,
                type=kw.pop('type', 'infantry'), size=kw.pop('size', '***'),
                a=a, d=d, m=kw.pop('m', 4), steps=kw.pop('steps', 2),
                hex=hx, formation=formation, colour=colour, long=long)
    spec.update(kw)
    return spec


