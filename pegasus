def TURN_NAME(t):
    """An hour a turn, from half past midnight."""
    m = 30 + (t - 1) * 60
    h = m // 60
    return ('6 Jun 1944', '%d:%02d %s' % ((h - 1) % 12 + 1, m % 60,
                                          'AM' if h < 12 else 'PM'))


