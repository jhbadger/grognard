def _score(e):
    return 'British %d VP, Germans %d.' % (e.vp('br'), e.vp('de'))


def VICTORY(e):
    """The British must still hold the canal bridge (the Café Gondrée at
    its western end) and finish ahead by the margin set from games
    between computer players (./pegasus --simulate 60)."""
    br, de = e.vp('br'), e.vp('de')
    m = br - de
    held = e.control.get(CANAL_BRIDGE) == 'br'
    if held and m >= MARGIN + 4:
        return 'br', ('British victory. %s The bridges hold, the airborne '
                      'division east of the Orne is joined to the '
                      'beaches, and the café is serving champagne.'
                      % _score(e))
    if held and m >= MARGIN:
        return 'br', ('British marginal victory. %s The canal bridge '
                      'holds, at a price.' % _score(e))
    if held:
        return 'de', ('German marginal victory. %s The British still '
                      'hold the canal bridge, but the 21st Panzer has '
                      'the villages round it under its guns.' % _score(e))
    return 'de', ('German victory. %s The canal bridge is German again; '
                  'the 6th Airborne Division is cut off east of the Orne.'
                  % _score(e))



