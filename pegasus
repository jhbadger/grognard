@grognard.icon('pegasus')
def draw_icon(p, n):
    """The canal bridge at night, its great counterweight against the
    sky, and a glider in the field beside it."""
    p.fill('#1a2236')
    p.disc(n * 0.8, n * 0.2, n * 0.08, '#e8e4c8')
    p.rect(0, n * 0.62, n, n * 0.38, '#3e5a34')
    p.rect(0, n * 0.7, n, n * 0.14, '#2e64b0')
    p.rect(n * 0.1, n * 0.6, n * 0.8, n * 0.06, '#6a7480')
    p.rect(n * 0.18, n * 0.36, n * 0.18, n * 0.24, '#5a6470')
    p.disc(n * 0.27, n * 0.34, n * 0.1, '#5a6470')
    for i in range(4):
        x = n * (0.4 + i * 0.12)
        p.line(x, n * 0.6, x + n * 0.06, n * 0.48, '#7a848e')
    p.line(n * 0.36, n * 0.48, n * 0.9, n * 0.48, '#7a848e')
    p.rect(n * 0.2, n * 0.88, n * 0.6, n * 0.05, '#c8b880')
    p.rect(n * 0.42, n * 0.85, n * 0.08, n * 0.1, '#c8b880')
    p.rect(n * 0.72, n * 0.84, n * 0.04, n * 0.06, '#c8b880')


