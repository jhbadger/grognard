def _between(col, rows, skip=()):
    """Every side between a column and the next, over some rows."""
    out = []
    for r in rows:
        if r in skip:
            continue
        for n in hexgrid.neighbours((col, r)):
            if n[0] == col + 1 and 0 <= n[1] < len(MAP):
                out.append('%s/%s' % (hexgrid.hid((col, r)), hexgrid.hid(n)))
    return out


def _river():
    """The Kansa river below the castle: the sides between the tenth
    row and the eleventh, east of the paddies."""
    out = []
    for c in range(9, 16):
        for n in hexgrid.neighbours((c, 10)):
            if n[1] == 11 and 9 <= n[0] < 16:
                out.append('%s/%s' % (hexgrid.hid((c, 10)), hexgrid.hid(n)))
    return out


