def _line(e, h):
    return any(u.spec.get('hex') and hexgrid.parse(u.spec['hex']) == h
               for u in e.units.values() if u.side == 'od')


class Nobunaga(ai.AI):
    """The stock computer player, taught the shape of the day: the
    allies keep to the palisade (Sakai's column and the garrison
    excepted), and the Takeda charge it rather than wait in the
    paddies."""

    def score(self, u, h):
        s = super().score(u, h)
        e = self.e
        if self.side == 'od':
            if u.spec.get('formation') in ('Sakai', 'Nagashino'):
                return s
            if u.spec.get('hex') and hexgrid.parse(u.spec['hex']) == h:
                s += 20 if u.kind in ('teppo', 'yari') else 6
            elif _line(e, h):
                s += 3
            if h[0] > LINE_COL:
                s -= 6
        elif u.formation in ('The generals', 'The foot'):
            s -= max(0, h[0] - LINE_COL - 1) * 1.2
            if any(e.at(n, 'od') for n in hexgrid.neighbours(h)):
                s += 6
        return s


