def _score(e):
    return 'Takeda %d VP, Oda-Tokugawa %d.' % (e.vp('tk'), e.vp('od'))


def VICTORY(e):
    """The Takeda score the two camps (8 and 6) and the castle (4) if
    they hold them at the end, every Oda-Tokugawa step, and Nobunaga
    (6) and Ieyasu (4); the Oda-Tokugawa every Takeda step, the forts at
    Tobigasu (3), each general (2) and Katsuyori (6).  The Takeda must
    finish THRESHOLD ahead (set from games between computer players:
    ./nagashino --simulate 60)."""
    m = e.vp('tk') - e.vp('od')
    if m >= THRESHOLD + 8:
        return 'tk', ('Takeda victory. %s The palisade is broken and the '
                      'horsemen ride through the camps.' % _score(e))
    if m >= THRESHOLD:
        return 'tk', ('Takeda marginal victory. %s The allies draw back, '
                      'and the castle must starve.' % _score(e))
    if m > THRESHOLD - 5:
        return 'od', ('Oda-Tokugawa marginal victory. %s Katsuyori lifts '
                      'the siege and goes home to Kai.' % _score(e))
    return 'od', ('Oda-Tokugawa victory. %s The Takeda horse lies dead '
                  'before the palisade with most of the old generals, and '
                  'the house of Takeda never recovers.' % _score(e))


