@grognard.icon('nagashino')
def draw_icon(p, n):
    """A palisade, smoke from the guns, and a red banner beyond."""
    p.fill('#d8d0b8')
    p.rect(0, n * 0.62, n, n * 0.38, '#88a888')
    p.line(n * 0.78, n * 0.12, n * 0.78, n * 0.6, '#3a2a1a',
           max(1, n // 40))
    p.rect(n * 0.78, n * 0.12, n * 0.14, n * 0.24, '#a82a24')
    p.disc(n * 0.85, n * 0.24, n * 0.04, '#f4e0a0')
    for k in range(5):
        p.disc(n * (0.12 + k * 0.12), n * (0.42 - (k % 2) * 0.05),
               n * 0.09, '#f0f0ec')
    for k in range(7):
        x = n * (0.06 + k * 0.1)
        p.line(x, n * 0.85, x, n * 0.5, '#6a4a2a', max(1, n // 32))
    p.line(0, n * 0.6, n * 0.7, n * 0.6, '#6a4a2a', max(1, n // 40))
    p.line(0, n * 0.72, n * 0.7, n * 0.72, '#6a4a2a', max(1, n // 40))


