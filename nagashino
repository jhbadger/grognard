# ----------------------------------------------------------- the guns

def _empty(e):
    return e.flags.setdefault('empty', [])


def ON_TURN(e, side):
    """Reloading: a gun that fired in the last turn is still loading
    this one.  The flags are set at the start of each side's turn from
    what the guns did in the turn just ended."""
    guns = [u for u in e.alive('od') if u.kind == 'teppo']
    if side == 'tk':
        e.flags['empty'] = [u.id for u in guns if u.fired]
        if e.turn == 1:
            e.say('The drums of the Takeda roll. The first wave goes '
                  'down into the paddies.')
    else:
        e.flags['empty'] = [u.id for u in guns if u.dfired]
        if e.turn == 1:
            e.say('"Hold your fire until they reach the palisade."')
        if e.turn == 2:
            e.say("Sakai Tadatsugu's column comes down on the forts at "
                  'Tobigasu from the hills behind them.')


def CAN_SUPPORT(e, u):
    """A gun fires only if it's loaded: it fired in neither this turn
    nor the last."""
    return u.kind != 'teppo' or u.id not in _empty(e)


GENERALS = ('yamagata', 'baba', 'naito', 'sanada', 'tsuchiya', 'hara')


def ON_ELIMINATE(e, u, where):
    """The generals of the Takeda, and the two commanders."""
    if u.id in GENERALS:
        n = e.flags['generals'] = e.flags.get('generals', 0) + 1
        e.say('%s is killed before the palisade.' % u.long)
        if n == BROKEN:
            e.say('So many of the old generals are dead that the Takeda '
                  'army loses heart.')
    elif u.id == 'katsuyori':
        e.flags['katsuyori'] = True
        e.say('Takeda Katsuyori is killed! The house of Takeda falls.')
    elif u.id == 'nobunaga':
        e.flags['nobunaga'] = True
        e.say('Oda Nobunaga is killed! His army wavers.')
    elif u.id == 'ieyasu':
        e.say('Tokugawa Ieyasu is killed.')


def COMBAT_SHIFTS(e, target, attackers, support):
    """The palisade and morale:
    - horsemen attacking across the palisade lose another column (the
      palisade itself costs one);
    - with BROKEN generals dead, or Katsuyori, the Takeda attack a
      column worse;
    - with Nobunaga dead the Oda-Tokugawa attack a column worse."""
    out = []
    if e.side == 'tk':
        if any(u.type.get('mounted') and _palisade(e, u.hex, target)
               for u in attackers):
            out.append((-1, 'horses at the palisade'))
        if e.flags.get('generals', 0) >= BROKEN or \
                e.flags.get('katsuyori'):
            out.append((-1, 'the generals are dead'))
    elif e.flags.get('nobunaga'):
        out.append((-1, 'Nobunaga is dead'))
    return out


def _palisade(e, a, b):
    side = e.board.river(a, b)
    return bool(side) and side.get('name') == HEXSIDES['palisade']['name']


