def _crest(e, h):
    return h is not None and e.board.terrain_name(h) == 'crest'


class Duke(ai.AI):
    """The stock computer player, taught the shape of the day: the
    English keep to the crest (a levy that ran climbs back), and the
    Normans go up the slope at the wall and make for the standard
    rather than waiting below for the English to come down."""

    def score(self, u, h):
        s = super().score(u, h)
        e = self.e
        if self.side == 'en':
            if _crest(e, h):
                s += 8
            elif _crest(e, u.hex):
                s -= 8
        elif not u.supports:
            s -= hexgrid.distance(h, STANDARD) * 1.0
            if any(_crest(e, n) and e.at(n, 'en')
                   for n in hexgrid.neighbours(h)):
                s += 7
        return s


