@grognard.icon('hastings')
def draw_icon(p, n):
    """A wall of shields along a green ridge, the golden dragon of
    Wessex above it, and arrows falling."""
    p.fill('#c8d4e0')
    p.rect(0, n * 0.55, n, n * 0.45, '#7e9a4e')
    p.disc(n * 0.5, n * 1.6, n * 1.05, '#94a85e')
    p.line(n * 0.5, n * 0.1, n * 0.5, n * 0.55, '#4a3420',
           max(1, n // 40))
    p.rect(n * 0.5, n * 0.1, n * 0.26, n * 0.16, '#d8b040')
    p.disc(n * 0.7, n * 0.18, n * 0.05, '#a8382c')
    for k in range(6):
        x = n * (0.1 + k * 0.16)
        p.disc(x, n * 0.6, n * 0.085, '#a8382c')
        p.disc(x, n * 0.6, n * 0.03, '#f4dc90')
    for k in range(4):
        x = n * (0.12 + k * 0.22)
        for s in range(5):
            p.rect(x + s * n * 0.012, n * 0.18 + s * n * 0.03,
                   n * 0.02, n * 0.02, '#2a2018')


