@grognard.symbol('axe')
def s_axe(p, x, y, w, h, c):
    """Housecarls: the two-handed Danish axe."""
    p.line(x + 1, y + h - 1, x + w - 2, y, c)
    bx, by = x + w * 0.62, y + h * 0.1
    r = max(2, h // 3)
    for i in range(r + 1):
        p.line(bx + i * 0.5, by + i, bx + r, by + i * 0.6, c)


@grognard.symbol('bow')
def s_bow(p, x, y, w, h, c):
    """Archers: a bow drawn, with an arrow on the string."""
    cx, cy = x + w * 0.4, y + (h - 1) / 2
    r = max(2, h // 2 - 1)
    p.line(cx, cy - r, cx, cy + r, c)                       # string
    for i in range(r + 1):                                  # stave
        dx = int(round((r * r - i * i) ** 0.5 * 0.7))
        p.set(cx + dx, cy - i, c)
        p.set(cx + dx, cy + i, c)
    p.line(cx - 1, cy, x + w - 1, cy, c)                    # arrow


