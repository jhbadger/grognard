# --------------------------------------------------------- the pursuit

def _lures(e):
    """Norman units that might draw the levies down the hill: any that
    attacked in their last turn and lost a step doing it (or since), and
    from FEINT on, any knights that attacked at all (the feigned
    flight)."""
    was = e.flags.get('nsteps', {})
    out = []
    for u in e.alive('no'):
        if not u.attacked:
            continue
        if was.get(u.id, u.steps) > u.steps or \
                (e.turn >= FEINT and u.kind == 'knight'):
            out.append(u)
    return out


def _below(e, h):
    """Whether h is off the ridge: not the crest or the hill behind it."""
    return e.board.terrain_name(h) not in ('crest', 'caldbec')


def _chase_to(e, u, lure):
    """Where a levy runs to after lure: an empty hex next to it, off the
    ridge, as near the levy as can be."""
    best = None
    for n in hexgrid.neighbours(lure.hex):
        if not e.board.on_map(n) or e.at(n) or not _below(e, n):
            continue
        t = e.board.terrain(n) or {}
        if t.get('impassable') or t.get('move', {}).get('foot') is None:
            continue
        d = hexgrid.distance(u.hex, n)
        key = (d, -n[1], n)
        if best is None or key < best[0]:
            best = (key, n)
    return best[1] if best else None


def _pursuit(e):
    """At the start of the English turn each levy next to a Norman unit
    that was beaten back (or ran away on purpose) may run down after it
    and is caught out of the line: it can't move or fight this turn."""
    lures = _lures(e)
    if not lures:
        return
    chance = PURSUE + (1 if e.flags.get('harold') else 0)
    for u in sorted(e.alive('en'), key=lambda u: u.id):
        if not u.type.get('rash') or u.disabled:
            continue
        near = [x for x in lures if hexgrid.distance(x.hex, u.hex) == 1]
        if not near:
            continue
        lords = [x for x in e.alive('en') if x.id in LEADERS and
                 hexgrid.distance(x.hex, u.hex) <= 1]
        n = chance - (1 if lords else 0)
        if e.rng.randint(1, 6) > n:
            continue
        lure = near[0]
        h = _chase_to(e, u, lure)
        if h is None:
            continue
        old = u.hex
        u.hex = h
        u.disabled = True
        u.recovering = False
        e.take(h, 'en')
        e.changed()
        e.events.append(('move', u.id, [old, h]))
        e.say('The %s at %s break ranks and run down the hill after the '
              '%s! They are out of the line this turn.' % (
                  'thegns' if u.kind == 'thegn' else 'levies',
                  e.place(old), lure.type.get('name', 'enemy').lower()))


def ON_TURN(e, side):
    """The Normans' steps are counted at the start of their turn, so the
    English can tell who was beaten back; at the start of the English
    turn the levies may run after them.  And the hours of the day."""
    if side == 'no':
        e.flags['nsteps'] = {u.id: u.steps for u in e.alive('no')}
        if e.turn == 1:
            e.say('The trumpets sound, and the duke\'s archers go '
                  'forward up the slope.')
        elif e.turn == FEINT:
            e.say('The duke has seen the levies run after the Bretons. '
                  'Now his knights will turn and run on purpose.')
        elif e.turn == HIGH:
            e.say('William orders the archers to shoot high, so the '
                  'arrows fall behind the shields.')
    else:
        if e.turn == 1:
            e.say('"Out! Out!" The English beat their shields and wait.')
        _pursuit(e)


def ON_ELIMINATE(e, u, where):
    """Kings, earls and the duke."""
    if u.id == 'harold':
        e.flags['harold'] = True
        e.say('Harold is down! The king lies dead beneath his standard, '
              'and the English lose heart.')
    elif u.id in ('gyrth', 'leofwine'):
        e.say('Earl %s, the king\'s brother, has fallen.' %
              u.id.title())
    elif u.id == 'william':
        e.flags['william'] = True
        e.say('The duke is dead! The Normans falter.')
    elif u.id == 'odo':
        e.say('Bishop Odo is unhorsed and lost.')


def COMBAT_SHIFTS(e, target, attackers, support):
    """Shields, arrows and kings:
    - knights alone against housecarls or thegns lose a column (the
      shield wall);
    - archers alone against them lose a column, until the archers shoot
      high (HIGH);
    - with Harold dead the English attack a column worse, with William
      dead the Normans."""
    out = []
    wall = any(u.spec.get('wall') for u in e.at(target, 'en'))
    if e.side == 'no':
        if wall and attackers and all(u.kind == 'knight' for u in attackers):
            out.append((-1, 'shield wall'))
        if wall and not attackers and support and e.turn < HIGH:
            out.append((-1, 'shields'))
        if e.flags.get('william'):
            out.append((-1, 'the duke is dead'))
    elif e.flags.get('harold'):
        out.append((-1, 'Harold is dead'))
    return out


