def _score(e):
    return 'Normans %d VP, English %d.' % (e.vp('no'), e.vp('en'))


def VICTORY(e):
    """The day turns on the standard and the king: the standard in
    Norman hands at the end and Harold dead is a Norman victory, either
    one a marginal one.  Otherwise the English win, clearly if the
    Normans aren't ahead on points: the standard (8) and each end of the
    ridge (2) they hold, every English step destroyed, Harold (6) and
    his brothers (3 each), against every Norman step, William (6) and
    Odo (2)."""
    taken = e.control.get(STANDARD) == 'no'
    dead = bool(e.flags.get('harold'))
    if taken and dead:
        return 'no', ('Norman victory. %s Harold lies dead beneath his '
                      'standard, and the duke will be crowned in '
                      'Westminster at Christmas.' % _score(e))
    if taken:
        return 'no', ('Norman marginal victory. %s The standard is taken, '
                      'but Harold has got away to raise another army.'
                      % _score(e))
    if dead:
        return 'no', ('Norman marginal victory. %s Harold is dead, and '
                      'though his housecarls hold the standard till dark, '
                      'England has no king.' % _score(e))
    if e.vp('no') > e.vp('en'):
        return 'en', ('English marginal victory. %s The wall holds till '
                      'nightfall, and the duke must think again.'
                      % _score(e))
    return 'en', ('English victory. %s The Normans are thrown back down '
                  'the hill, and the duke rides for his ships.' % _score(e))


