def unit(uid, side, kind, a, d, m, hx, long, colour, formation, steps=2,
         **kw):
    """A division of the army: attack, defence, movement and where it
    starts (None to arrive later, with arrive and at)."""
    spec = dict(id=uid, name=kw.pop('name', uid.upper()), side=side,
                type=kind, size=kw.pop('size', 'III'), a=a, d=d, m=m,
                steps=steps, hex=hx, long=long, colour=colour,
                formation=formation)
    spec.update(kw)
    return spec


def huscarls(uid, a, d, hx, long, formation, steps=3, **kw):
    return unit(uid, 'en', 'huscarl', a, d, 2, hx, long, ENGLAND,
                formation, steps=steps, wall=True, **kw)


