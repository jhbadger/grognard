def u(uid, side, kind, a, d, m, hx, formation, colour, long, **kw):
    spec = dict(id=uid, name=kw.pop('name', uid.upper()), side=side,
                type=kind, size=kw.pop('size', 'III'), a=a, d=d, m=m,
                steps=kw.pop('steps', 2), hex=hx, formation=formation,
                colour=colour, long=long)
    spec.update(kw)
    return spec


def marines(uid, number, arrive, at, formation='2nd Marine Division',
            colour=USMC):
    return u(uid, 'us', 'infantry', 5, 6, 3, None, formation, colour,
             '%s Marines, %s' % (number, formation),
             name='%s MAR' % number.rstrip('thdsrn'), steps=3,
             arrive=arrive, at=at)


def battle_group(uid, name, division, arrive, at, colour=USA):
    return u(uid, 'us', 'para', 4, 4, 3, None, division, colour,
             'An airborne battle group of the %s' % division, name=name,
             arrive=arrive, at=at)


def far(uid, hx, where, a=4, d=6, **kw):
    return u(uid, 'cu', 'infantry', a, d, 3, hx, 'Western Army', FAR,
             'A FAR infantry division, %s' % where, size='XX', name='FAR',
             steps=3, **kw)


def militia(uid, hx, where):
    return u(uid, 'cu', 'militia', 1, 2, 2, hx,
             'Milicias Nacionales Revolucionarias', MILITIA,
             'A militia battalion, %s' % where, size='II', name='MIL',
             steps=1)


