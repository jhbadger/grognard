# ------------------------------------------------------- the militia

def _raise_militia(e):
    """The Milicias Nacionales Revolucionarias turn out: each Cuban turn
    up to three battalions are raised in towns the Cubans still hold, with
    no American next door, until twenty have been."""
    raised = e.flags.get('militia', 0)
    if raised >= MILITIA_MAX:
        return
    near_us = set()
    for x in e.alive('us'):
        near_us.add(x.hex)
        near_us.update(grognard.hexgrid.neighbours(x.hex))
    towns = sorted(h for h, o in e.board.objectives.items()
                   if e.control.get(h) == 'cu' and h not in near_us and
                   e.board.terrain_name(h) in ('town', 'city'))
    e.rng.shuffle(towns)
    n = 0
    for h in towns:
        if raised >= MILITIA_MAX or n >= MILITIA_PER_TURN:
            break
        if not e.room(h, side='cu'):
            continue
        raised += 1
        n += 1
        e.spawn(dict(
            id='mil%d' % raised, side='cu', type='militia', a=1, d=2, m=2,
            steps=1, size='II', name='MIL', colour=MILITIA,
            formation='Milicias Nacionales Revolucionarias',
            long='A militia battalion raised in %s' % e.place(h),
            hex=hid(h)))
        e.say('A militia battalion turns out in %s.' % e.place(h))
    e.flags['militia'] = raised


def ON_ELIMINATE(e, u, where):
    """A militia battalion lost is not a victory: there are always more
    (the Americans score nothing for it)."""
    if u.kind == 'militia':
        e.bonus['us'] -= STEP_VP['cu'] * u.max_steps


def ON_TURN(e, side):
    if side == 'us':
        if e.turn == 1:
            e.say('H-hour. The 2nd Marine Division comes ashore at Tarará '
                  'and Guanabo under the guns of the fleet, and the '
                  'paratroopers of the 82nd and 101st jump over the '
                  'airfields.')
        if e.turn == 4:
            e.say('The 1st Armored Division is coming ashore over the '
                  'beaches.')
    else:
        _raise_militia(e)
        if e.turn == 1:
            e.say('Fidel orders the whole country to arms. In the woods '
                  'south of Havana, a Soviet colonel reads his orders '
                  'about the Lunas again.')


def CAN_SUPPORT(e, u):
    """The Lunas are not used: this war stops short of that."""
    return u.kind != 'luna'


def _score(e):
    return 'Americans %d VP, Cubans and Soviets %d.' % (e.vp('us'),
                                                        e.vp('cu'))


def _lunas(e):
    return [u for u in e.alive('cu') if u.kind == 'luna']


def VICTORY(e):
    """The Americans score the places they hold, the enemy steps they
    destroy and 6 VP a Luna battery; the Cubans score every American
    step destroyed twice over."""
    m = e.vp('us') - e.vp('cu')
    left = len(_lunas(e))
    warheads = e.control.get(parse('1208')) == 'us'
    coda = ''
    if left and not warheads:
        coda = (' Somewhere in the cane, %s still waiting for orders, '
                'and the warheads are still at Bejucal.'
                % ('a Luna battery is' if left == 1 else
                   'two Luna batteries are'))
    elif left:
        coda = (' The warheads are taken, but %s still out there.'
                % ('a Luna battery is' if left == 1 else
                   'two Luna batteries are'))
    if m >= MARGIN + 10:
        return 'us', ('American victory. %s Havana has fallen and the '
                      'Cuban army is broken.%s' % (_score(e), coda))
    if m >= MARGIN:
        return 'us', ('American marginal victory. %s The Americans hold '
                      'the airfields and the edge of Havana, at a price '
                      'the country did not expect.%s' % (_score(e), coda))
    if m > MARGIN - 10:
        return 'cu', ('Cuban marginal victory. %s The invasion is stuck '
                      'short of Havana, the casualty lists are long, and '
                      'the United Nations demands a ceasefire.%s'
                      % (_score(e), coda))
    return 'cu', ('Cuban victory. %s The Marines are pinned on the '
                  'beaches and the paratroopers cut off. Patria o '
                  'muerte.%s' % (_score(e), coda))


