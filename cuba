def _poly(p, n, pts, c):
    """Fill a polygon given in fractions of the icon, a row at a time."""
    pts = [(x * n, y * n) for x, y in pts]
    y0 = int(min(y for _, y in pts))
    y1 = int(max(y for _, y in pts)) + 1
    for y in range(y0, y1):
        yc = y + 0.5
        xs = []
        for (ax, ay), (bx, by) in zip(pts, pts[1:] + pts[:1]):
            if (ay <= yc) != (by <= yc):
                xs.append(ax + (yc - ay) * (bx - ax) / (by - ay))
        xs.sort()
        for a, b in zip(xs[::2], xs[1::2]):
            x0, x1 = int(a + 0.5), int(b + 0.5)
            if x1 > x0:
                p.rect(x0, y, x1 - x0, 1, c)


@grognard.icon('cuba')
def draw_icon(p, n):
    """A Luna rocket on its launcher under royal palms, with the sea
    behind."""
    p.fill('#9cc4dc')
    p.rect(0, n * 0.5, n, n * 0.12, '#3a78a8')                 # the sea
    p.rect(0, n * 0.62, n, n * 0.38, '#a8b868')                # cane
    for k in range(7):
        p.rect(n * (0.04 + k * 0.14), n * 0.66, max(1, n // 40),
               n * 0.3, '#8a9c4c')
    # a royal palm
    p.rect(n * 0.8, n * 0.22, max(2, n // 24), n * 0.5, '#d8d0bc')
    for dx, dy in ((-0.14, 0.04), (0.14, 0.04), (-0.1, -0.06),
                   (0.1, -0.06), (0, -0.08)):
        p.line(n * 0.81, n * 0.22, n * (0.81 + dx), n * (0.22 + dy + 0.06),
               '#3a6a28', max(2, n // 20))
    # the launcher truck and the rocket, raised
    p.rect(n * 0.1, n * 0.72, n * 0.56, n * 0.1, '#4a5a3a')
    for x in (0.18, 0.32, 0.46, 0.58):
        p.disc(n * x, n * 0.84, n * 0.045, '#1a1e16')
    _poly(p, n, [(0.2, 0.7), (0.56, 0.2), (0.62, 0.24), (0.27, 0.73)],
          '#c8ccc4')
    _poly(p, n, [(0.56, 0.2), (0.64, 0.12), (0.62, 0.24)], '#b02a20')
    p.rect(n * 0.5, n * 0.66, n * 0.12, n * 0.08, '#3a4a2c')


