@grognard.symbol('claw')
def s_claw(p, x, y, w, h, c):
    """The Chorus: three claw marks."""
    for k in (-1, 0, 1):
        x0 = x + w // 2 + k * max(2, w // 5)
        p.line(x0 - 1, y + 1, x0 + 1, y + h - 2, c)


@grognard.symbol('spitter')
def s_spitter(p, x, y, w, h, c):
    """Spitters: the claws and an arc of spit."""
    s_claw(p, x, y, w, h, c)
    p.line(x + 1, y + h - 2, x + w - 2, y + h - 2, c)


@grognard.symbol('brute')
def s_brute(p, x, y, w, h, c):
    s_claw(p, x, y, w, h, c)
    p.frame(x + 1, y + 1, w - 2, h - 2, c)


@grognard.symbol('loader')
def s_loader(p, x, y, w, h, c):
