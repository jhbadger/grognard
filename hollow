def DRAW_MAP(g, s):
    """A sealed burrow: grey ice with a cross of charge scars."""
    e = g.e
    v = g.view
    shown = set(v.visible_hexes())
    geo = v.geo
    r = max(3, geo.dy // 3)
    for h in BURROWS:
        if h not in shown or is_open(e, h):
            continue
        v.tint(s, h, '#c8d4dc', 0.75)
        sx, sy = v.to_screen(h)
        c = rgb('#3a2a40')
        for k in range(-r, r + 1):
            s.rect(sx + k, sy + k, 2, 2, c)
            s.rect(sx + k, sy - k, 2, 2, c)


