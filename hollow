def brood(e, kind, h):
    spec = dict(CHORUS[kind], side='ch', type=kind, hex=hid(h),
                long=LONG[kind], formation='The Chorus', size='',
                colour={'drone': PURPLE, 'spitter': PURPLE2,
                        'brute': PURPLE3}[kind])
    return e.spawn(spec)


def hatch(e):
    """At the start of each Chorus turn every open burrow not held by
    the colony gives up one creature: a drone on the first turns, then
    whatever comes."""
    if len(e.alive('ch')) >= SWARM_MAX:
        return 0
    n = 0
    for h in open_burrows(e):
        if e.at(h, 'hu') or len(e.alive('ch')) >= SWARM_MAX:
            continue
        if e.rng.random() >= HATCH:
            continue
        r = e.rng.random()
        if e.turn <= 2 or r < 0.55:
            kind = 'drone'
        elif r < 0.8:
            kind = 'spitter'
        else:
            kind = 'brute'
        if not e.room(h, side='ch'):
            continue
        brood(e, kind, h)
        n += 1
    return n


