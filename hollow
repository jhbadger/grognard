def seal_why(e, u):
    """Why u can't seal a burrow now (None if it can), and which."""
    if u.kind != 'miners' or not e.moving or e.phase != 'move':
        return 'only miners, in the movement phase', None
    if u.attacked:
        return 'has already set charges this turn', None
    near = [h for h in open_burrows(e) if distance(u.hex, h) <= 1]
    if not near:
        return 'no open burrow next to it', None
    clear = [h for h in near if not e.at(h, 'ch')]
    if not clear:
        return 'the Chorus is in the burrow', None
    return None, clear[0]


def ACTIONS(e, u):
    if u.kind != 'miners' or e.phase != 'move':
        return []
    why, _ = seal_why(e, u)
    return [('Seal burrow', 'seal', why)]


def ACT(e, u, key):
    why, h = seal_why(e, u)
    if why:
        return
    e.flags.setdefault('sealed', []).append(hid(h))
    e.bonus['hu'] += SEAL_VP
    u.mp = 0
    u.attacked = True
    e.events.append(('sound', 'boom'))
    e.events.append(('popup', h, 'Sealed', (240, 220, 160)))
    e.say('%s bring down the %s with cutting charges.' % (u.long,
                                                           e.place(h)))
    if e.rng.randint(1, 6) <= 2:
        e.say('Something comes up through the falling ice first.')
        e.take_losses([u], 1)


def evacuate(e):
    """From the turn the Petrel lands, colonists on the pad go aboard."""
    if e.turn < SHUTTLE:
        return
    if e.turn == SHUTTLE:
        e.say('The Petrel comes down on the landing pad in a cloud of '
              'steam. Get the colonists aboard!')
    for u in e.alive('hu'):
        if u.kind == 'colonists' and u.hex in PAD:
            e.say('%s are aboard the Petrel.' % u.long)
            e.bonus['hu'] += EVAC_VP
            e.remove(u)
            e.flags['saved'] = e.flags.get('saved', 0) + 1


def sentries(e):
    """At the start of each Chorus turn each turret sweeps every Chorus
    unit within SENTRY hexes: it loses a step on a 1.  A round of
    ammunition a target."""
    hits = 0
    for t in [u for u in e.alive('hu') if u.kind == 'turret']:
        for z in e.alive('ch'):
            if e.flags.get('ammo', AMMO) <= 0:
                break
            if distance(t.hex, z.hex) > SENTRY:
                continue
            e.flags['ammo'] = e.flags.get('ammo', AMMO) - 1
            if e.rng.randint(1, 6) == 1:
                e.take_losses([z], 1)
                hits += 1
    if hits:
        e.events.append(('sound', 'gun'))
        e.say('The sentry turrets sweep the deck: %d hit%s.'
              % (hits, '' if hits == 1 else 's'))


def ON_TURN(e, side):
    if side == 'ch':
        if e.turn == 1:
            e.say('01:00. The Chorus is up out of the ice: the station '
                  'sirens go, and the bulkheads close.')
        sentries(e)
        n = hatch(e)
        if n:
            e.say('%d more of the Chorus come%s up out of the burrows.'
                  % (n, 's' if n == 1 else ''))
    else:
        evacuate(e)
        if e.turn == SHUTTLE - 2:
            e.say('The Petrel calls in: two hours out. Get the colonists '
                  'moving to the pad.')
    if not [u for u in e.alive('hu') if u.attack_full > 0 or
            u.kind == 'colonists']:
        e.finish('ch', 'Chorus victory. Hollow Station is silent, and the '
                       'Petrel finds no one to take off.')


def ON_END_TURN(e):
    """Any colonists still on the pad at the end go too."""
    if e.turn == TURNS:
        e.active = 1
        evacuate(e)
        e.active = 0


def ON_ELIMINATE(e, u, where):
    if u.kind == 'colonists':
