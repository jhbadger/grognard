        e.say('A sentry turret goes silent.')


def VICTORY(e):
    """The Chorus scores the domes it holds and the colonists it takes;
    the colony the colonists it gets off and the burrows it seals.  The
    colony must finish THRESHOLD ahead (set from games between computer
    players: ./hollow --simulate 60)."""
    ch, hu = e.vp('ch'), e.vp('hu')
    m = hu - ch
    saved = e.flags.get('saved', 0)
    score = 'Chorus %d VP, colony %d; %d of 3 colonist groups saved.' % (
        ch, hu, saved)
    if m >= THRESHOLD + 8:
        return 'hu', ('Colony victory. %s The Petrel lifts off with the '
                      'station\'s people, and leaves the Chorus a sealed '
                      'and empty hole in the ice.' % score)
    if m >= THRESHOLD:
        return 'hu', ('Colony marginal victory. %s The Petrel gets away, '
                      'and the Chorus has the station.' % score)
    if m > THRESHOLD - 10:
        return 'ch', ('Chorus marginal victory. %s The Petrel lifts off '
                      'half empty.' % score)
    return 'ch', ('Chorus victory. %s Hollow Station belongs to the '
                  'Chorus now.' % score)


