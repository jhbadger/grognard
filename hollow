@grognard.icon('hollow')
def draw_icon(p, n):
    """A dome on the ice at night, and claws coming up out of a burrow
    in front of it."""
    p.fill('#10182a')
    p.rect(0, n * 0.62, n, n * 0.38, '#c8d4dc')
    p.disc(n * 0.36, n * 0.62, n * 0.26, '#b8c0c8')
    p.rect(0, n * 0.62, n, n * 0.04, '#8a9aa8')
    p.disc(n * 0.36, n * 0.5, n * 0.05, '#e8c040')
    p.disc(n * 0.72, n * 0.82, n * 0.14, '#3a2a40')
    for k in (-1, 0, 1):
        x = n * (0.72 + k * 0.07)
        p.line(x, n * 0.82, x + n * 0.03 * k, n * 0.6, '#b85aa0',
               max(1, n // 24))


