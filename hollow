class Hive(ai.AI):
    """The stock computer player, with sense about the station: the
    miners go and seal burrows, the colonists wait in the domes and make
    for the pad when the Petrel is near."""

    def garrisons(self):
        """The miners have burrows to seal, not domes to hold."""
        super().garrisons()
        for uid in list(self.assign):
            if self.e.units[uid].kind == 'miners':
                del self.assign[uid]

    def next_move(self):
        e = self.e
        if self.side == 'hu' and e.phase == 'move':
            for u in e.alive('hu'):
                if u.kind == 'miners' and not seal_why(e, u)[0]:
                    return ('act', u.id, 'seal')
        act = super().next_move()
        return act

    def score(self, u, h):
        e = self.e
        if u.kind == 'colonists':
            return self.civ_score(u, h)
        s = super().score(u, h)
        if u.kind == 'miners':
            near = [b for b in open_burrows(e) if not e.at(b, 'ch')]
            if near and u.steps > 1:
                d = min(distance(h, b) for b in near)
                s += 8.0 / (1 + max(0, d - 1))
        if self.side == 'hu' and e.turn >= SHUTTLE - 3 and \
                u.attack_full > 0:
            # cover the way to the pad
            s += 2.0 / (1 + min(distance(h, p) for p in PAD))
        return s

    def civ_score(self, u, h):
        e = self.e
        s = -self.threat.get(h, 0) * 0.4
        if any(x.attack > 0 and not x.supports for x in e.at(h, 'hu')
               if x is not u):
            s += 4
        if e.turn >= SHUTTLE - 2:
            s -= min(distance(h, p) for p in PAD) * 6
            if h in PAD:
                s += 30
        else:
            t = e.board.terrain(h)
            s -= t.get('shift', 0) * 3
        if h == u.hex:
            s += 0.3
        return s


