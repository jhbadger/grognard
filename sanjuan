def ENTER_COST(e, unit, a, b, cost):
    """The San Juan River can be crossed only at the fords, and the
    lower ford only once the balloon has found the trail to it.  While
    the Spanish hold San Juan Hill, Americans entering either bank of
    the Bloody Ford pay a point more."""
    if {a, b} == set(LOWER) and e.turn < BALLOON:
        return None
    if cost is not None and getattr(unit, 'side', 'us') == 'us' and b in DOWN and \
            e.control.get(SAN_JUAN) != 'us':
        return cost + 1
    return cost


