def VICTORY(e):
    """The Americans score the hills and Spanish losses, the Spanish
    American losses (and Roosevelt, 5); the margin decides (set from
    games between computer players: ./sanjuan --simulate 60)."""
    us, sp = e.vp('us'), e.vp('sp')
    m = us - sp
    score = 'Americans %d VP, Spanish %d.' % (us, sp)
    if m >= WIN_BIG:
        if e.units[TR].alive:
            return 'us', ('American victory. %s The heights are taken, '
                          'and Colonel Roosevelt will be famous.' % score)
        return 'us', ('American victory. %s The heights are taken, but '
                      'Roosevelt lies in the grass below Kettle Hill.'
                      % score)
    if m >= WIN:
        return 'us', ('American marginal victory. %s The Americans are '
                      'on the ridge, and Santiago is under their guns.'
                      % score)
    if m >= 0:
        return 'sp', ('Spanish marginal victory. %s The Americans hold '
                      'what they took, but at such a price that Shafter '
                      'thinks of falling back.' % score)
    return 'sp', ('Spanish victory. %s The V Corps is stopped in the '
                  'grass, and the fever will finish it.' % score)


