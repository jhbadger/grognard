def TURN_NAME(t):
    """Half an hour a turn, from noon."""
    m = 12 * 60 + (t - 1) * 30
    return ('1 Jul 1898', '%d:%02d %s' % ((m // 60 - 1) % 12 + 1, m % 60,
                                          'AM' if m < 12 * 60 else 'PM'))


