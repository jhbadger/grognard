@grognard.icon('sanjuan')
def draw_icon(p, n):
    """San Juan Hill: a green hill, the blockhouse, and the flag."""
    p.fill('#e4dcb8')
    p.disc(n * 0.5, n * 1.25, n * 0.8, '#6a8a3a')
    p.disc(n * 0.5, n * 1.3, n * 0.75, '#a4a45a')
    p.rect(n * 0.36, n * 0.46, n * 0.28, n * 0.16, '#8a4a30')
    p.rect(n * 0.33, n * 0.42, n * 0.34, n * 0.05, '#5a2a1a')
    for i in range(3):
        p.rect(n * (0.4 + i * 0.08), n * 0.52, n * 0.03, n * 0.03,
               '#2a1a10')
    p.rect(n * 0.7, n * 0.12, n * 0.02, n * 0.5, '#3a2a1a')
    for i in range(5):
        p.rect(n * 0.72, n * (0.12 + i * 0.04), n * 0.2, n * 0.02,
               '#b02a2a' if i % 2 == 0 else '#f4f4f4')
    p.rect(n * 0.72, n * 0.12, n * 0.08, n * 0.08, '#2a3a8a')
    p.rect(n * 0.1, n * 0.78, n * 0.8, n * 0.04, '#d8c8a0')


