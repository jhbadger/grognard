@grognard.symbol('leader')
def s_leader(p, x, y, w, h, c):
    """A leader: a five-pointed star."""
    import math
    cx, cy = x + (w - 1) / 2, y + (h - 1) / 2
    r = max(2, min(w, h) / 2 - 1)
    pts = []
    for i in range(10):
        a = -math.pi / 2 + i * math.pi / 5
        rr = r if i % 2 == 0 else r * 0.42
        pts.append((cx + rr * math.cos(a), cy + rr * math.sin(a)))
    for i in range(10):
        (x0, y0), (x1, y1) = pts[i], pts[(i + 1) % 10]
        p.line(x0, y0, x1, y1, c)


@grognard.symbol('gatling')
def s_gatling(p, x, y, w, h, c):
    """Gatling guns: a bundle of barrels on a wheel."""
    cy = y + (h - 1) / 2
    r = max(1, min(w, h) // 5)
    cx = x + w // 3
    p.oval(cx, cy + r, r, r, c)
    for k in (-1, 0, 1):
        p.line(cx, cy + k, x + w - 2, cy + k - 1, c)


