def _river():
    """The San Juan River, between the 10th and 11th columns of hexes:
    every pair of neighbours across it."""
    out = []
    for r in range(len(MAP)):
        a = (9, r)
        for n in hexgrid.neighbours(a):
            if n[0] == 10 and 0 <= n[1] < len(MAP):
                out.append('%s/%s' % (hexgrid.hid(a), hexgrid.hid(n)))
    return out


