def hells_pocket(e):
    """At the start of each American turn, every American unit in the
    open within 3 hexes of a Spanish rifle on the hills has a 1 in 6
    chance of losing a step to fire it can't see or answer."""
    rifles = [u.hex for u in e.alive('sp') if not u.supports and
              u.attack > 0 and e.board.hexes.get(u.hex) in HILLS]
    hit = []
    for u in e.alive('us'):
        if not e.board.terrain(u.hex).get('open') or u.id == TR:
            continue
        if any(hexgrid.distance(u.hex, r) <= POCKET for r in rifles) and \
                e.rng.randint(1, 6) == 1:
            hit.append(u)
    for u in hit:
        e.say('Mauser fire from the heights: %s loses a step.' % u.long)
        e.take_losses([u], 1)


def ON_ELIMINATE(e, u, where):
    if u.id == TR:
        e.flags['trdead'] = True
        e.say('Roosevelt is down! The Rough Riders falter, and the '
              'newspapers in New York will have a different story.')


def COMBAT_SHIFTS(e, target, attackers, support):
    """Roosevelt leading an attack with other units gains a column.  Parker's
    Gatlings supporting an attack gain one.  Once Roosevelt has fallen,
    the Rough Riders attack a column worse.  The Spanish, with smokeless
    magazine rifles, gain a column attacking Americans in the open."""
    out = []
    if e.side == 'us':
        ids = {u.id for u in attackers}
        if TR in ids and len(attackers) > 1:
            out.append((1, 'Roosevelt'))
        if any(u.id == GATLING for u in support):
            out.append((1, 'Gatlings'))
        if RR in ids and e.flags.get('trdead'):
            out.append((-1, 'Roosevelt lost'))
    elif e.board.terrain(target).get('open') and attackers:
        out.append((1, 'Mausers'))
    return out


