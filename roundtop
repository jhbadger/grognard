def ON_TURN(e, side):
    """What happened on the hill, and the 20th Maine's charge."""
    f = e.flags
    me = e.units.get(MAINE)
    if side == 'cs':
        if e.turn == 1:
            e.say('A shell bursts over the Bushman farm: General Hood is '
                  'carried from the field with a shattered arm. Law takes '
                  'the division, and the brigades drift apart.')
        # the 20th Maine's attacked flag is still the one from its turn
        if f.get('ready') and me and me.alive and me.attacked:
            f['ready'] = False
            f['charged'] = True
            e.say('The 20th Maine is spent: the charge has swept down the '
                  'hill, and there will not be another.')
    else:
        if e.turn == 1:
            e.say('On the summit General Warren sees the glint of bayonets '
                  'in the trees to the south-west, and sends for help.')
        if e.turn >= CHARGE and me and me.alive and \
                not f.get('ready') and not f.get('charged') and \
                any(e.at(n, 'cs') for n in hexgrid.neighbours(me.hex)):
            f['ready'] = True
            e.say('The 20th Maine is nearly out of ammunition. Colonel '
                  'Chamberlain orders bayonets fixed: its next attack is a '
                  'charge.')


def COMBAT_SHIFTS(e, target, attackers, support):
    """The 20th Maine's bayonet charge gains two columns.  Law's
    Alabamians, who marched twenty-five miles and climbed Big Round Top
    without filling their canteens, attack a column worse from 5:20 on
    if every attacker is theirs."""
    out = []
    if e.side == 'us' and e.flags.get('ready') and \
            any(u.id == MAINE for u in attackers):
        out.append((2, 'bayonets'))
    if e.side == 'cs' and e.turn >= THIRST and attackers and \
            all(u.id in LAW for u in attackers):
        out.append((-1, 'no water'))
    return out


