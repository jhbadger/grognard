def _plum_run():
    """Plum Run comes down the valley west of Little Round Top, then
    bends south-west past Devil's Den through the Slaughter Pen."""
    out = ['13%02d:NW,SW' % r for r in range(1, 9)]
    h = hexgrid.parse('1308')
    for _ in range(6):
        h = hexgrid.neighbour(h, 4)                     # SW
        out.append(hexgrid.hid(h) + ':SE,S')
    return out


