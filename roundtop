def regt(uid, side, a, d, hx, formation, colour, long, steps=2, **kw):
    """An infantry regiment (or a brigade in two halves): attack,
    defence, and the hex it starts in (None if it arrives later, with
    arrive and at)."""
    spec = dict(id=uid, name=kw.pop('name', uid.upper()), side=side,
                type=kw.pop('type', 'infantry'), size=kw.pop('size', 'III'),
                a=a, d=d, m=kw.pop('m', 4), steps=steps, hex=hx,
                formation=formation, colour=colour, long=long)
    spec.update(kw)
    return spec


def guns(uid, side, a, rng, hx, formation, colour, long, **kw):
    spec = dict(id=uid, name=kw.pop('name', uid.upper()), side=side,
                type='artillery', size='I', a=a, d=2, m=kw.pop('m', 3),
                range=rng, steps=1, hex=hx, formation=formation,
                colour=colour, long=long)
    spec.update(kw)
    return spec


