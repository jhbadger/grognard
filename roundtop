def VICTORY(e):
    """The Confederates score the ground they hold and Union losses, the
    Union Confederate losses, and the margin decides (set from games
    between computer players: ./roundtop --simulate 60)."""
    cs, us = e.vp('cs'), e.vp('us')
    m = cs - us
    score = 'Confederates %d VP, Union %d.' % (cs, us)
    if m >= 12:
        if e.control.get(SUMMIT) == 'cs':
            return 'cs', ('Confederate victory. %s Guns on Little Round '
                          'Top look down the length of Cemetery Ridge.'
                          % score)
        return 'cs', ("Confederate victory. %s Devil's Den and Houck's "
                      'Ridge are taken, and the Union left is bled white.'
                      % score)
    if m >= 5:
        return 'cs', 'Confederate marginal victory. %s' % score
    if m > 0:
        return 'us', ('Union marginal victory. %s The hill is held, and '
                      "Devil's Den is a slaughter pen." % score)
    return 'us', ('Union victory. %s The left of the line holds, and the '
                  'Pennsylvania Reserves sweep down into the Valley of '
                  'Death.' % score)


