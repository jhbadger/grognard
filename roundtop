@grognard.icon('roundtop')
def draw_icon(p, n):
    """Little Round Top: a rocky crest with a gun and a flag."""
    p.fill('#d4dce0')
    p.disc(n * 0.55, n * 1.15, n * 0.75, '#6a7a48')
    p.disc(n * 0.55, n * 1.2, n * 0.7, '#8a8a62')
    for x, y, r in ((0.3, 0.62, 0.09), (0.48, 0.55, 0.11),
                    (0.68, 0.6, 0.1), (0.4, 0.75, 0.08),
                    (0.78, 0.74, 0.08), (0.58, 0.72, 0.07)):
        p.disc(n * x, n * y, n * r, '#a8a090')
        p.disc(n * (x - 0.02), n * (y - 0.02), n * r * 0.5, '#c4bcac')
    p.rect(n * 0.36, n * 0.44, n * 0.26, n * 0.05, '#2a2a2a')
    p.disc(n * 0.42, n * 0.5, n * 0.05, '#5a3a1a')
    p.rect(n * 0.7, n * 0.14, n * 0.02, n * 0.4, '#3a2a1a')
    p.rect(n * 0.72, n * 0.14, n * 0.16, n * 0.1, '#2a4a9a')
    p.rect(n * 0.72, n * 0.24, n * 0.16, n * 0.02, '#f4f4f4')


