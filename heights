def unit(uid, side, a, d, m, hx, long, colour, formation, steps=2, **kw):
    spec = dict(id=uid, name=kw.pop('name', uid.upper()), side=side,
                type=kw.pop('type', 'warrior'), size=kw.pop('size', 'I'),
                a=a, d=d, m=m, steps=steps, hex=hx, long=long,
                colour=colour, formation=formation)
    spec.update(kw)
    return spec


def family(k, hx):
    return unit('fam%d' % k, 'sk', 0, 1, 2, hx,
                'Women, children and old people of the band', FAMILY,
                'The band', steps=1, type='band', size='', vp=4,
                name='BAND%d' % k)


