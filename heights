@grognard.symbol('lodge')
def s_lodge(p, x, y, w, h, c):
    """Families on the move: a lodge, its poles crossing at the top."""
    cx, top, base = x + w // 2, y + 1, y + h - 2
    half = max(2, (base - top) * 2 // 3)
    p.line(cx, top, cx - half, base, c)
    p.line(cx, top, cx + half, base, c)
    p.line(cx - half, base, cx + half, base, c)
    p.line(cx - 1, top - 1 if top > y else top, cx + 1, top + 1, c)
    p.line(cx + 1, top - 1 if top > y else top, cx - 1, top + 1, c)


