def VICTORY(e):
    """The Sauk score 4 for each group of the band that gets across the
    river and 2 for each militia step; the militia score each warrior
    step, 4 for each group of the band overtaken, Black Hawk 4, and the
    knoll and the crossing if they hold them at the end.  The margins
    were set from games between computer players (./heights --simulate
    30)."""
    sk, us = e.vp('sk'), e.vp('us')
    m = sk - us
    score = 'Sauk %d VP, militia %d.' % (sk, us)
    if m >= 6:
        return 'sk', ('Sauk victory. %s The band is over the river and '
                      'away into the hills, and the militia must find the '
                      'trail again.' % score)
    if m >= 0:
        return 'sk', ('Sauk marginal victory. %s Most of the families '
                      'get across in the night.' % score)
    if m > -6:
        return 'us', ('Militia marginal victory. %s The warriors are '
                      'driven off the heights, and the band is scattered '
                      'along the river.' % score)
    return 'us', ('Militia victory. %s The rearguard is broken and the '
                  'band overtaken at the river.' % score)


