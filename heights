@grognard.icon('heights')
def draw_icon(p, n):
    """The heights above the Wisconsin River at evening, and a raft on
    the water."""
    p.fill('#e0b880')
    p.rect(0, 0, n, n * 0.25, '#c08a5a')
    p.disc(n * 0.75, n * 0.95, n * 0.6, '#8a7a4a')
    p.disc(n * 0.95, n * 0.7, n * 0.35, '#5a6a32')
    p.rect(0, n * 0.7, n * 0.6, n * 0.3, '#4a76a0')
    p.rect(n * 0.12, n * 0.78, n * 0.3, n * 0.06, '#6a4a2a')
    for k in range(3):
        p.disc(n * (0.18 + k * 0.09), n * 0.74, n * 0.035, '#3a2a1a')
    p.disc(n * 0.25, n * 0.15, n * 0.08, '#f8e8b0')


