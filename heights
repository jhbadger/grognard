def ENTER_COST(e, unit, a, b, cost):
    """Nobody crosses until the rafts are built."""
    if b in CROSSING and e.turn < RAFTS:
        return None
    return cost


def ON_TURN(e, side):
    if side == 'us' and e.turn == RAFTS:
        e.say('The rafts are ready at the river.')
    if side == 'sk' and e.turn == NIGHT + 1 and not e.flags.get('speech'):
        e.flags['speech'] = True
        e.say('Before dawn a voice calls out from the knoll in Ho-Chunk: '
              'Neapope, offering peace. No one left with the militia '
              'understands him.')


def COMBAT_SHIFTS(e, target, attackers, support):
    """The warriors fight from cover and fall back firing: attacking a
    hex of warriors in woods or tall grass costs a column.  The militia
    charge with the bayonet: militia attacking with three or more
    battalions gain a column.  In the dark the militia, who don't know
    the ground, attack two columns worse."""
    out = []
    t = e.board.hexes.get(target)
    if e.side == 'us':
        if t in ('woods', 'grass') and \
                any(u.kind == 'warrior' for u in e.at(target, 'sk')):
            out.append((-1, 'cover'))
        if len(attackers) >= 3:
            out.append((1, 'bayonets'))
        if e.weather()['id'] == 'night':
            out.append((-2, 'darkness'))
    return out


