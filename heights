def TURN_NAME(t):
    """The sources don't give the hour: the day turns, then dusk and the
    night, when the militia put off their attack until morning."""
    if t >= NIGHT:
        part = 'Night'
    elif t >= DUSK:
        part = 'Dusk'
    else:
        part = 'Day'
    return ('21 Jul 1832', part)


