def _balikh():
    """The Balikh runs south past Carrhae along the west of the map:
    every side between the third column and the fourth."""
    out = []
    for r in range(len(MAP)):
        for n in hexgrid.neighbours((2, r)):
            if n[0] == 3 and 0 <= n[1] < len(MAP):
                out.append('%s/%s' % (hexgrid.hid((2, r)), hexgrid.hid(n)))
    return out


