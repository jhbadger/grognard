@grognard.symbol('horsebow')
def s_horsebow(p, x, y, w, h, c):
    """Horse archers: the cavalry stroke, and a bow drawn across it."""
    p.line(x, y + h - 1, x + w - 1, y, c)
    cx, cy = x + w * 0.62, y + (h - 1) / 2
    r = max(2, h // 2 - 1)
    p.line(cx, cy - r, cx, cy + r, c)                       # string
    for i in range(r + 1):                                  # stave
        dx = int(round((r * r - i * i) ** 0.5 * 0.6))
        p.set(cx - dx, cy - i, c)
        p.set(cx - dx, cy + i, c)


@grognard.symbol('camel')
def s_camel(p, x, y, w, h, c):
    """The camel train: a hump on a line of march."""
    base = y + h - 2
    p.line(x + 1, base, x + w - 2, base, c)
    cx = x + (w - 1) / 2
    r = max(2, h // 3)
    for i in range(-r, r + 1):
        dy = int(round((r * r - i * i) ** 0.5))
        p.line(cx + i, base - dy, cx + i, base, c)
    p.line(x + 2, base - r - 1, x + 2, base, c)              # the neck


