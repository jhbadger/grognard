def unit(uid, side, a, d, m, hx, long, colour, formation, steps=2, **kw):
    spec = dict(id=uid, name=kw.pop('name', uid.upper()), side=side,
                type=kw.pop('type', 'legion'), size=kw.pop('size', 'X'),
                a=a, d=d, m=m, steps=steps, hex=hx, long=long,
                colour=colour, formation=formation)
