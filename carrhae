def _score(e):
    return 'Parthians %d VP, Romans %d.' % (e.vp('pa'), e.vp('ro'))


def VICTORY(e):
    """The Romans score each step that reaches Carrhae and each
    Parthian step destroyed; the Parthians each Roman step, two more
    for each eagle taken (a legion destroyed) and Crassus (5).  The
    margin decides (set from games between computer players:
    ./carrhae --simulate 60)."""
    pa, ro = e.vp('pa'), e.vp('ro')
    m = pa - ro
    if m >= THRESHOLD + 10:
        return 'pa', ('Parthian victory. %s The eagles of Rome hang in '
                      'the temples of Parthia, and Crassus\'s head is sent '
                      'to the king.' % _score(e))
    if m >= THRESHOLD:
        return 'pa', ('Parthian marginal victory. %s The Romans reach '
                      'Carrhae, but they will never get home.' % _score(e))
    if m > THRESHOLD - 10:
        return 'ro', ('Roman marginal victory. %s The legions reach the '
                      'walls of Carrhae with most of their eagles.'
                      % _score(e))
    return 'ro', ('Roman victory. %s The legions march into Carrhae in '
                  'good order, and Surena rides off to tell the king.'
                  % _score(e))


