@grognard.icon('carrhae')
def draw_icon(p, n):
    """A block of red shields on the sand under a rain of arrows."""
    p.fill('#e8d8a8')
    p.rect(0, n * 0.6, n, n * 0.4, '#d4c08a')
    for i in range(3):
        for j in range(2):
            x, y = n * (0.24 + i * 0.18), n * (0.62 + j * 0.15)
            p.rect(x, y, n * 0.15, n * 0.13, '#a8322a')
            p.rect(x + n * 0.06, y + n * 0.04, n * 0.03, n * 0.05,
                   '#f0d478')
    for k in range(7):
        x = n * (0.1 + k * 0.12)
        for s in range(6):
            p.rect(x + s * n * 0.015, n * (0.1 + k % 3 * 0.08) +
                   s * n * 0.03, n * 0.02, n * 0.02, '#3a2414')
    p.disc(n * 0.82, n * 0.16, n * 0.08, '#f4b040')


