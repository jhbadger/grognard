class Surena(ai.AI):
    """The stock computer player, with a horse archer's sense: an empty
    quiver sends it back to the camels, and the camels keep near the
    archers and away from the legions."""

    def score(self, u, h):
        s = super().score(u, h)
        e = self.e
        camels = e.units.get('camels')
        if u.kind == 'horsearcher' and camels and camels.alive and \
                arrows_left(e, u) <= 1 and not night(e):
            s -= max(0, hexgrid.distance(h, camels.hex) - 1) * 3
        elif u.kind == 'camels':
            foes = [x.hex for x in e.alive('ro')]
            near = min([hexgrid.distance(h, f) for f in foes] or [9])
            s += min(near, 4) * 2
            bows = [x.hex for x in e.alive('pa') if x.kind == 'horsearcher']
            if bows:
                s -= sum(hexgrid.distance(h, b) for b in bows) / \
                    len(bows) * 0.8
        return s


