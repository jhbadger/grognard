# ----------------------------------------------------------- the arrows

QUIVER = 3              # volleys a horse archer carries
CAMEL_REACH = 3         # how near the camels it must be to refill


def _arrows(e):
    return e.flags.setdefault('arrows', {})


def arrows_left(e, u):
    """Volleys a horse archer has left now: what it had at the start of
    the Parthian turn, less a volley if it has shot since (in its own
    turn, or into a Roman charge)."""
    n = _arrows(e).get(u.id, QUIVER)
    if e.side == 'ro':
        n -= int(u.fired) + int(u.dfired)
    else:
        n -= int(u.fired)
    return max(0, n)


def night(e):
    return e.turn >= NIGHT


def CAN_SUPPORT(e, u):
    """Horse archers shoot only with arrows in the quiver, and not in
    the dark."""
    if u.kind != 'horsearcher':
        return True
    return not night(e) and arrows_left(e, u) > 0


def ENTER_COST(e, unit, a, b, cost):
    """Marching under the arrows: by day, Roman foot entering a hex in
    range of a horse archer with arrows left pays a point more, to keep
    its ranks closed."""
    if cost is None or getattr(unit, 'side', None) != 'ro' or \
            unit.kind == 'cavalry' or night(e):
        return cost
    for x in e.alive('pa'):
        if x.kind == 'horsearcher' and \
                hexgrid.distance(x.hex, b) <= x.range and \
                arrows_left(e, x) > 0:
            return cost + 1
    return cost


def _testudo(e, u):
    """A legion that neither moved nor fought in its last turn stands
    with its shields locked."""
    return u.kind == 'legion' and not u.moved and not u.attacked


def ON_TURN(e, side):
    """The quivers: at the start of the Parthian turn each horse archer
    pays for the volleys it shot since the last one, and those near the
    camels fill up again.  And the hours of the day."""
    if side == 'pa':
        q = _arrows(e)
        camels = e.units.get('camels')
        full = 0
        for u in e.alive('pa'):
            if u.kind != 'horsearcher':
                continue
            n = q.get(u.id, QUIVER) - int(u.fired) - int(u.dfired)
            if camels and camels.alive and \
                    hexgrid.distance(u.hex, camels.hex) <= CAMEL_REACH:
                if n < QUIVER:
                    full += 1
                n = QUIVER
            q[u.id] = max(0, n)
        if e.turn == 1:
            e.say('The kettledrums roll across the plain, and the '
                  'Parthians throw off the skins that hid their armour.')
        elif full:
            e.say('The camels bring up fresh arrows: %d squadron%s fill '
                  'their quivers.' % (full, 's' if full > 1 else ''))
        if e.turn == NIGHT:
            e.say('Night falls. The Parthians never fight in the dark: '
                  'they ride off, promising to come back for the rest in '
                  'the morning.')
    else:
        if e.turn == 1:
            e.say('Crassus forms his army in a hollow square, twelve '
                  'cohorts to a side, with the horse on the wings.')
        if e.turn == NIGHT:
            e.say('In the dark the army can slip away to Carrhae, leaving '
                  'the wounded behind.')


def ON_ELIMINATE(e, u, where):
    """Publius, the camels, and Crassus himself."""
    if u.id == 'publius':
        e.flags['publius'] = True
        e.say("Publius Crassus is dead! The Parthians ride along the "
              "square with his head on a lance, and the legions lose "
              'heart.')
    elif u.id == 'crassus':
        e.flags['crassus'] = True
        e.say('Crassus has fallen! The legions fight on without hope.')
    elif u.id == 'camels':
        e.say('The camel train is taken. The Parthians will get no more '
              'arrows.')
    elif u.id == 'surena':
        e.flags['surena'] = True
        e.say('Surena is down! The Parthians pull back to think again.')


def COMBAT_SHIFTS(e, target, attackers, support):
    """Shields, lances and morale:
    - horse archers shooting alone at legions standing in testudo
      lose two columns;
    - cataphracts charging a legion in testudo gain a column (the lance
      against men packed too close to fight back), and charging anyone
      else in the open gain one too;
    - Roman foot attacking only horse archers lose a column (they ride
      away);
    - in the dark the Parthians attack two columns worse;
    - with Publius dead the Romans attack a column worse, and with
      Crassus dead another; with Surena dead, the Parthians one."""
    out = []
    t = e.board.terrain(target) or {}
    defenders = e.at(target)
    legions = [u for u in defenders if u.kind == 'legion']
    if e.side == 'pa':
        if not attackers and support and legions and \
                all(_testudo(e, u) for u in legions):
            out.append((-2, 'testudo'))
        cata = [u for u in attackers if u.kind == 'cataphract']
        if cata:
            if legions and all(_testudo(e, u) for u in legions):
                out.append((1, 'lances'))
            elif not legions and t.get('open'):
                out.append((1, 'charge'))
        if night(e):
            out.append((-2, 'darkness'))
        if e.flags.get('surena'):
            out.append((-1, 'Surena is down'))
    else:
        if attackers and defenders and \
                all(u.kind == 'horsearcher' for u in defenders) and \
                all(u.kind in ('legion', 'aux') for u in attackers):
            out.append((-1, 'they ride away'))
        if e.flags.get('publius'):
            out.append((-1, 'Publius is dead'))
        if e.flags.get('crassus'):
            out.append((-1, 'Crassus is dead'))
    return out


