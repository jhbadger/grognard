def TURN_NAME(t):
    """Two hours a turn, from four in the morning."""
    h = 4 + (t - 1) * 2
    return ('6 Jun 1918', '%d %s' % ((h - 1) % 12 + 1,
                                     'AM' if h < 12 else 'PM'))


