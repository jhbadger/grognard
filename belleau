@grognard.icon('belleau')
def draw_icon(p, n):
    """A dark wood above a field of wheat, and tracer across it."""
    p.fill('#c8ccc0')
    p.rect(0, n * 0.55, n, n * 0.45, '#d4c478')
    for k in range(7):
        p.disc(n * (0.04 + k * 0.155), n * 0.42, n * 0.16, '#3e5a2a')
    p.rect(0, n * 0.42, n, n * 0.14, '#3e5a2a')
    for k in range(9):
        x = n * (0.05 + k * 0.11)
        p.line(x, n * 0.95, x + n * 0.03, n * 0.66, '#b0a050',
               max(1, n // 48))
    for k in range(3):
        y = n * (0.6 + k * 0.08)
        p.line(n * 0.15, y - n * 0.04, n * 0.8, y, '#f8e070',
               max(1, n // 64))
    p.disc(n * 0.88, n * 0.16, n * 0.07, '#f4f0d0')


