def _dark(e):
    return e.weather().get('spot') == 1


# ------------------------------------------------------- grazing fire

def ON_MOVE(e, u, path):
    """Into the wheat: by daylight a Marine unit that moves through
    wheat within reach of a German machine gun may lose a step to its
    fire before it gets there."""
    if u.side != 'us' or _dark(e) or not u.alive:
        return
    wheat = [h for h in path[1:] if e.board.terrain_name(h) == 'wheat']
    if not wheat:
        return
    guns = [x for x in e.alive('de') if x.kind == 'mg' and not x.disabled]
    if not any(hexgrid.distance(g.hex, h) <= GRAZE_RANGE
               for g in guns for h in wheat):
        return
    if e.rng.randint(1, 6) <= GRAZE:
        at = wheat[-1]
        e.events.append(('sound', 'gun'))
        e.events.append(('popup', at, 'Cut down', (240, 220, 200)))
        e.say('Machine guns sweep the wheat: %s lose a step crossing '
              'it.' % u.long)
        e.take_losses([u], 1)


def ON_TURN(e, side):
    """The day."""
    if side == 'us':
        if e.turn == 1:
            e.say('3:45 AM. The 1st Battalion, 5th Marines goes forward '
                  'against Hill 142 in four waves, bayonets fixed.')
        elif e.turn == EVENING:
            e.say('Afternoon. The 3rd Battalions of the 5th and 6th '
                  'Marines and the 2nd of the 6th form up in the wheat. '
                  '"Come on, you sons of bitches! Do you want to live '
                  'forever?"')
    elif e.turn == 9:
        e.say('Dusk. The German reserves come down through the wood to '
              'counterattack.')


def ON_ELIMINATE(e, u, where):
    if u.kind == 'mg' and u.side == 'de':
        e.say('A machine-gun nest is taken with grenades and bayonets.')


def COMBAT_SHIFTS(e, target, attackers, support):
    """Rifles and the dark:
    - Marines attacking anything in the open gain a column (aimed rifle
      fire at long range);
    - by night the Germans gain a column attacking (they know the wood)."""
    out = []
    t = e.board.terrain(target) or {}
    if e.side == 'us':
        if attackers and t.get('open'):
            out.append((1, 'aimed fire'))
    elif attackers and _dark(e):
        out.append((1, 'they know the wood'))
    return out


