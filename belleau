def _score(e):
    return 'Marines %d VP, Germans %d.' % (e.vp('us'), e.vp('de'))


def VICTORY(e):
    """The Marines score Hill 142 (4), Bouresches (6) and the south (4)
    and north (6) of the wood if they hold them at the end, and every
    German step; the Germans every Marine step.  The Marines must finish
    THRESHOLD ahead (set from games between computer players: ./belleau
    --simulate 60)."""
    m = e.vp('us') - e.vp('de')
    if m >= THRESHOLD + 8:
        return 'us', ('Marine victory. %s The Germans are driven out of '
                      'the wood, and the French rename it the Wood of the '
                      'Marine Brigade.' % _score(e))
    if m >= THRESHOLD:
        return 'us', ('Marine marginal victory. %s The Marines hold a '
                      'foothold in the wood. It will take them three more '
                      'weeks to clear it.' % _score(e))
    if m > THRESHOLD - 8:
        return 'de', ('German marginal victory. %s The Marines are thrown '
                      'back into the wheat, with the worst losses in the '
                      'history of the Corps.' % _score(e))
    return 'de', ('German victory. %s The attack is shattered in the '
                  'wheat, and the road to Paris is open again.' % _score(e))


