@grognard.icon('farsuns')
def draw_icon(p, n):
    """A ringed world before a yellow sun."""
    p.fill('#0a0e1c')
    for i in range(40):
        x, y = hsh(i, 1, 3) * n, hsh(i, 2, 3) * n
        p.rect(x, y, max(1, n // 64), max(1, n // 64), '#c8d0f0')
    p.disc(n * 0.78, n * 0.22, n * 0.2, '#806010')
    p.disc(n * 0.78, n * 0.22, n * 0.15, '#ffd860')
    p.disc(n * 0.78, n * 0.22, n * 0.07, '#fff8e0')
    p.disc(n * 0.42, n * 0.6, n * 0.3, '#1e4a8a')
    p.disc(n * 0.4, n * 0.57, n * 0.26, '#3a74c8')
    p.disc(n * 0.32, n * 0.5, n * 0.08, '#4ab04a')
    p.disc(n * 0.48, n * 0.66, n * 0.06, '#4ab04a')
    p.line(n * 0.02, n * 0.74, n * 0.84, n * 0.44, '#d8c890',
           max(1, n // 24))


