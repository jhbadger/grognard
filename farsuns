def BUILD_SITES(e, side):
    return sorted(u.hex for u in e.alive(side)
                  if u.kind == 'colony' and u.steps >= SHIPYARD)


def blockaded(e, c):
    """A world with enemy warships next to it is blockaded: it pays
    nothing, builds nothing and doesn't grow."""
    for n in hexgrid.neighbours(c.hex):
        for u in e.at(n):
            if u.side != c.side and u.side in ORDER and u.attack > 0 and \
                    u.max_mp > 0:
                return True
    return False


def CAN_BUILD(e, side, kind, h):
    c = colony_at(e, h)
    if c is not None and blockaded(e, c):
        return 'blockaded'
    if kind == 'dreadnought' and (c is None or c.steps < 6):
        return 'needs a yard of 6 people'
    if kind == 'starbase' and sum(1 for u in e.at(h, side)
                                  if u.kind == 'starbase') >= 2:
        return 'two starbases here already'
    return None


def ON_BUILD(e, u):
    """Number each kind of ship as it's built: the Concord's third
    cruiser is CR3."""
    built = e.flags.setdefault('built', {})
    key = '%s:%s' % (u.side, u.kind)
    built[key] = n = built.get(key, 0) + 1
    u.name = u.spec['name'] = '%s%d' % (BUILDS[u.kind]['unit']['name'], n)
    u.long = u.spec['long'] = '%s %s %d' % (
        e.side_name(u.side, 'adj'), BUILDS[u.kind]['name'].lower(), n)
    u.formation = u.spec['formation'] = '%s fleet' % e.side_name(
        u.side, 'adj')
    explore(e, u.side, [u.hex], u.type.get('explore', 1))


def upkeep(e, side):
    return sum(BUILDS[u.kind].get('upkeep', 0) for u in e.alive(side)
               if u.kind in BUILDS)


def INCOME(e, side):
    """Every world pays: its people, and its ore; every warship and
    starbase costs its upkeep.  (The treasury never goes below 0.)"""
    n = -upkeep(e, side)
    for u in e.alive(side):
        if u.kind == 'colony' and not blockaded(e, u):
            n += u.steps + ore(world(e, u.hex))
    return max(n, -e.treasury[side])


# --------------------------------------------------------------- orders

def ACTIONS(e, u):
    if u.kind != 'colony_ship':
        return []
    if not e.moving:
        return []
    if u.hex not in STARS:
        return [('Colonize', 'colonize', 'only at a star')]
    p = world(e, u.hex)
    if p is None:
        return [('Colonize', 'colonize', 'no world here fit to live on')]
    c = colony_at(e, u.hex)
    if c is not None:
        return [('Settle', 'settle', None if c.steps < c.max_steps
                 else 'the colony is full')]
    return [('Colonize', 'colonize', None)]


def ACT(e, u, key):
    h = u.hex
    p = world(e, h)
    if key == 'colonize':
        c = found(e, u.side, h, 2 if p.get('pacified') else 1)
        e.say('%s %s a colony at %s.' % (e.side_name(u.side), e.verb(
            u.side, 'found'), e.place(h)), u.side)
    else:
        c = colony_at(e, h)
        c.steps += 1
        e.say('Settlers swell the colony at %s.' % e.place(h), u.side)
    e.remove(u)
    e.events.append(('capture', h, c.side))


def ON_MOVE(e, u, path):
    explore(e, u.side, path, u.type.get('explore', 1))


def ON_TURN(e, side):
    """Colonies grow, every third turn, and whatever is near a star
    looks at it."""
    if e.turn % GROWTH == 0:
        for u in e.alive(side):
            if u.kind == 'colony' and u.steps < u.max_steps and \
                    not blockaded(e, u):
                u.steps += 1
        e.changed()
    for u in e.alive(side):
        explore(e, side, [u.hex], u.type.get('explore', 1))


def ON_ELIMINATE(e, u, where):
    if u.side == 'nat':
        planets(e)[hid(where)]['pacified'] = True
        return
    if u.kind == 'colony' and u.spec.get('home') and not e.over:
        win = [s for s in ORDER if s != u.side][0]
        e.finish(win, 'The %s %s %s, the %s homeworld. %s' % (
            e.side_name(win, 'adj'), 'fleet conquers', e.place(where),
            e.side_name(u.side, 'adj'),
            'The stars belong to the %s.' % e.side_name(win)))


# ------------------------------------------------------------ the score

def empire(e, side):
    cols = [u for u in e.alive(side) if u.kind == 'colony']
    return len(cols), sum(u.steps for u in cols)


def SCORE(e, side):
    """Population, everywhere you rule."""
    return empire(e, side)[1]


def VICTORY(e):
    """No homeworld fell: the bigger empire wins."""
    (wa, pa), (wb, pb) = empire(e, 'cc'), empire(e, 'kd')
    tally = 'The Concord rules %d world%s and %d billion people; the ' \
        'Kesh %d world%s and %d billion.' % (wa, '' if wa == 1 else 's',
                                             pa, wb, '' if wb == 1 else 's',
                                             pb)
    if pa == pb:
        return None, 'Neither homeworld fell, and neither empire is the ' \
            'greater. %s' % tally
    win = 'cc' if pa > pb else 'kd'
    return win, 'Neither homeworld fell, but the %s empire is the ' \
        'greater. %s' % (e.side_name(win, 'adj'), tally)


# ------------------------------------------------ the computer player

class Strategist(StockAI):
    """Plays Far Suns, where the stock computer player (which knows
    objectives and battle lines) wouldn't know what to do: it builds,
    sends scouts to the nearest stars nobody has looked at, colony ships
    to the best free worlds it knows, and warships on missions: to
    defend a threatened colony, to pacify natives on a world worth
    having, to raid an enemy colony or, once it's strong enough, to take
    the enemy homeworld.  A mission's ships gather two hexes from the
    target, where they can see what's there, until enough have come up,
    and then go in together."""

    WAR = ('escort', 'cruiser', 'dreadnought')
    going = None            # the targets its fleets have gone in on

    def begin(self):
        StockAI.begin(self)
        e = self.e
        self.enemy_side = [s for s in ORDER if s != self.side][0]
        self.planned = False
        self.target = {}
        known = explored(e, self.side)
        self.known = {parse(h) for h in known}
        self.unexplored = [s for s in STARS if s not in self.known]
        seen = self.enemies()
        self.foe_ships = [(u, h) for u, h in seen
                          if u.side == self.enemy_side and u.kind in
                          self.WAR + ('starbase',)]
        self.foe_cols = [(u, h) for u, h in seen if u.kind == 'colony']
        self.natives = {h: u for u, h in seen if u.side == 'nat'}
        self.home = parse(e.flags['home'][self.side])
        if self.going is None:
            self.going = set()

    # ------------------------------------------------------- what's what

    def free_worlds(self):
        """Known worlds a colony ship could settle: (value, hex)."""
        e = self.e
        taken = {h for _, h in self.foe_cols} | set(self.natives) | \
            {u.hex for u in e.alive(self.side) if u.kind == 'colony'}
        out = []
        for h in self.known:
            p = world(e, h)
            if p is None or h in taken or p.get('home'):
                continue
            out.append((worth(p) + (1 if p.get('pacified') else 0), h))
        return out

    def danger(self, h, reach=4):
        return sum(u.attack for u, fh in self.foe_ships
                   if distance(h, fh) <= reach and u.max_mp > 0)

    def count(self, kind):
        return sum(1 for u in self.e.alive(self.side) if u.kind == kind)

    # ---------------------------------------------------------- building

    def wishes(self):
        e = self.e
        t = e.turn
        sites = e.build_sites(self.side)
        if not sites:
            return []
        yard = max(sites, key=lambda h: (colony_at(e, h).steps, h))
        # warships from the yard nearest the enemy's home, once it's known
        foe = [h for u, h in self.foe_cols if u.spec.get('home')]
        front = min(sites, key=lambda h: (distance(h, foe[0]), h)) \
            if foe else yard
        big = [h for h in sites if colony_at(e, h).steps >= 6]
        dread_yard = min(big, key=lambda h: (distance(h, foe[0]), h)) \
            if foe and big else yard
        out = []
        scouts = self.count('scout')
        if self.unexplored and scouts < min(3, 1 + len(self.unexplored) //
                                            8):
            out.append(('scout', yard))
        free = sorted(self.free_worlds(), reverse=True)
        ships = self.count('colony_ship')
        if free and ships < min(len(free), 3 if t < 20 else 1):
            best = free[0][1]
            near = min(sites, key=lambda h: (distance(h, best), h))
            out.append(('colony_ship', near))
            if e.treasury[self.side] < BUILDS['colony_ship']['cost'] and \
                    t < 25:
                return out          # save up for it
        bases = sum(1 for u in e.at(self.home, self.side)
                    if u.kind == 'starbase')
        if colony_at(e, self.home) and (
                (self.danger(self.home, 7) and bases < 2) or
                (t >= 18 and bases < 1)):
            out.append(('starbase', self.home))
        # warships, while there's income to keep them
        cash = e.treasury[self.side]
        spare = INCOME(e, self.side) + upkeep(e, self.side) - \
            upkeep(e, self.side) * 1.15
        if t >= 10 and cash >= BUILDS['dreadnought']['cost'] and \
                spare >= 4:
            out.append(('dreadnought', dread_yard))
        if cash >= BUILDS['cruiser']['cost'] and spare >= 2 and \
                (t < 10 or cash < 24 or t % 2):
            out.append(('cruiser', front))
        if t < 8 and self.count('escort') < 3 and spare >= 1:
            out.append(('escort', front))
        return out

    def next_build(self):
        e = self.e
        for kind, h in self.wishes():
            if e.build_reason(kind, h) is None:
                return ('build', kind, h)
        return None

    # ------------------------------------------------------- settling

    def next_act(self):
        e = self.e
        for u in e.alive(self.side):
            if u.kind != 'colony_ship':
                continue
            goal = self.target.get(u.id, (None,))[0]
            if goal not in (None, u.hex) and colony_at(e, u.hex) is None:
                continue
            for label, key, why in e.actions(u):
                if key == 'colonize' and not why:
                    return ('act', u.id, key)
        return None

    # ---------------------------------------------------------- missions

    def plan(self):
        """Who goes where this turn: self.target[unit id] = (hex, how
        close to stop)."""
        e = self.e
        self.target = {}
        mine = e.alive(self.side)
        # scouts: the nearest stars nobody has looked at
        left = list(self.unexplored)
        for u in sorted((u for u in mine if u.kind == 'scout'),
                        key=lambda u: u.id):
            if not left:
                self.target[u.id] = (self.home, 2)
                continue
            s = min(left, key=lambda s: (distance(u.hex, s), s))
            left.remove(s)
            self.target[u.id] = (s, 1)
        # colony ships: the best world for the trip
        free = self.free_worlds()
        for u in sorted((u for u in mine if u.kind == 'colony_ship'),
                        key=lambda u: u.id):
            if not free:
                self.target[u.id] = (self.home, 0)
                continue
            v, h = max(free, key=lambda vh: (
                vh[0] - 0.6 * distance(u.hex, vh[1]) / max(1, u.max_mp),
                vh[1]))
            free.remove((v, h))
            self.target[u.id] = (h, 0)
        # warships: missions, the most pressing first
        self.filling = {}
        war = [u for u in mine if u.kind in self.WAR]
        strength = sum(u.attack for u in war)
        # (hex, strength needed, stop, all in, from how far)
        missions = []
        # the homeworld first, from anywhere near
        d = self.danger(self.home, 3)
        if d:
            missions.append((self.home, d, 0, False, 8))
        # then the enemy's, if it's known and there's strength enough
        foe_home = None
        for u, h in self.foe_cols:
            if u.spec.get('home'):
                foe_home = h
                guard = sum(x.defense for x, fh in self.foe_ships if fh == h)
                need = (u.defense + guard) * 2 + 2
                if strength >= need:        # strong enough: all in
                    missions.append((h, need, 1, True, None))
        # then colonies in danger, from ships close by
        for c in sorted((u for u in mine if u.kind == 'colony' and
                         not u.spec.get('home')),
                        key=lambda c: (-c.steps, c.id)):
            d = self.danger(c.hex, 3)
            if d and c.steps >= 3:
                missions.append((c.hex, d * 0.7, 0, False, 5))
        # raids on enemy colonies, the nearest first
        for u, h in sorted(self.foe_cols, key=lambda uh: (
                distance(self.home, uh[1]), uh[1])):
            if not u.spec.get('home'):
                guard = sum(x.defense for x, fh in self.foe_ships
                            if fh == h)
                missions.append((h, (u.defense + guard) * 2 + 2, 1, False,
                                 12))
        pacify = []
        for h, u in self.natives.items():
            p = world(e, h)
            if p and not any(fh == h for _, fh in self.foe_cols):
                pacify.append((worth(p) - 0.3 * distance(self.home, h), h,
                               u))
        pacify.sort(reverse=True)
        for _, h, u in pacify[:2]:
            missions.append((h, u.defense * 2 + 1, 1, False, None))
        for h, need, stop, all_in, radius in missions:
            free_war = [u for u in war if u.id not in self.target and
                        (radius is None or distance(u.hex, h) <= radius)]
            if sum(u.attack for u in free_war) < need:
                continue
            free_war.sort(key=lambda u: (distance(u.hex, h), u.id))
            got = 0
            group = []
            for u in free_war:
                if got >= need and not all_in:
                    break
                group.append(u)
                got += u.attack
            # muster in a stack or two, a turn's move away, until enough
            # have come up; then all go in together (and keep at it while
            # there's half enough left)
            near = sum(u.attack for u in group
                       if distance(u.hex, h) <= MUSTER)
            go = stop == 0 or near >= need or \
                (hid(h) in self.going and near >= need * 0.5)
            if go and stop:
                self.going.add(hid(h))
            else:
                self.going.discard(hid(h))
            spots = self.muster_hexes(h) if not go else []
            for u in group:
                if go or not spots:
                    self.target[u.id] = (h, stop)
                    continue
                spot = spots[0]
                self.target[u.id] = (spot, 0)
                self.filling[spot] = self.filling.get(spot, 0) + 1
                if self.filling[spot] >= STACK:
                    spots.pop(0)
        # the rest wait where they can strike: near the enemy's home if
        # it's known, or at their own
        spots = self.muster_hexes(foe_home) if foe_home else []
        for u in war:
            if u.id in self.target:
                continue
            if spots:
                spot = spots[0]
                self.target[u.id] = (spot, 0)
                self.filling[spot] = self.filling.get(spot, 0) + 1
                if self.filling[spot] >= STACK and len(spots) > 1:
                    spots.pop(0)
            else:
                self.target[u.id] = (self.home, 0)

    def muster_hexes(self, h):
        """Where a fleet gathers to strike at h: hexes MUSTER away, on
        the side nearest home, out of nebulae, with room."""
        e = self.e
        out = []
        for x in hexgrid.ring(h, MUSTER):
            t = e.board.terrain(x)
            if t is None or t.get('los') is False or \
                    x in e.enemy_hexes(self.side) or \
                    self.filling.get(x, 0) >= STACK:
                continue
            out.append(x)
        out.sort(key=lambda x: (distance(x, self.home), x))
        return out

    def best_hex(self, u):
        e = self.e
        if u.id not in self.target:
            self.plan()
        goal, stop = self.target.get(u.id, (u.hex, 0))
        f = self.field([goal], u.move_class)
        reach = e.reachable(u)
        unarmed = u.attack == 0
        best, best_s = None, None
        for h in list(reach) + [u.hex]:
            d = f.get(h, 99)
            s = -(d - stop) if d >= stop else -(stop - d) * 1.5
            if unarmed:
                s -= self.danger(h, 3) * 0.5
            elif stop and d == stop:
                # going in: together, not spread round the target
                s += 0.4 * sum(1 for x in e.at(h, self.side)
                               if x.kind in self.WAR)
            if h == u.hex:
                s += 0.05
            s += self.rng.uniform(0, 0.02)
            if best_s is None or s > best_s:
                best, best_s = h, s
        return best

    def next_move(self):
        e = self.e
        if e.phase == e.phases[0]:
            b = self.next_build()
            if b:
                return b
        if not self.planned:
            self.plan()
            self.planned = True
        a = self.next_act()
        if a:
            return a
        units = [u for u in e.alive(self.side)
                 if u.id not in self.done and u.mp > 0]
        units.sort(key=lambda u: (u.kind not in self.WAR, u.id))
        for u in units:
            self.done.add(u.id)
            dest = self.best_hex(u)
            if dest is not None and dest != u.hex:
                return ('move', u.id, dest)
        return ('end',)

    # ---------------------------------------------------------- fighting

    def step_value(self, u):
        """What one step of u is worth, in industry."""
        if u.kind == 'colony':
            return 14 if u.spec.get('home') else 4
        if u.side == 'nat':
            p = world(self.e, u.hex)
            return (worth(p) * 1.2 if p else 3) / u.max_steps
        b = BUILDS.get(u.kind)
        return b['cost'] / max(1, u.max_steps) if b else 3

    def expected(self, target, attackers, support):
        e = self.e
        o = e.odds(target, attackers, support)
        if o['final'] < 0:
            return -99, o
        defenders = [x for x in e.at(target) if x.side != self.side]
        dsteps = sum(x.steps for x in defenders)
        asteps = sum(x.steps for x in attackers)
        dval = sum(self.step_value(x) * x.steps for x in defenders) / \
            max(1, dsteps)
        aval = sum(self.step_value(x) * x.steps for x in attackers) / \
            max(1, asteps)
        prize = 0
        for x in defenders:
            if x.kind == 'colony' and x.spec.get('home'):
                prize += 500
            elif x.side == 'nat' or x.kind == 'colony':
                prize += 4
        total = 0.0
        for res in e.outcomes(o['final']):
            dl = dsteps if res['de'] else min(res['d'], dsteps)
            al = asteps if res['ae'] else min(res['a'], asteps)
            v = dl * dval - al * aval
            if dl >= dsteps:
                v += prize
            total += v
        return total / len(e.outcomes(o['final'])) / 3, o


