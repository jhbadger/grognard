def _sky():
    """The cluster: forty suns, never closer than three hexes, and a few
    nebulae between them.  The same every game (the worlds round them
    are dealt afresh)."""
    rng = random.Random(1977)
    stars = {h: 'Y' for h in HOME_SPOTS}
    tries = 0
    while len(stars) < 40 and tries < 20000:
        tries += 1
        h = (rng.randrange(1, COLS - 1), rng.randrange(1, ROWS - 1))
        if all(distance(h, s) >= 3 for s in stars):
            k = rng.randrange(100)
            for letter, _, share in STAR_KINDS:
                if k < share:
                    break
                k -= share
            stars[h] = letter
    nebula = set()
    for _ in range(5):
        while True:
            c = (rng.randrange(4, COLS - 4), rng.randrange(4, ROWS - 4))
            if all(distance(c, s) >= 5 for s in HOME_SPOTS):
                break
        for h in hexgrid.within(c, 2):
            if (distance(h, c) <= 1 or rng.random() < 0.45) and \
                    0 <= h[0] < COLS and 0 <= h[1] < ROWS and \
                    h not in stars:
                nebula.add(h)
    rows = []
    for r in range(ROWS):
        row = ''
        for c in range(COLS):
            row += stars.get((c, r)) or ('n' if (c, r) in nebula else '.')
        rows.append(row)
    names = list(STAR_NAMES)
    rng.shuffle(names)
    labels = {hid(h): names[i] for i, h in enumerate(sorted(stars))}
    return rows, labels


