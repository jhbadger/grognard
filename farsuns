def DRAW_MAP(g, s):
    """A dot by each star a side has explored: the colour of its world
    (grey for none fit to live on)."""
    e = g.e
    v = g.view
    viewer = g.viewer()
    known = None if viewer is None else explored(e, viewer)
    shown = set(v.visible_hexes())
    geo = v.geo
    r = (1, 2, 3)[v.zoom]
    x0, y0, x1, y1 = v.clip()
    s.set_clip(x0, y0, x1 - x0, y1 - y0)
    for h in STARS:
        if h not in shown or (known is not None and hid(h) not in known):
            continue
        sx, sy = v.to_screen(h)
        px, py = int(sx - geo.dx * 0.42), int(sy - geo.dy * 0.28)
        p = world(e, h)
        if p is None:
            s.rect(px, py, 1, 1, rgb('#707070'))
            continue
        col = rgb('#ffffff') if p.get('home') else rgb(WORLDS[p['kind']][3])
        s.rect(px - r, py - r + 1, 2 * r + 1, 2 * r - 1, (0, 0, 0))
        s.rect(px - r + 1, py - r, 2 * r - 1, 2 * r + 1, (0, 0, 0))
        s.rect(px - r + 1, py - r + 1, 2 * r - 1, 2 * r - 1, col)
    s.set_clip()


@grognard.widget('empire')
class Empire(grognard.Widget):
