def star_glyph(colour, size):
    """A sun in the middle of its hex: a white-hot core in a glow."""
    def draw(s, cx, cy, sc, h):
        R = max(1.5, size * sc)
        for rf, f in ((2.3, 0.86), (1.7, 0.66), (1.25, 0.35), (1.0, 0.0),
                      (0.5, -0.7)):
            col = mix(colour, '#ffffff', -f) if f < 0 else \
                mix(colour, SPACE, f)
            r = R * rf
            ir = int(r + 0.5)
            for yy in range(-ir, ir + 1):
                w = int((r * r - yy * yy) ** 0.5 + 0.5) if r * r >= yy * yy \
                    else -1
                if w >= 0:
                    s.rect(int(cx - w), int(cy + yy), 2 * w + 1, 1, col)
        if size >= 4:                       # bright suns have spikes
            sp = mix(colour, SPACE, 0.4)
            n = int(R * 2.8)
            s.rect(int(cx - n), int(cy), 2 * n + 1, 1, sp)
            s.rect(int(cx), int(cy - n), 1, 2 * n + 1, sp)
    return draw


