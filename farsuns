                len(explored(g.e, sid)), len(STARS)), w - 8), ch(g, 'dim'))
            yy += 31


@grognard.widget('system')
class System(grognard.Widget):
    """The star tapped (or the selected unit's): its sun, its world, its
    natives and its colony, as far as your side knows them."""
    flex = True

    def height(self, g, w):
        return 80

    def lines(self, g):
        e = g.e
        play = g.play
        if play is None:
            return []
        u = play.selected_unit()
        h = u.hex if u is not None else play.cursor
        if h is None or h not in STARS:
            return [('dim', 'Tap a star to see what you know of it.')]
        viewer = g.viewer()
        out = [('accent', e.place(h)),
               ('dim', e.board.terrain(h)['name'])]
        if viewer is not None and hid(h) not in explored(e, viewer):
            out.append(('text', 'Unexplored. Send a ship near it.'))
            return out
        p = world(e, h)
        if p is None:
            out.append(('text', 'No world fit to live on.'))
            return out
        out.append(('text', world_name(p)))
        out.append(('text', 'Up to %d people, ore %d.' % (most(p), ore(p))))
        vis = e.visible(viewer)
        c = colony_at(e, h)
        if c is not None and (c.id in vis or viewer is None):
            out.append(('accent', '%s colony, %d people.' % (
                e.side_name(c.side, 'adj'), c.steps)))
        n = natives_at(e, h)
        if n is not None:
            out.append(('red', '%s, defence %d. Pacify them first.' % (
                n.type['name'], n.defense)))
        elif p.get('natives') and p.get('pacified'):
            out.append(('dim', 'The %s natives are pacified.' %
                        RACES[p['natives']][0].lower()))
        if c is None and n is None and not p.get('home'):
            out.append(('dim', 'Free to settle.'))
        return out

    def draw(self, g, s, r):
        x, y, w, h = r
        panel(g, s, r, 'Star')
        yy = y + 13
        for col, text in self.lines(g):
            for ln in font.wrap(text, w - 8):
                if yy + 9 > y + h:
                    return
                s.text(x + 4, yy, ln, ch(g, col))
                yy += 10


