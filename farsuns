@grognard.pattern('void')
def p_void(t, s):
    """Deep space: black, with faint far stars."""
    c = Canvas(t['colour'])
    c.speckle(mix(t['colour'], t['ink'], 0.3), 0.007, 41)
    c.speckle(mix(t['colour'], t['ink'], 0.75), 0.0015, 43)
    return c


@grognard.pattern('nebula')
def p_nebula(t, s):
    """Glowing dust: soft clouds that wrap round the tile."""
    c = Canvas(t['colour'])
    n = 4                                   # coarse grid of cloud
    cell = TILE // n
    for y in range(TILE):
        for x in range(TILE):
            gx, gy = x / cell, y / cell
            i, j = int(gx), int(gy)
            fx, fy = gx - i, gy - j
            fx, fy = fx * fx * (3 - 2 * fx), fy * fy * (3 - 2 * fy)

            def v(a, b):
                return hsh(a % n, b % n, 5)
            k = (v(i, j) * (1 - fx) + v(i + 1, j) * fx) * (1 - fy) + \
                (v(i, j + 1) * (1 - fx) + v(i + 1, j + 1) * fx) * fy
            k += (hsh(x, y, 9) - 0.5) * 0.12
            c.set(x, y, mix(t['colour'], t['ink'], max(0.0, min(1.0, k))))
    c.speckle(mix(t['colour'], '#ffffff', 0.5), 0.002, 47)
    return c


