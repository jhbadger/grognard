def planets(e):
    return e.flags['planets']


def world(e, h):
    """The world at star h (a dict: kind, natives, pacified, home), or
    None if there's none fit to live on."""
    p = planets(e).get(hid(h))
    return p if p and p.get('kind') else None


def most(p):
    return HOME[1] if p.get('home') else WORLDS[p['kind']][1]


def ore(p):
    return HOME[2] if p.get('home') else WORLDS[p['kind']][2]


def world_name(p):
    return HOME[0] if p.get('home') else WORLDS[p['kind']][0]


def worth(p):
    """What a world is worth having: its people and its ore."""
    return most(p) + 1.5 * ore(p)


def colony_at(e, h):
    for u in e.at(h):
        if u.kind == 'colony':
            return u
    return None


def natives_at(e, h):
    for u in e.at(h):
        if u.side == 'nat':
            return u
    return None


def explored(e, side):
    """The stars side has looked at: {hex id: turn}."""
    return e.flags['explored'].setdefault(side, {})


def explore(e, side, hexes, r):
    ex = explored(e, side)
    for h in hexes:
        for s in STARS:
            if distance(h, s) <= r and hid(s) not in ex:
                ex[hid(s)] = e.turn


def SETUP(e):
    """Deal out the cluster: whose home is where, and what circles every
    other sun."""
    rng = e.rng
    pairs = [(a, b) for a in HOME_SPOTS for b in HOME_SPOTS
             if a != b and distance(a, b) >= HOME_APART]
    homes = dict(zip(ORDER, rng.choice(pairs)))
    e.flags['home'] = {s: hid(h) for s, h in homes.items()}
    e.flags['explored'] = {s: {} for s in ORDER}
    e.flags['built'] = {}
    ps = e.flags['planets'] = {}
    for h in STARS:
        colour = e.board.terrain_name(h)
        if h in homes.values():
            ps[hid(h)] = dict(kind='terran', home=True)
            continue
        k = rng.randrange(100)
        kind = None
        for name, share in CHANCES[colour].items():
            if k < share:
                kind = name
                break
            k -= share
        p = dict(kind=kind)
        if kind and rng.randrange(100) < NATIVE_CHANCE[kind]:
            races = [r for r, spec in RACES.items() if kind in spec[3]]
            p['natives'] = rng.choice(races)
        ps[hid(h)] = p
    # a fair start: each empire's nearest suns hold a free world or two
    for side, home in homes.items():
        near = sorted((s for s in STARS if s not in homes.values()),
                      key=lambda s: (distance(s, home), s))
        for s in near[:2]:
            p = ps[hid(s)]
            if not p.get('kind') or p.get('natives'):
                p.clear()
                p['kind'] = rng.choice(['ocean', 'jungle', 'desert'])
        p = ps[hid(near[2])]           # and one worth fighting for
        if not p.get('kind') or not p.get('natives'):
            p.clear()
            p['kind'] = 'terran'
            p['natives'] = rng.choice(['mammalian', 'avian', 'reptilian'])
    for h in STARS:
        p = ps[hid(h)]
        if p.get('natives'):
            name, d, steps, _, pic = RACES[p['natives']]
            e.spawn(dict(id='nat-' + hid(h), side='nat',
                         type='n_' + p['natives'], name=e.place(h),
                         long='%s natives of %s' % (name, e.place(h)),
                         a=0, d=d, m=0, steps=steps, hex=hid(h)))
    for side, h in homes.items():
        found(e, side, h, 8)
        for kind in ('scout', 'scout', 'colony_ship', 'escort'):
            u = e.spawn(dict(BUILDS[kind]['unit'], side=side, type=kind,
                             hex=hid(h), id='%s-%s%d' % (side, kind,
                                                       e.serial + 1)))
            e.serial += 1
            ON_BUILD(e, u)
        explore(e, side, [h], 1)


def found(e, side, h, pop):
    """A new colony (or the homeworld) at star h."""
    p = world(e, h)
    home = p.get('home')
    e.serial += 1
    u = e.spawn(dict(
        id='col%d' % e.serial, side=side, type='colony', name=e.place(h),
        long=('%s, the %s homeworld' % (e.place(h), e.side_name(side))
              if home else '%s colony (%s)' % (e.place(h),
                                              world_name(p).lower())),
        a=0, d=12 if home else most(p), m=0, steps=most(p), hex=hid(h),
        home=bool(home)))
    u.steps = min(pop, most(p))
    return u


