# ------------------------------------------------------ the computer

class Wyrm(ai.AI):
    """The stock computer player, which also burns things: the Horde's
    dragon breathes once everyone has moved; the Dale's escorts keep
    with the carts, the carts keep with the escorts, and the heroes
    keep with the strongest stack."""

    def begin(self):
        super().begin()
        self.breath_done = False

    def next_move(self):
        act = super().next_move()
        e = self.e
        if act == ('end',) and e.phase == 'move' and not self.breath_done:
            self.breath_done = True
            d = e.units[DRAGON]
            if d.side == self.side and d.alive:
                ts = fire_targets(e, d)
                if ts and fire_value(e, self.side, ts[0],
                                     e.visible(self.side)) >= 0.5:
                    e.flags['aim'] = hid(ts[0])
                    for label, k, why in e.actions(d):
                        if k == 'fire' and not why:
                            return ('act', DRAGON, 'fire')
        return act

    def folk_known(self):
        return [h for x, h in self.enemies() if x.kind in FOLK]

    def score(self, u, h):
        e = self.e
        if u.kind in HEROES:
            return self.hero_score(u, h)
        if self.side == 'dl' and u.kind in FOLK:
            return self.folk_score(u, h)
        s = super().score(u, h)
        if self.side == 'dl':
            if u.attack > 0 and not u.supports and u.max_mp > 0:
                folk = [x.hex for x in e.alive('dl') if x.kind in FOLK
                        and x is not u]
                if folk:
                    d = min(distance(h, f) for f in folk)
                    # a screen a hex or two east of the carts
                    east = any(h[0] >= f[0] and distance(h, f) <= 2
                               for f in folk)
                    s += (3 if east else 0) - max(0, d - 2) * 0.6
            return s
        # the Horde: after the carts
        folk = self.folk_known()
        if folk:
            d = min(distance(h, f) for f in folk)
            if u.id == DRAGON:
                # within breath of them, not in the middle of them
                s += 14 if 1 <= d <= BREATH_RANGE else 10.0 / (1 + d)
            elif u.attack > 0:
                s += 10.0 / (1 + d)
        if u.id == DRAGON:
            b = e.units[BALLISTA]
            if b.alive and distance(h, b.hex) <= b.range:
                s -= 6              # out of the Wyrmbane's reach
        return s

    def folk_score(self, u, h):
        """Refugees: west, all the way, with an escort if there is one,
        and not next to the kobolds."""
        e = self.e
        f = self.field(e.board.hex_list('W'), u.move_class)
        d = f.get(h)
        s = -3.0 * (d if d is not None else 99)
        if any(x.attack > 0 and not x.supports
               for x in e.at(h, u.side) if x is not u):
            s += 1
        if any(n in self.enemy_at for n in neighbours(h)):
            s -= 4
        s -= self.threat.get(h, 0) * 0.05
        if h == u.hex:
            s += 0.3
        return s

    def hero_score(self, u, h):
        e = self.e
        friends = [x for x in e.at(h, u.side) if x is not u and
                   x.attack > 0 and not x.supports and
                   x.kind not in HEROES]
        strength = sum(x.attack for x in friends)
        s = min(strength, 12) * 0.5 if friends else -25 - \
            self.threat.get(h, 0) * 0.1
        if u.id == HUNTER:
            d = e.units[DRAGON]
            if d.alive and d.id in self.memory:
                s -= distance(h, self.memory[d.id]) * 0.5
        known = [k for _, k in self.enemies()]
        dd = min([distance(h, k) for k in known] or [12])
        s += 3 if dd == 1 else -dd * 0.3
        s -= e.board.terrain(h).get('shift', 0)
        if h == u.hex:
            s += 0.3
        return s


