# ------------------------------------------------------------- the fire
# Once a turn, except at night, the dragon breathes fire at a hex up to
# two away.  Every enemy unit there may lose a step, and grass, fields,
# woods and villages catch fire.  A hex on fire can't be entered by
# carts, even along the road, and costs everyone else more; it burns
# until the dragon's next turn and then stays burnt: scorched earth,
# charred woods that hide nobody, villages in ruins.  Fire in a wood
# may spread to the wood next to it.

BREATH_RANGE = 2
BURNS = {'clear': 'scorched', 'fields': 'scorched', 'woods': 'charred',
         'forest': 'charred', 'town': 'ruins'}
SPREADS = ('woods', 'forest')
SPREAD_ON = 6               # a die for each wood next to a fire


def fires(e):
    return e.flags.setdefault('fires', {})


def burning(e, h):
    return e.board.terrain_name(h) == 'burning'


def breathed(e):
    return e.flags.get('breathed') == e.turn


def hit_on(e, u, h):
    """The roll a unit in h needs to save itself from the fire: carts
    and crowds burn on 3 or more, troops on 4, and behind the walls of
    Wardenford on 6."""
    if e.board.terrain_name(h) == 'fort':
        return 6
    return 3 if u.kind in FOLK else 4


def fire_value(e, side, h, seen):
    """What setting h alight is worth to side: the steps it may burn,
    the carts most, and the road or the woods it closes."""
    v = 0.0
    for u in e.at(h):
        if u.side == side:
            return -1
        if u.id not in seen:
            continue
        p = (7 - hit_on(e, u, h)) / 6.0
        v += p * (3.0 if u.kind in FOLK else 4.0 if u.kind in HEROES
                  else 1.0)
    name = e.board.terrain_name(h)
    if name in BURNS:
        v += 0.2
        folk = [u.hex for u in e.alive() if u.side != side and
                u.kind in FOLK and u.id in seen]
        if e.board.has_road(h) and any(
                f[0] > h[0] and distance(f, h) <= 4 for f in folk):
            v += 1.2            # the road ahead of the carts
        if not e.board.terrain(h).get('los', True) and any(
                distance(f, h) <= 1 for f in folk):
            v += 0.4            # cover they might hide in
    return v


def fire_targets(e, u):
    """The hexes the dragon could breathe at, the best first."""
    seen = e.visible(u.side)
    out = []
    for h in within(u.hex, BREATH_RANGE):
        if h == u.hex or not e.board.on_map(h) or burning(e, h):
            continue
        v = fire_value(e, u.side, h, seen)
        if v < 0:
            continue
        if v == 0 and e.board.terrain_name(h) not in BURNS:
            continue            # nothing there to burn
        out.append((v, h))
    out.sort(key=lambda x: (-x[0], x[1]))
    return [h for v, h in out]


def aimed(e, u, ts):
    want = e.flags.get('aim')
    for h in ts:
        if hid(h) == want:
            return h
    return ts[0] if ts else None


def what_at(e, h, side):
    seen = e.visible(side)
    n = len([x for x in e.at(h) if x.side != side and x.id in seen])
    t = e.board.T[e.board.terrain_name(h)]['name'].lower()
    return '%s, %s' % (t, '%d unit%s' % (n, '' if n == 1 else 's')
                       if n else 'empty')


def ACTIONS(e, u):
    if u.id != DRAGON or e.phase != 'move':
        return []
    ts = fire_targets(e, u)
    h = aimed(e, u, ts)
    why = None
    if e.weather()['id'] == 'night':
        why = 'the wyrm roosts at night'
    elif breathed(e):
        why = 'has breathed fire this turn'
    elif h is None:
        why = 'nothing in reach to burn'
    return [('At: %s' % e.place(h) if h else 'No target', 'aim',
             None if len(ts) > 1 else 'nothing else in reach' if ts else
             'nothing within %d hexes will burn' % BREATH_RANGE),
            ('Breathe fire', 'fire', why)]


def ACT(e, u, key):
    ts = fire_targets(e, u)
    h = aimed(e, u, ts)
    if key == 'aim':
        h = ts[(ts.index(h) + 1) % len(ts)]
        e.flags['aim'] = hid(h)
        e.say('Ashkarr turns its head toward %s (%s).' % (
            e.place(h), what_at(e, h, u.side)), u.side)
        return
    breathe(e, u, h)


def breathe(e, u, h):
    e.flags['breathed'] = e.turn
    e.flags.pop('aim', None)
    e.events.append(('sound', 'roar'))
    e.events.append(('popup', h, 'Fire!', '#ffb040'))
    hurt = []
    for t in [x for x in e.at(h) if x.side != u.side]:
        t.seen = True
        roll = e.rng.randint(1, 6)
        if roll >= hit_on(e, t, h):
            hurt.append(t)
    name = e.board.terrain_name(h)
    alight = name in BURNS
    e.say('Ashkarr breathes fire on %s%s.' % (
        e.place(h), ': it catches' if alight else ''))
    for t in hurt:
        if t.alive:
            e.say('%s %s.' % (t.long, 'burns' if t.kind in FOLK else
                              'is caught in the flames'))
            e.take_losses([t], 1)
    if alight:
        ignite(e, h)
    e.changed()


def ignite(e, h):
    fires(e)[hid(h)] = BURNS[e.board.terrain_name(h)]
    e.bonus['dr'] += BURN_VP
    e.alter(h, 'burning')


def burn_out(e):
    """The fires of the last turn die down, and may spread through the
    woods first."""
    fs = fires(e)
    if not fs:
        return
    spread = []
    for k, after in sorted(fs.items()):
        h = parse(k)
        if after == 'charred':
            for n in neighbours(h):
                if e.board.terrain_name(n) in SPREADS and n not in spread \
                        and e.rng.randint(1, 6) >= SPREAD_ON:
                    spread.append(n)
    for k, after in sorted(fs.items()):
        e.alter(parse(k), after)
    e.flags['fires'] = {}
    for n in spread:
        ignite(e, n)
        e.say('The fire spreads through the woods to %s.' % e.place(n))
        e.events.append(('popup', n, 'spreads', '#ffb040'))


def ENTER_COST(e, unit, a, b, c):
    """Wings ignore the ground; fire stops carts, even on the road, and
    slows everyone else."""
    mc = getattr(unit, 'move_class', None)
    if mc == 'fly':
        return 1
    if e.board.terrain_name(b) == 'burning':
        if mc == 'wheel':
            return None
        return c + 2
    return c


# ----------------------------------------------------------- the turns

def ON_TURN(e, side):
    if side == 'dr':
        burn_out(e)
        if lantern_home(e) and not e.flags.get('lantern_scored'):
            e.flags['lantern_scored'] = True
            e.bonus['dl'] += LANTERN_VP
            e.say('The Lantern of Hollin is over the Lenn (%d VP more).'
                  % LANTERN_VP)
    if e.turn == 1:
        if side == 'dl':
            e.say('The carts are loaded. Margravine Isolde rides along '
                  'the column: west, to Wardenford, and do not stop.')
        else:
            e.say('A roar rolls down from the Cinder Peaks. Ashkarr is '
                  'awake, and hungry.')
    if e.turn == 2 and side == 'dr':
        e.say('The Cinder-sworn, the wyrm\'s fanatics, come over the '
              'peaks behind the kobolds.')
    if side == 'dr' and e.weather()['id'] == 'night' and \
            e.weather(e.turn - 1)['id'] != 'night':
        e.say('Night: Ashkarr settles on a hill to sleep, and the fires '
              'light the dale.')


def ON_ELIMINATE(e, u, where):
    if u.id == DRAGON:
        e.flags['dragon_dead'] = e.turn
        e.say('Ashkarr the Ember Wyrm is dead! The kobolds wail and '
              'falter.')
        for x in [x for x in e.alive('dr') if x.type.get('kobold')]:
            e.take_losses([x], 1)


def lead(e, side, hexes):
    """The heroes of side in hexes: the column shift they give, at most
    2, and their names."""
    hs = [u for u in e.alive(side) if u.kind in HEROES and u.hex in hexes]
    n = min(2, sum(u.spec.get('lead', 0) for u in hs))
    return n, ', '.join(u.name.title() for u in hs)


def COMBAT_SHIFTS(e, target, attackers, support):
    """Heroes lead.  The Wyrmbane and Hallam are good against the
    dragon, and the dragon is terrible to face, unless Hallam is there."""
    out = []
    me, them = e.side, e.enemy(e.side)
    there = e.at(target, them)
    dragon_there = any(u.id == DRAGON for u in there)
    if attackers:
        n, names = lead(e, me, {u.hex for u in attackers})
        if n:
            out.append((n, names))
        if dragon_there:
            if any(u.id == BALLISTA for u in support):
                out.append((2, 'the Wyrmbane'))
            h = e.units.get(HUNTER)
            if h and h.alive and h.hex in {u.hex for u in attackers}:
                out.append((1, "Hallam's spear"))
        if any(u.id == DRAGON for u in attackers):
            h = e.units.get(HUNTER)
            if not (h and h.alive and h.hex == target):
                out.append((1, 'dragonfear'))
    n, names = lead(e, them, {target})
    if n:
        out.append((-n, names))
    return out


# ---------------------------------------------------------------- winning

def _score(e):
    return 'Dalesfolk %d VP, Horde %d.' % (e.vp('dl'), e.vp('dr'))


def lantern_home(e):
    return e.units[LANTERN].status == 'exited'


def tally(e):
    """What became of the dale's people."""
    folk = [u for u in e.units.values() if u.kind == 'folk']
    safe = sum(u.steps for u in folk if u.status == 'exited')
    total = sum(u.max_steps for u in folk)
    lines = ['%d of %d wagonloads of refugees got across the Lenn.' % (
        safe, total)]
    lt = e.units[LANTERN]
    if lt.status == 'exited':
        lines.append('The Lantern of Hollin burns in a new temple in the '
                     'west.')
    elif lt.status == 'dead':
        lines.append('The Lantern of Hollin is lost, and the kobolds '
                     'have put it on their altar.')
    else:
        lines.append('The Lantern of Hollin is still on the wrong side '
                     'of the river.')
    if e.flags.get('dragon_dead'):
        lines.append('Ashkarr the Ember Wyrm is dead, and Hallam is '
                     'insufferable about it.')
    else:
        lines.append('Ashkarr sleeps on the ashes of the dale.')
    return ' '.join(lines)


def VICTORY(e):
    """The margin decides: the Dalesfolk score the refugees they get
    across, the Lantern, the places still theirs and the Horde's steps
    lost, and 12 for the dragon; the Horde the Dale's steps lost, carts
    and the Lantern destroyed, the hexes it burnt and the places it
    took.  The Horde wins if the margin is MARGIN or better: being no
    more than 8 behind is enough (set from ./emberroad --simulate 60)."""
    m = e.vp('dr') - e.vp('dl')
    if m >= MARGIN + 10:
        w, t = 'dr', 'Horde victory. The dale is ash, and few escaped it.'
    elif m >= MARGIN:
        w, t = 'dr', ('Horde marginal victory. Some of the dale got away, '
                      'but the wyrm has its feast.')
    elif m > MARGIN - 10:
        w, t = 'dl', ('Dale marginal victory. The dale is lost, but its '
                      'people are not.')
    else:
        w, t = 'dl', 'Dale victory. The road to the west was held.'
    return w, '%s %s %s' % (t, _score(e), tally(e))


def ON_END_TURN(e):
    if e.control.get(parse(FORT)) == 'dr':
        e.finish('dr', 'Horde victory: Wardenford has fallen and the '
                 'bridge is the wyrm\'s. Nobody else crosses the Lenn. '
                 '%s %s' % (_score(e), tally(e)))


