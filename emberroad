@grognard.icon('emberroad')
def draw_icon(p, n):
    """A red dragon over a road running west into the flames."""
    p.fill('#5a1e10')
    p.disc(n * 0.5, n * 1.35, n * 0.75, '#2a1a12')          # the dale
    for i in range(int(n * 0.5)):                           # the road
        t = i / (n * 0.5)
        w = n * (0.04 + 0.2 * t)
        p.rect(n * 0.5 - w / 2, n * 0.6 + i, w, 1, '#c8a878')
    for x, h in ((0.12, 0.2), (0.22, 0.28), (0.3, 0.18), (0.72, 0.24),
                 (0.82, 0.3), (0.9, 0.2)):                  # flames
        p.disc(n * x, n * (0.78 - h / 2), n * 0.06, '#f08020')
        p.disc(n * x, n * (0.82 - h / 3), n * 0.05, '#ffd040')
    # the dragon: body, neck, head, wings, tail
    k = '#e04018'
    p.line(n * 0.32, n * 0.36, n * 0.62, n * 0.32, k, max(2, n // 12))
    p.line(n * 0.62, n * 0.32, n * 0.74, n * 0.2, k, max(2, n // 18))
    p.disc(n * 0.77, n * 0.18, n * 0.05, k)
    p.line(n * 0.32, n * 0.36, n * 0.14, n * 0.44, k, max(1, n // 24))
    for x0 in (0.4, 0.5):
        p.line(n * x0, n * 0.34, n * (x0 - 0.14), n * 0.08, k,
               max(1, n // 24))
        p.line(n * (x0 - 0.14), n * 0.08, n * (x0 + 0.1), n * 0.33, k,
               max(1, n // 24))
    p.disc(n * 0.79, n * 0.17, max(1, n * 0.012), '#ffe060')


