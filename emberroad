@grognard.pattern('flames')
def p_flames(t, s):
    """Tongues of flame over embers."""
    c = Canvas(t['colour'])
    ink = rgb(t['ink'])
    hot = mix(t['ink'], '#ffffff', 0.5)
    dark = mix(t['colour'], '#000000', 0.35)
    c.speckle(dark, 0.12, 21)
    for x, y, k in jitter_points(max(6, int(10 * s)), 23, 0.5):
        h = int((4 + 4 * k) * s)
        for j in range(h):
            half = (h - j) * 0.35
            for i in range(-int(half), int(half) + 1):
                c.set(x + i, y - j, hot if abs(i) < half * 0.4 and
                      j < h * 0.6 else ink)
    return c


@grognard.pattern('stumps')
def p_stumps(t, s):
    """Black stumps standing in ash."""
    c = Canvas(t['colour'])
    ink = rgb(t['ink'])
    ash = mix(t['colour'], '#ffffff', 0.18)
    c.speckle(ash, 0.08, 31)
    for x, y, k in jitter_points(max(6, int(9 * s)), 33, 0.45):
        h = int((2 + 3 * k) * s) + 1
        for j in range(h):
            c.set(x, y - j, ink)
            if s > 1.2:
                c.set(x + 1, y - j, ink)
        if k > 0.5:
            c.set(x - 1, y - h + 1, ink)
    return c


