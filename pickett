def brigade(uid, side, a, d, hx, formation, colour, long, steps=3, **kw):
    """An infantry brigade: attack, defence, and the hex it starts in
    (None if it arrives later, with arrive and at)."""
    spec = dict(id=uid, name=kw.pop('name', uid.upper()), side=side,
                type='infantry', size='X', a=a, d=d, m=3, steps=steps,
                hex=hx, formation=formation, colour=colour, long=long)
    if side == 'cs':
        spec['release'] = RELEASE
    spec.update(kw)
    return spec


def guns(uid, side, a, rng, hx, formation, colour, long, m=2, **kw):
    """Artillery: attack, range and the hex it starts in."""
    spec = dict(id=uid, name=kw.pop('name', uid.upper()), side=side,
                type='artillery', size='II', a=a, d=3, m=m, range=rng,
                steps=1, hex=hx, formation=formation, colour=colour,
                long=long)
    spec.update(kw)
    return spec


