RELEASE = 3


def ON_TURN(e, side):
    """After the cannonade the Confederate guns are short of ammunition
    (the reserve train had been moved away): from the infantry's release
    on, each battery fires only every other turn."""
    if side == 'cs' and e.turn >= RELEASE:
        for u in e.alive('cs'):
            if u.supports and (e.turn + len(u.id)) % 2:
                u.fired = True


def COMBAT_SHIFTS(e, target, attackers, support):
    """Guns firing canister at close range: attacking a hex with a
    battery in it costs a column.  A bombardment loses a column beyond 3
    hexes (some 400 yards: shell, not canister), and three beyond 6 (much
    of the cannonade went over the ridge)."""
    out = []
    if any(u.supports for u in e.at(target) if u.side != e.side) and \
            any(hexgrid.distance(u.hex, target) == 1 for u in attackers):
        out.append((-1, 'canister'))
    if not attackers and support:
        d = min(hexgrid.distance(u.hex, target) for u in support)
        if d > 6:
            out.append((-3, 'long range'))
        elif d > 3:
            out.append((-1, 'medium range'))
    return out


