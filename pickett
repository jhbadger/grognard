def _fences():
    """Post-and-rail fences line the Emmitsburg Road: every side of a road
    hex facing east, except where the road itself runs on."""
    road = [hexgrid.parse(EMMITSBURG[0])]
    road += hexgrid.line(road[0], hexgrid.parse(EMMITSBURG[1]))[1:]
    out = []
    for h in road:
        for d in (1, 2):                                # NE and SE
            n = hexgrid.neighbour(h, d)
            if n not in road and 0 <= n[0] < 18 and 0 <= n[1] < 14:
                out.append((h, n))
    return out


