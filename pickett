@grognard.icon('pickett')
def draw_icon(p, n):
    """The copse of trees on the ridge, behind the stone wall."""
    p.fill('#cfd8e0')
    p.rect(0, n * 0.62, n, n * 0.38, '#a9b86a')
    p.disc(n * 0.5, n * 0.95, n * 0.55, '#b0b47a')
    for x, y, r in ((0.38, 0.45, 0.15), (0.55, 0.38, 0.18),
                    (0.68, 0.48, 0.13), (0.47, 0.52, 0.14)):
        p.disc(n * x, n * y, n * r, '#2f5222')
    p.rect(0, n * 0.7, n, n * 0.07, '#a8a498')
    for k in range(8):
        p.rect(n * k / 8, n * 0.7, 1, n * 0.07, '#6a6658')
    p.rect(n * 0.12, n * 0.18, n * 0.02, n * 0.5, '#3a2a1a')
    p.rect(n * 0.14, n * 0.18, n * 0.16, n * 0.1, '#b02020')


