def TURN_NAME(t):
    """Fifteen minutes a turn, from two o'clock."""
    m = 14 * 60 + (t - 1) * 15
    return ('3 Jul 1863', '%d:%02d PM' % ((m // 60 - 1) % 12 + 1, m % 60))


