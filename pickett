def VICTORY(e):
    """The Confederates score the ground they hold and Union losses, the
    Federals Confederate losses, and the margin decides: the attackers
    must come out 5 VP ahead (set from games between computer players:
    ./pickett --simulate 30)."""
    cs, us = e.vp('cs'), e.vp('us')
    m = cs - us
    score = 'Confederates %d VP, Federals %d.' % (cs, us)
    if m >= 12:
        return 'cs', 'Confederate victory. %s The Union centre is broken.' \
            % score
    if m >= 5:
        return 'cs', 'Confederate marginal victory. %s' % score
    if m > -5:
        return 'us', ('Union marginal victory. %s The ridge holds, at a '
                      'price.' % score)
    return 'us', ('Union victory. %s The high water mark: the charge '
                  'breaks against the wall, and Lee says "It is all my '
                  'fault."' % score)


