@grognard.icon('cowpens')
def draw_icon(p, n):
    """A blue line on a low rise under a winter sky, and smoke."""
    p.fill('#d4dce4')
    p.disc(n * 0.5, n * 1.5, n * 0.95, '#b4b47a')
    p.rect(0, n * 0.82, n, n * 0.18, '#94945a')
    for k in range(5):
        x = n * (0.16 + k * 0.17)
        p.rect(x - n * 0.04, n * 0.5, n * 0.08, n * 0.16, '#2e4a86')
        p.disc(x, n * 0.47, n * 0.04, '#e8d8b0')
        p.disc(x + n * 0.06, n * 0.4, n * 0.06, '#f4f4f0')
    p.line(n * 0.08, n * 0.2, n * 0.08, n * 0.55, '#4a3420',
           max(1, n // 48))
    p.rect(n * 0.08, n * 0.2, n * 0.18, n * 0.12, '#2e4a86')
    for k in range(13):
        p.rect(n * (0.09 + (k % 4) * 0.04), n * (0.21 + (k // 4) * 0.03),
               n * 0.015, n * 0.015, '#f4f4f0')


