def TURN_NAME(t):
    """Ten minutes a turn, from seven in the morning (no AM, which
    wouldn't fit on the calendar)."""
    m = 7 * 60 + (t - 1) * 10
    return ('17 Jan 1781', '%d:%02d' % (m // 60, m % 60))


