class Morgan(ai.AI):
    """The stock computer player, taught Morgan's plan: a skirmisher
    with no volleys left goes back to Morgan to load, the Continentals
    keep the rise, and the horse waits until the British are worn out;
    the British go straight at the rise."""

    def score(self, u, h):
        s = super().score(u, h)
        e = self.e
        if self.side == 'am':
            morgan = e.units.get('morgan')
            if u.type.get('volleys') and morgan and morgan.alive and \
                    volleys_left(e, u) == 0:
                s -= max(0, hexgrid.distance(h, morgan.hex) - 1) * 4
            elif u.kind == 'line' and e.turn < TURN_ABOUT:
                start = hexgrid.parse(u.spec['hex'])
                s -= hexgrid.distance(h, start) * 3
            elif u.kind == 'dragoons' and e.turn < WORN:
                s -= hexgrid.distance(h, HIDE) * 4
            elif u.id == 'morgan':
                s -= hexgrid.distance(h, POST) * 6
        elif u.kind != 'gun' and u.kind != 'hq':
            s -= hexgrid.distance(h, RISE) * 1.2
            if any(e.at(n, 'am') for n in hexgrid.neighbours(h)):
                s += 7
        return s


