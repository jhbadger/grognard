def _score(e):
    return 'British %d VP, Americans %d.' % (e.vp('br'), e.vp('am'))


def VICTORY(e):
    """The British score the rise (6) and Morgan's post (3) if they
    hold them at the end, every American step, and Morgan (4); the
    Americans every British step, Tarleton (4) and each gun (2).  The
    British must finish THRESHOLD ahead (set from games between computer
    players: ./cowpens --simulate 60)."""
    m = e.vp('br') - e.vp('am')
    if m >= THRESHOLD + 8:
        return 'br', ('British victory. %s Morgan\'s army is destroyed '
                      'and the back country is quiet.' % _score(e))
    if m >= THRESHOLD:
        return 'br', ('British marginal victory. %s Morgan gets away over '
                      'the Broad River with what he can save.' % _score(e))
    if m > THRESHOLD - 8:
        return 'am', ('American marginal victory. %s Tarleton draws off, '
                      'and Morgan marches north with his prisoners.'
                      % _score(e))
    return 'am', ('American victory. %s Tarleton\'s army is caught '
                  'between the Continentals and the horse and taken '
                  'almost to a man.' % _score(e))


