# --------------------------------------------------------- the volleys

def _volleys(e):
    return e.flags.setdefault('volleys', {})


def volleys_left(e, u):
    """Volleys a skirmisher has left now: what it had at the start of
    the American turn, less any it has fired since (in its own turn, or
    into a British attack)."""
    n = _volleys(e).get(u.id, VOLLEYS)
    if e.side == 'br':
        n -= int(u.fired) + int(u.dfired)
    else:
        n -= int(u.fired)
    return max(0, n)


def CAN_SUPPORT(e, u):
    """Riflemen and militia fire only while they have volleys left."""
    if not u.type.get('volleys'):
        return True
    return volleys_left(e, u) > 0


def ON_TURN(e, side):
    """The volleys: at the start of the American turn each skirmisher
    pays for what it fired, and those that have fallen back near Morgan,
    out of reach of the British, load again."""
    if side == 'am':
        v = _volleys(e)
        morgan = e.units.get('morgan')
        foes = [x.hex for x in e.alive('br')]
        rallied = 0
        for u in e.alive('am'):
            if not u.type.get('volleys'):
                continue
            n = v.get(u.id, VOLLEYS) - int(u.fired) - int(u.dfired)
            if morgan and morgan.alive and \
                    hexgrid.distance(u.hex, morgan.hex) <= RALLY and \
                    all(hexgrid.distance(u.hex, f) > 1 for f in foes):
                if n < VOLLEYS:
                    rallied += 1
                n = VOLLEYS
            v[u.id] = max(0, n)
        if e.turn == 1:
            e.say('"Two volleys, boys, at the men with the epaulettes!"')
        elif rallied:
            e.say('Morgan rides among the militia: %d compan%s load and '
                  'form again.' % (rallied, 'ies' if rallied > 1 else 'y'))
    else:
        if e.turn == 1:
            e.say('Tarleton forms his line across the road and the '
                  'drums beat the advance.')
        elif e.turn == WORN:
            e.say('The British have marched since three in the morning. '
                  'They are worn out.')


def ON_ELIMINATE(e, u, where):
    """Leaders and guns."""
    if u.id == 'tarleton':
        e.say('Tarleton is down! The Legion scatters.')
    elif u.id == 'morgan':
        e.flags['morgan'] = True
        e.say('Morgan has fallen! The militia lose heart.')
    elif u.kind == 'gun':
        e.say('A grasshopper is taken, its gunners dead around it.')


def COMBAT_SHIFTS(e, target, attackers, support):
    """Fatigue and the trap:
    - from WORN on, the British attack a column worse (the night march);
    - an American attack made from three hexes or more gains a column
      (surrounded);
    - with Morgan dead the Americans attack a column worse."""
    out = []
    if e.side == 'br':
        if attackers and e.turn >= WORN:
            out.append((-1, 'worn out'))
    else:
        if len({u.hex for u in attackers}) >= 3:
            out.append((1, 'surrounded'))
        if e.flags.get('morgan'):
            out.append((-1, 'Morgan is down'))
    return out


