# Each side's steps; half of them gone and it gives up the fight.
BREAK = 0.5


def _steps(e, side):
    return sum(u.max_steps for u in e.units.values() if u.side == side
               and u.attack_full > 0 and u.id != 'lyon')


def ON_TURN(e, side):
    """Breaking: at the start of the Proprietary turn, if Stone's force
    has lost half its steps, or Stone himself is down, he orders his men
    to lay down their arms.  At the start of the Puritans' turn, if they
    have lost half theirs, Fuller falls back on Providence."""
    if side == 'md':
        if e.lost['md'] >= _steps(e, 'md') * BREAK or \
                e.units['stone'].status == 'dead':
            e.finish('pu', 'Puritan victory. %s Stone orders his men to lay '
                     'down their arms; some escape into the woods, the rest '
                     'are marched to Providence as prisoners.' % _score(e))
    elif e.turn > 1 and e.lost['pu'] >= _steps(e, 'pu') * BREAK:
        e.finish('md', 'Proprietary victory. %s Fuller falls back on '
                 "Providence, and the Puritans must treat with Lord "
                 "Baltimore's governor." % _score(e))


def COMBAT_SHIFTS(e, target, attackers, support):
    """The Puritan volley was far more effective: Puritan foot attacking
    from the next hex gain a column.  The Piscataway fight from cover:
    attacking a hex of woods where they stand costs a column more."""
    out = []
    if e.side == 'pu' and any(u.kind == 'foot' and
                              hexgrid.distance(u.hex, target) == 1
                              for u in attackers):
        out.append((1, 'volley'))
    if e.board.hexes.get(target) == 'woods' and \
            any(u.kind == 'native' for u in e.at(target)):
        out.append((-1, 'Piscataway'))
    if target == SHIP:
        out.append((-1, 'from the shore'))
    return out


