def TURN_NAME(t):
    """A quarter of an hour a turn, from eight in the morning (the
    sources say only that Fuller marched out in the morning)."""
    m = 8 * 60 + (t - 1) * 15
    return ('25 Mar 1655', '%d:%02d AM' % (m // 60, m % 60))


