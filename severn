@grognard.symbol('ship')
def s_ship(p, x, y, w, h, c):
    """A merchantman: a hull and three masts."""
    base = y + h - 3
    p.rect(x + 1, base, w - 2, 1, c)
    p.rect(x + 2, base + 1, w - 4, 1, c)
    sw = max(1, w // 9)
    for k in (0.28, 0.5, 0.72):
        mx = int(x + (w - 1) * k)
        p.rect(mx, y + 1, 1, base - y - 1, c)
        p.rect(mx - sw, y + 2, 2 * sw + 1, max(1, (base - y - 3) // 2), c)


