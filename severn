def _score(e):
    return 'Proprietary %d VP, Puritans %d.' % (e.vp('md'), e.vp('pu'))


def VICTORY(e):
    """If neither side has broken by the end of the morning, the score
    decides: the Proprietary side scores the clearing, 1 for each step
    that gets past to Providence, 4 for the Golden Lyon burnt and the
    Puritan steps destroyed; the Puritans the boats, 3 for Stone and
    Stone's steps.  Ties go to the Puritans, who hold the colony."""
    md, pu = e.vp('md'), e.vp('pu')
    if md > pu:
        return 'md', ('Proprietary marginal victory. %s Fuller pulls back '
                      'to Providence, and Stone is still in the field.'
                      % _score(e))
    return 'pu', ('Puritan marginal victory. %s Stone falls back to his '
                  'boats, and the Puritans keep the colony.' % _score(e))


