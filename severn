def company(uid, side, a, d, hx, long, colour, formation, m=3, **kw):
    spec = dict(id=uid, name=kw.pop('name', uid.upper()), side=side,
                type=kw.pop('type', 'foot'), size=kw.pop('size', 'I'),
                a=a, d=d, m=m, steps=kw.pop('steps', 2), hex=hx,
                long=long, colour=colour, formation=formation)
    spec.update(kw)
    return spec


