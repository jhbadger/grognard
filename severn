@grognard.icon('severn')
def draw_icon(p, n):
    """Baltimore's black and yellow over the river, and the English
    cross on the shore."""
    p.fill('#9ab8d0')
    p.rect(0, n * 0.62, n, n * 0.38, '#3e6a94')
    p.rect(0, n * 0.55, n, n * 0.1, '#4a6e3a')
    p.rect(n * 0.18, n * 0.12, n * 0.03, n * 0.5, '#3a2a1a')
    for i in range(4):
        for j in range(2):
            c = '#e0b830' if (i + j) % 2 else '#1a1a1a'
            p.rect(n * (0.21 + i * 0.07), n * (0.12 + j * 0.1),
                   n * 0.07, n * 0.1, c)
    p.rect(n * 0.68, n * 0.2, n * 0.03, n * 0.42, '#3a2a1a')
    p.rect(n * 0.71, n * 0.2, n * 0.24, n * 0.16, '#f4f0e8')
    p.rect(n * 0.81, n * 0.2, n * 0.04, n * 0.16, '#c02020')
    p.rect(n * 0.71, n * 0.26, n * 0.24, n * 0.04, '#c02020')


