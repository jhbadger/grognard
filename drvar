def _score(e):
    return 'Germans %d VP, Partisans %d.' % (e.vp('de'), e.vp('nj'))


def VICTORY(e):
    """Tito dead is a German victory at once (ON_TURN).  Otherwise the
    margin decides: the Germans score the steps they destroy and the
    places they hold; the Partisans the steps they destroy, the places,
    and Tito's escape (set from ./drvar --simulate 60)."""
    de, nj = e.vp('de'), e.vp('nj')
    m = de - nj
    escaped = e.exited.get('nj')
    away = ' Tito is safe in the mountains.' if escaped else \
        ' Tito is still hiding in the valley.'
    if m >= MARGIN + 6:
        return 'de', ('German victory. %s%s The paratroopers hold Drvar '
                      'until the columns come.' % (_score(e), away))
    if m >= MARGIN:
        return 'de', ('German marginal victory. %s%s' % (_score(e), away))
    if m > MARGIN - 8:
        return 'nj', ('Partisan marginal victory. %s%s The paratroopers '
                      'are relieved, but Drvar cost them dear.'
                      % (_score(e), away))
    return 'nj', ('Partisan victory. %s%s The 500th SS Parachute '
                  'Battalion is all but destroyed, and the Knight\'s '
                  'Move has failed.' % (_score(e), away))



