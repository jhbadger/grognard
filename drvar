def ON_TURN(e, side):
    """What happened in the valley, and Tito taken."""
    if e.flags.get('tito'):
        e.finish('de', 'German victory. Tito is dead. The Partisan '
                 'movement has lost its leader on his birthday, and '
                 'the 500th SS Parachute Battalion its stain. %s'
                 % _score(e))
        return
    if side == 'de':
        if e.turn == 1:
            e.say("Hauptsturmführer Rybka's men gather by the gliders. "
                  'Somewhere in this town is Tito.')
        if e.turn == SECOND:
            e.say('Noon: the second wave drops into the valley, '
                  'straight into Partisan fire.')
        if e.turn == NIGHT:
            e.say('Darkness. The paratroopers are out of ammunition '
                  'and the Luftwaffe cannot find them.')
    else:
        if e.turn == 1:
            e.say("Tito's escort holds the mouth of the cave. Below it "
                  'the paratroopers are in the streets.')
        if e.turn == ESCAPE:
            e.say('The escort has cut a hole in the floor of the cave. '
                  'Tito climbs down a rope to the stream bed below.')
        if e.turn == RELIEF:
            e.say('Dawn. The German column from Bihać is in the '
                  'valley.')


def ON_ELIMINATE(e, u, where):
    if u.id == TITO:
        e.flags['tito'] = True
        e.say('Tito is dead!')


def COMBAT_SHIFTS(e, target, attackers, support):
    """At dusk and night the Partisans, who know every path, gain a
    column attacking, and the Germans lose one."""
    out = []
    if attackers and e.weather()['id'] in ('dusk', 'night'):
        out.append((1, 'knowing the ground') if e.side == 'nj' else
                   (-1, 'darkness'))
    return out


