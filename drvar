def u(uid, side, a, d, hx, formation, colour, long, **kw):
    spec = dict(id=uid, name=kw.pop('name', uid.upper()), side=side,
                type=kw.pop('type', 'para' if side == 'de' else
                            'partisan'),
                size=kw.pop('size', 'I'), a=a, d=d, m=kw.pop('m', 4),
                steps=kw.pop('steps', 2), hex=hx, formation=formation,
                colour=colour, long=long)
    spec.update(kw)
    return spec


