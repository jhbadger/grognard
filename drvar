@grognard.icon('drvar')
def draw_icon(p, n):
    """Parachutes over a mountain valley, and a red star."""
    p.fill('#9ec4e0')
    p.disc(n * 0.15, n * 1.0, n * 0.55, '#34603a')
    p.disc(n * 0.9, n * 1.05, n * 0.6, '#2c5432')
    p.rect(0, n * 0.82, n, n * 0.18, '#94b866')
    for x, y in ((0.3, 0.22), (0.6, 0.14), (0.74, 0.42), (0.44, 0.5)):
        p.disc(n * x, n * y, n * 0.1, '#e8e4d8')
        p.rect(n * (x - 0.1), n * y, n * 0.2, n * 0.05, '#9ec4e0')
        p.line(n * (x - 0.09), n * y, n * x, n * (y + 0.14), '#4a4a40')
        p.line(n * (x + 0.09), n * y, n * x, n * (y + 0.14), '#4a4a40')
        p.rect(n * (x - 0.02), n * (y + 0.13), n * 0.04, n * 0.05,
               '#5a5e48')
    p.disc(n * 0.5, n * 0.88, n * 0.07, '#c02a22')


