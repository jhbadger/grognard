DUSK = 19               # on turn 1 every column from this one is dark
SUN_SPOT = 5            # how far a unit in the sunlight is seen


def dusk(turn):
    """The westernmost dark column on a turn: it moves a column a turn."""
    return DUSK - (turn - 1)


def dark(e, h, turn=None):
    """Whether hex h is on the night side."""
    return h is not None and h[0] >= dusk(turn or e.turn)


def SPOT(e, spotter, u, spot):
    """In the dark a unit is seen only from next door; in the sunlight
    from SUN_SPOT hexes, unless it stands among boulders or rims."""
    if dark(e, u.hex):
        return 1
    return max(spot, SUN_SPOT)


def COMBAT_SHIFTS(e, target, attackers, support):
    """A target standing in the sunlight is a column easier to hit: no
    shadow to hide in, and every shot aimed."""
    if not dark(e, target):
        return [(1, 'in the sun')]
    return []


def ON_TURN(e, side):
    """The dusk moves west at the start of each turn."""
    e.changed()                     # what's seen has changed with the light
    if side != 'cc':
        return
    if e.turn == 1:
        e.say('Dusk on Tarn. The Concord landing force is down on the '
              'night side, east of Kell Dome, and the dark is moving '
              'west at walking pace.')
        return
    col = dusk(e.turn)
    for h, o in sorted(e.board.objectives.items()):
        if h[0] == col:
            e.say('The dusk reaches %s. Its lights go out one by one.'
                  % o['name'])
            return
    e.say('The terminator moves west, to column %d.' % (col + 1))


def ON_ELIMINATE(e, u, where):
    if u.id == 'driver':
        e.say('The mass driver\'s guard is gone.')


