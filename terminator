@grognard.pattern('regolith')
def p_regolith(t, s):
    """Grey dust pocked with small craters."""
    c = Canvas(t['colour'])
    c.speckle(t['ink'], 0.10, 3)
    c.speckle(t['edge'], 0.03, 5)
    ink, lit = rgb(t['ink']), rgb('#c8c4b8')
    for i, (x, y, r) in enumerate([(20, 30, 4), (70, 12, 3), (55, 66, 5),
                                   (12, 80, 3), (84, 52, 2)]):
        c.disc(x, y, r, lambda dx, dy: lit if dx * dx + dy * dy > 0.6 and
               dx + dy > 0 else ink if dx * dx + dy * dy > 0.5 else None)
    return c


@grognard.icon('terminator')
def draw_icon(p, n):
    """A crater on the terminator: day on the left, night on the right,
    and a crawler in the shadow."""
    p.fill('#0c1430')
    p.rect(0, 0, n * 0.5, n, '#b8b4a8')
    p.disc(n * 0.5, n * 0.5, n * 0.32, '#6a665c')
    p.rect(n * 0.5, 0, n * 0.5, n, '#0c1430')
    p.disc(n * 0.5, n * 0.5, n * 0.24, '#8a867a')
    p.rect(n * 0.5, n * 0.18, n * 0.5, n * 0.64, '#0c1430')
    for k in range(8):
        p.rect(n * 0.5, n * k / 8, max(1, n // 32), n / 16, '#f0d890')
    p.rect(n * 0.62, n * 0.62, n * 0.28, n * 0.1, '#a8c0dc')
    p.rect(n * 0.68, n * 0.55, n * 0.14, n * 0.08, '#a8c0dc')
    p.line(n * 0.75, n * 0.58, n * 0.56, n * 0.54, '#a8c0dc',
           max(1, n // 32))


