@grognard.symbol('jump')
def s_jump(p, x, y, w, h, c):
    """Jump troops: the infantry cross under an arc of a jump."""
    counters.SYMBOLS['infantry'](p, x, y, w, h, c)
    import math
    cx, r = x + (w - 1) / 2, max(2, w / 3)
    for i in range(13):
        a = math.pi * (1 + i / 12)
        p.set(cx + r * math.cos(a), y + h / 2 + r * 0.6 * math.sin(a) - 1, c)


@grognard.symbol('laser')
def s_laser(p, x, y, w, h, c):
    """A mining laser: a beam out of a lens."""
    p.oval(x + w // 4, y + (h - 1) / 2, max(1, w / 8), max(1, h / 4), c)
    p.line(x + w // 4, y + (h - 1) // 2, x + w - 2, y + 1, c)
    p.line(x + w // 4, y + (h - 1) // 2 + 1, x + w - 2, y + 2, c)


