class Dusk(ai.AI):
    """The stock computer player, who knows where the light is: both
    sides keep out of the sunlight near the enemy, and the Concord
    keeps up with the dusk."""

    def score(self, u, h):
        s = super().score(u, h)
        e = self.e
        if not dark(e, h):
            threat = self.threat.get(h, 0)
            if threat:
                s -= min(12, 2 + threat * 0.25) * (
                    1.5 if u.side == 'cc' else 0.8)
        if u.side == 'cc' and not u.supports:
            # stay within a column or two of the dusk
            behind = h[0] - dusk(e.turn)
            if behind > 2:
                s -= (behind - 2) * 0.8
        return s


