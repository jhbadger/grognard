def _rille():
    out = []
    for r in range(len(MAP)):
        a = (RILLE, r)
        for n in hexgrid.neighbours(a):
            if n[0] == RILLE + 1 and 0 <= n[1] < len(MAP):
                out.append('%s/%s' % (hexgrid.hid(a), hexgrid.hid(n)))
    return out


