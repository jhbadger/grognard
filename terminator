NIGHT = '#0c1430'
_tables = {}


def _shade(s, v, hx, amount):
    """Tint a hex towards the night: the tables are made once."""
    key = round(amount, 2)
    tabs = _tables.get(key)
    if tabs is None:
        c = rgb(NIGHT)
        tabs = _tables[key] = [bytes(int(i + (c[k] - i) * amount)
                                     for i in range(256)) for k in range(3)]
    geo = v.geo
    cx, cy = geo.center(hx)
    cx += v.rect[0] - v.cx
    cy += v.rect[1] - v.cy
    x0c, y0c, x1c, y1c = v.clip()
    W3, buf = s.w * 3, s.buf
    for (yy, x0, n) in geo.runs:
        y = cy + yy
        if y < y0c or y >= y1c:
            continue
        a, b = max(cx + x0, x0c), min(cx + x0 + n, x1c)
        if a >= b:
            continue
        o = y * W3 + a * 3
        seg = buf[o:o + (b - a) * 3]
        seg[0::3] = bytes(seg[0::3]).translate(tabs[0])
        seg[1::3] = bytes(seg[1::3]).translate(tabs[1])
        seg[2::3] = bytes(seg[2::3]).translate(tabs[2])
        buf[o:o + (b - a) * 3] = seg


def DRAW_MAP(g, s):
    """The night side of the map in shadow, deepest in the east, with a
    thin band of dusk along the terminator."""
    e = g.e
    v = g.view
    col = dusk(e.turn)
    for hx in v.visible_hexes():
        d = hx[0] - col
        if d >= 0:
            _shade(s, v, hx, min(0.78, 0.6 + d * 0.04))
        elif d == -1:
            _shade(s, v, hx, 0.3)


