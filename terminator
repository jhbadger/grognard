def VICTORY(e):
    """The Concord takes the moon if it holds Sable Port at the end.
    Otherwise it scores the domes and the mine it holds and the Holders'
    steps destroyed, the Holders the Concord's steps, and the Concord
    must finish THRESHOLD ahead (set from games between computer
    players: ./terminator --simulate 60)."""
    cc, fh = e.vp('cc'), e.vp('fh')
    score = 'Concord %d VP, Holders %d.' % (cc, fh)
    if e.control.get(hexgrid.parse(PORT)) == 'cc':
        return 'cc', ('Concord victory. %s The mass driver is taken, and '
                      'the ore of Tarn goes where the Concord says.'
                      % score)
    m = cc - fh
    if m >= THRESHOLD:
        return 'cc', ('Concord marginal victory. %s The driver still '
                      'fires, but half of Tarn is in Concord hands.'
                      % score)
    if m > THRESHOLD - 10:
        return 'fh', ('Holders marginal victory. %s The Concord is stopped '
                      'short of the port, and the sun is coming round '
                      'behind it.' % score)
    return 'fh', ('Holders victory. %s The landing force is bled white in '
                  'the dusk, and the Free Holds keep their moon.' % score)


