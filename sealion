def _land(h):
    c, r = h
    return 0 <= c < COLS and 0 <= r < ROWS and MAP[r][c] != '~'


# The marsh behind the Royal Military Canal: below this row, column by
# column (the marsh and its towns, down to the sea).
MARSH = {8: 12, 9: 11, 10: 10, 11: 10, 12: 10, 13: 10, 14: 9, 15: 9,
         16: 9}


def _in_marsh(h):
    return h[0] in MARSH and h[1] >= MARSH[h[0]] and _land(h)


def _canal():
    """The Royal Military Canal: every side between the marsh and the
    land behind it, from Hythe round to Rye."""
    out = []
    for c in range(COLS):
        for r in range(ROWS):
            if not _in_marsh((c, r)):
                continue
            for n in hexgrid.neighbours((c, r)):
                if _land(n) and not _in_marsh(n):
                    out.append((hid((c, r)), hid(n)))
    return out


