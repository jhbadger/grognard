def _poly(p, n, pts, c):
    """Fill a polygon given in fractions of the icon, a row at a time."""
    pts = [(x * n, y * n) for x, y in pts]
    y0 = int(min(y for _, y in pts))
    y1 = int(max(y for _, y in pts)) + 1
    for y in range(y0, y1):
        yc = y + 0.5
        xs = []
        for (ax, ay), (bx, by) in zip(pts, pts[1:] + pts[:1]):
            if (ay <= yc) != (by <= yc):
                xs.append(ax + (yc - ay) * (bx - ax) / (by - ay))
        xs.sort()
        for a, b in zip(xs[::2], xs[1::2]):
            x0, x1 = int(a + 0.5), int(b + 0.5)
            if x1 > x0:
                p.rect(x0, y, x1 - x0, 1, c)


@grognard.icon('sealion')
def draw_icon(p, n):
    """A towed barge full of soldiers heading for the white cliffs."""
    p.fill('#b8c4cc')
    # the cliffs, white with green on top
    _poly(p, n, [(0.52, 0.56), (0.62, 0.3), (1.0, 0.26), (1.0, 0.56)],
          '#eceae0')
    _poly(p, n, [(0.6, 0.34), (0.62, 0.28), (1.0, 0.24), (1.0, 0.3)],
          '#6a8a4a')
    for x in (0.68, 0.78, 0.9):
        p.rect(n * x, n * 0.34, max(1, n // 48), n * 0.2, '#c8c6bc')
    # the Channel
    p.rect(0, n * 0.56, n, n * 0.44, '#3e6890')
    for k in range(5):
        p.rect(n * (0.05 + k * 0.2), n * (0.62 + (k % 2) * 0.1),
               n * 0.1, max(1, n // 40), '#6a94bc')
    # the barge: a low, flat hull with a row of helmets
    _poly(p, n, [(0.06, 0.7), (0.62, 0.7), (0.56, 0.84), (0.1, 0.84)],
          '#2a2c2e')
    for k in range(6):
        p.disc(n * (0.14 + k * 0.08), n * 0.68, n * 0.035, '#4a5048')
    # the tow rope and the tug
    p.line(n * 0.62, n * 0.72, n * 0.74, n * 0.66, '#1a1a1a',
           max(1, n // 48))
    _poly(p, n, [(0.72, 0.66), (0.96, 0.66), (0.92, 0.76), (0.74, 0.76)],
          '#2a2c2e')
    p.rect(n * 0.8, n * 0.56, n * 0.06, n * 0.1, '#3a3c3e')


