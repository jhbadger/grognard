def COMBAT_SHIFTS(e, target, attackers, support):
    """Surprise on the first morning."""
    if attackers and e.side == 'de' and e.turn == 1:
        return [(1, 'surprise')]
    return []


def _score(e):
    return 'Germans %d VP, British %d.' % (e.vp('de'), e.vp('br'))


def VICTORY(e):
    """The Germans score the places they hold and the British steps
    they destroy; the British score German steps, those sunk at sea as
    well as those killed ashore."""
    m = e.vp('de') - e.vp('br')
    if m >= MARGIN + 7:
        return 'de', ('German victory. %s The ports are taken and the '
                      'lodgement is safe. The panzers are ashore, and the '
                      'road to London is open.' % _score(e))
    if m >= MARGIN:
        return 'de', ('German marginal victory. %s The beachhead holds, '
                      'but it is fed through one port and some beaches, '
                      'and the Navy is still in the Channel.' % _score(e))
    if m > MARGIN - 7:
        return 'br', ('British marginal victory. %s The invaders are '
                      'penned on the coast and starving for supplies; '
                      'in Berlin they talk of evacuation.' % _score(e))
    return 'br', ('British victory. %s The invasion has failed, and the '
                  'Channel is full of wrecked barges. England will not be '
                  'invaded again.' % _score(e))


