# --------------------------------------------------- the Channel crossing

def ON_END_TURN(e):
    """The barges for the coming turn cross tonight (or today).  In a
    gale they don't sail at all, and wait a turn.  Once the Royal Navy
    is in the Channel each destroyer flotilla still afloat sinks a
    crossing unit one time in six by day, when the Luftwaffe keeps the
    ships off, and one time in three at night."""
    nxt = e.turn + 1
    if nxt > TURNS:
        return
    crossing = [u for u in e.units.values() if u.side == 'de' and
                u.status == 'pending' and u.arrive == nxt]
    if not crossing:
        return
    if gale(e, nxt):
        for u in crossing:
            u.arrive += 1
        e.say('A gale in the Channel. The barges stay in harbour.')
        e.changed()
        return
    ships = sum(1 for u in e.alive('br') if u.kind == 'ship')
    if not ships:
        return
    p = min(0.8, ships * (1 / 3 if night(e, nxt) else 1 / 6))
    for u in sorted(crossing, key=lambda u: u.id):
        if e.rng.random() < p:
            e.lost['de'] += u.steps
            u.steps = 0
            u.status = 'dead'
            e.say('The Royal Navy finds the barges carrying %s: they are '
                  'sunk in the Channel.' % u.long)
    e.changed()


def ON_TURN(e, side):
    if side == 'de':
        if e.turn == 1:
            e.say('Dawn. The barges ground on the beaches from Hythe to '
                  'Bexhill, the tanks of the Tauchpanzer battalions come '
                  'up out of the sea, and the parachutes open over the '
                  'Downs behind Folkestone.')
        if e.turn == 3:
            e.say('The rest of the first wave\'s divisions are coming '
                  'ashore.')
        if e.turn == 5:
            e.say('The second wave, the panzer divisions, is ready to '
                  'cross.')
    else:
        if e.turn == 1:
            e.say('Cromwell. The church bells ring across Kent and '
                  'Sussex, and the Home Guard stand to.')
        if e.turn == 2:
            e.say('The New Zealanders are coming down from Maidstone.')
        if e.turn == NAVY_TURN:
            e.say('The destroyers of the Home Fleet are in the Channel.')
        if e.turn == 4:
