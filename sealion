def u(uid, side, kind, a, d, m, hx, formation, colour, long, **kw):
    spec = dict(id=uid, name=kw.pop('name', uid.upper()), side=side,
                type=kind, size=kw.pop('size', 'III'), a=a, d=d, m=m,
                steps=kw.pop('steps', 2), hex=hx, formation=formation,
                colour=colour, long=long)
    spec.update(kw)
    return spec


def regiment(div, reg, kind, colour, arrive, at, a=4, d=4, m=3, **kw):
    """A German regiment of the first wave's divisions."""
    names = {'infantry': 'Infantry Regiment', 'mountain':
             'Gebirgsjäger Regiment'}
    return u('%s_%s' % (div, reg), 'de', kind, a, d, m, None,
             '%s Division' % div, colour,
             '%s %s, %s Division' % (names.get(kind, 'Regiment'), reg, div),
             name='%s/%s' % (reg, div.split()[0]), arrive=arrive, at=at,
             **kw)


def brigade(uid, name, formation, colour, hx, long, a=4, d=5, m=3, **kw):
    """A British brigade."""
    return u(uid, 'br', kw.pop('kind', 'infantry'), a, d, m, hx, formation,
             colour, long, name=name, size='X', steps=3, **kw)


def home_guard(uid, hx, town):
    return u(uid, 'br', 'homeguard', 1, 2, 2, hx, 'Home Guard', HG,
             'The %s Home Guard' % town, size='II', name='HG', steps=1)


