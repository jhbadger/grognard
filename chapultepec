def VICTORY(e):
    """What Scott needed: the castle, and then the gates.  Both gates
    forced is an American victory; one is a marginal one, unless the
    Americans have lost more steps than they destroyed getting there.
    The castle alone leaves the city in Mexican hands for the night: a
    Mexican marginal victory.  A castle that holds is a Mexican victory."""
    us, mx = e.vp('us'), e.vp('mx')
    score = 'Americans %d VP, Mexicans %d.' % (us, mx)
    castle = e.control.get(CASTLE) == 'us'
    gates = [h for h in ('1810', '1703')
             if e.control.get(hexgrid.parse(h)) == 'us']
    if castle and len(gates) == 2:
        return 'us', ('American victory. %s Both gates are forced; in the '
                      'morning the city surrenders.' % score)
    if castle and gates and e.lost['us'] <= e.lost['mx']:
        return 'us', ('American marginal victory. %s A gate is forced and '
                      'the army is in the city.' % score)
    if castle:
        return 'mx', ('Mexican marginal victory. %s Chapultepec has '
                      'fallen, but the gates hold for tonight.' % score)
    return 'mx', ('Mexican victory. %s Chapultepec holds, and the cadets '
                  'are heroes of a victory.' % score)


