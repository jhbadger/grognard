def _park_wall():
    """A wall runs round the cypress grove at the foot of the hill: every
    side of a grove hex that faces open country."""
    grove = {hexgrid.parse(h) for h in GROVE}
    hill = {hexgrid.parse('0707')} | set(hexgrid.neighbours(
        hexgrid.parse('0707')))
    out = []
    for h in grove:
        for n in hexgrid.neighbours(h):
            if n not in grove and n not in hill and 0 <= n[0] < 20 and \
                    0 <= n[1] < 14:
                out.append((h, n))
    return out


