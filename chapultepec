def COMBAT_SHIFTS(e, target, attackers, support):
    """Scaling ladders: storming the castle without a storming party (the
    pioneers who carried them) costs a column.  Guns firing from more than
    4 hexes away lose a column.  And once the castle has fallen the
    defenders are shaken: American attacks gain a column."""
    out = []
    if e.side == 'us' and e.control.get(CASTLE) == 'us':
        out.append((1, 'Chapultepec has fallen'))
    t = e.board.terrain(target)
    near = [u for u in attackers if hexgrid.distance(u.hex, target) == 1]
    if t.get('name') == 'Castle' and near and \
            not any(u.kind == 'engineer' for u in near):
        out.append((-1, 'no ladders'))
    if not attackers and support and \
            min(hexgrid.distance(u.hex, target) for u in support) > 4:
        out.append((-1, 'long range'))
    return out


