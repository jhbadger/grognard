@grognard.icon('chapultepec')
def draw_icon(p, n):
    """The castle on its hill, with the flag over it."""
    p.fill('#d8c8a0')
    p.disc(n * 0.5, n * 1.05, n * 0.62, '#8a7450')
    p.rect(n * 0.28, n * 0.38, n * 0.44, n * 0.16, '#e8e0d0')
    p.rect(n * 0.38, n * 0.28, n * 0.24, n * 0.12, '#e8e0d0')
    for k in range(5):
        p.rect(n * (0.3 + k * 0.09), n * 0.42, n * 0.04, n * 0.06,
               '#5a4a3a')
    p.rect(n * 0.49, n * 0.08, n * 0.02, n * 0.22, '#3a2a1a')
    p.rect(n * 0.51, n * 0.08, n * 0.07, n * 0.09, '#2a6a3a')
    p.rect(n * 0.58, n * 0.08, n * 0.07, n * 0.09, '#f0f0f0')
    p.rect(n * 0.65, n * 0.08, n * 0.07, n * 0.09, '#b02020')
    for x, r in ((0.15, 0.09), (0.25, 0.1), (0.8, 0.08)):
        p.disc(n * x, n * 0.72, n * r, '#3a5a30')


