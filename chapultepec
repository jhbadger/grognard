def unit(uid, side, kind, a, d, hx, long, colour, steps=2, m=3, **kw):
    """A unit: attack, defence, and the hex it starts in (None to arrive
    later, with arrive and at)."""
    spec = dict(id=uid, name=kw.pop('name', uid.upper()), side=side,
                type=kind, size=kw.pop('size', 'X' if steps >= 3 else 'II'),
                a=a, d=d, m=m, steps=steps, hex=hx, long=long,
                colour=colour)
    spec.update(kw)
    return spec


def guns(uid, side, a, rng, hx, long, colour, m=2, **kw):
    return unit(uid, side, 'artillery', a, 2, hx, long, colour, steps=1,
                m=m, range=rng, **kw)


