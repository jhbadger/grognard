def TURN_NAME(t):
    """The 12th in two halves, the bombardment; then the 13th by hours."""
    if t <= 2:
        return ('12 Sep 1847', 'AM' if t == 1 else 'PM')
    h = 8 + (t - 3)
    return ('13 Sep 1847', '%d %s' % ((h - 1) % 12 + 1,
                                      'AM' if h < 12 else 'PM'))


