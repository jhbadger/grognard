def _score(e):
    return 'SS %d VP, defenders %d.' % (e.vp('ss'), e.vp('al'))


def VICTORY(e):
    """The SS win outright holding the keep at the end, or with both
    prisoner counters lost.  Otherwise the defenders must not finish more
    than WIN VP behind (set from ./itter --simulate 60): the SS score
    the ground and the steps they take, the defenders the SS steps."""
    ss, al = e.vp('ss'), e.vp('al')
    m = al - ss
    keep = e.control.get(KEEP[0]) == 'ss'
    gone = sum(1 for p in PRISONERS if not e.units[p].alive)
    if keep or gone == len(PRISONERS):
        return 'ss', ('SS victory. %s The keep is taken and the prisoners '
                      'shot; the Americans come up the road too late.'
                      % _score(e))
    if m < -WIN:
        return 'ss', ('SS marginal victory. %s The keep holds, but the '
                      'castle is a ruin, its defenders few, and the SS '
                      'slip away into the mountains.' % _score(e))
    if m < WIN_BIG or gone:
        return 'al', ('Allied marginal victory. %s The keep holds, only '
                      'just.' % _score(e))
    return 'al', ('Allied victory. %s The castle holds and the SS are '
                  'marched away. Reynaud and Daladier are on their way '
                  'home, and still not speaking to each other.'
                  % _score(e))


