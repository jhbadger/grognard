def unit(uid, side, kind, a, d, hx, formation, colour, long, steps=2,
         **kw):
    spec = dict(id=uid, name=kw.pop('name', uid.upper()), side=side,
                type=kind, size=kw.pop('size', '***'), a=a, d=d,
                m=kw.pop('m', 3), steps=steps, hex=hx,
                formation=formation, colour=colour, long=long)
    spec.update(kw)
    return spec


def ss(uid, hx, name, long, a=3, d=2, steps=3, arrive=None, at=None,
