def ON_TURN(e, side):
    f = e.flags
    if side == 'ss':
        if e.turn == 1:
            e.say('Shots from the woods. The SS have come for the '
                  'prisoners.')
        if e.turn == LINE:
            e.say('The telephone goes dead in the middle of a call to '
                  'the 142nd Infantry. Jean Borotra offers to go over '
                  'the wall and fetch them.')
        jenny, gun = e.units[JENNY], e.units[EIGHTY_EIGHT]
        if jenny.alive and gun.alive and \
                hexgrid.distance(jenny.hex, gun.hex) <= gun.range + 1:
            if e.rng.randint(1, 6) <= 2:
                e.say('The 88 finds Besotten Jenny.')
                e.take_losses([jenny], 1)
            else:
                e.say('An 88 shell bursts by Besotten Jenny.')
    else:
        if e.exited.get('al') and not f.get('guided'):
            f['guided'] = True
            soon = max(e.turn + 1, RELIEF - 1)
            for uid in RELIEF_UNITS:
                e.units[uid].arrive = min(e.units[uid].arrive, soon)
            e.say('Borotra has got through. He meets the relief column on '
                  'the road, borrows a uniform and a rifle, and leads '
                  'them back up the valley.')
        if e.turn == RELIEF:
            e.say('Four o\'clock. Shermans and infantry of the 142nd come '
                  'round the bend below the village.')


def ON_ELIMINATE(e, u, where):
    if u.id == JENNY:
        e.say('Besotten Jenny burns at the gate. Her crew gets out and '
              'goes up on the walls.')
    elif u.id == 'gangl':
        e.say('Major Gangl is shot by a sniper pulling Paul Reynaud out '
              'of the line of fire.')
    elif u.id == 'lee':
        e.say('Lieutenant Lee is down.')
    elif u.id in PRISONERS:
        e.say('The SS have reached %s.' % u.long)


def COMBAT_SHIFTS(e, target, attackers, support):
    """Lee or Gangl in a hex costs an SS attack on it a column, and one
    of them leading an attack gains it one.  At dawn every attack is a
    column worse."""
    out = []
    if attackers and e.weather()['id'] == 'dawn':
        out.append((-1, 'half light'))
    if e.side == 'ss':
        if any(u.id in LEADERS for u in e.at(target, 'al')):
            out.append((-1, 'officers'))
    elif any(u.id in LEADERS for u in attackers) and len(attackers) > 1:
        out.append((1, 'officers'))
    return out


def CAN_SUPPORT(e, u):
    """The 88 is busy with Besotten Jenny while she lives."""
    return not (u.id == EIGHTY_EIGHT and e.units[JENNY].alive)


def ENTER_COST(e, unit, a, b, cost):
    """The prisoners stay in the keep."""
    if getattr(unit, 'kind', None) == 'notables':
        return None
    return cost


