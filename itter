@grognard.symbol('notables')
def s_notables(p, x, y, w, h, c):
    """The prisoners: a fleur-de-lis cross of Lorraine."""
    cx, cy = x + (w - 1) / 2, y + (h - 1) / 2
    r = max(2, min(w, h) // 2 - 1)
    p.line(cx, cy - r, cx, cy + r, c)
    p.line(cx - r * 0.5, cy - r * 0.5, cx + r * 0.5, cy - r * 0.5, c)
    p.line(cx - r * 0.8, cy, cx + r * 0.8, cy, c)


@grognard.symbol('runner')
def s_runner(p, x, y, w, h, c):
    """Borotra: a tennis racket."""
    cx, cy = x + (w - 1) / 2, y + (h - 1) / 2
    p.oval(cx, cy - h * 0.15, max(1.5, w / 5), max(2, h / 4), c)
    p.line(cx, cy + h * 0.1, cx, y + h - 1, c)


