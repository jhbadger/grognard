class Lee(ai.AI):
    """The stock computer player, taught the siege: the defenders stay
    behind the walls (Jenny at the gate) until the relief is in sight,
    Borotra makes his run, and the SS press on the keep."""

    def score(self, u, h):
        s = super().score(u, h)
        e = self.e
        keep = min(hexgrid.distance(h, k) for k in KEEP)
        if self.side == 'al':
            if u.id in RELIEF_UNITS:
                s += 4 * (8 - keep)
            elif u.id == JENNY:
                if h in (APPROACH, GATE):
                    s += 25
            elif u.kind != 'runner':
                if h in CASTLE:
                    s += 25
        else:
            if not u.supports:
                s += 2.5 * (10 - keep)
                if h in CASTLE:
                    s += 10
        return s


