# ---------------------------------------------------- the barrier plan

def bridges(e):
    """Every place a road crosses the Leine, the Oker or the canal:
    [(side, a, b)], a and b the hexes either end."""
    def build():
        out = []
        for s, kind in sorted(e.board.rivers.items()):
            if kind in ('river', 'canal') and s in e.board.roads:
                a, b = s
                out.append(('%s/%s' % (hid(a), hid(b)), a, b))
        return out
    return e.cached('bridges', build)


def blown(e):
    return e.cached('blown', lambda: {
        tuple(sorted((parse(x), parse(y)))) for x, y in
        (s.split('/') for s in e.flags.get('blown', []))})


def _demolitions(e):
    """At the start of every Soviet turn the sappers fire the charges
    on each bridge the Soviets have come within BLOW_RANGE hexes of, two
    times in three.  A bridge with Soviet troops on either end is taken
    whole, and can't be blown after that."""
    done = e.flags.setdefault('blown', [])
    seized = e.flags.setdefault('seized', [])
    soviets = [u.hex for u in e.alive('wp')]
    for key, a, b in bridges(e):
        if key in done or key in seized:
            continue
        if a in soviets or b in soviets:
            seized.append(key)
            e.say('The Soviets take the bridge at %s intact.'
                  % e.place(a if a in soviets else b))
            continue
        near = min((min(distance(h, a), distance(h, b)) for h in soviets),
                   default=99)
        if near > BLOW_RANGE:
            continue
        if e.rng.random() < 2 / 3:
            done.append(key)
            e.say('The Royal Engineers blow the bridge at %s.'
                  % e.place(b))
            e.events.append(('popup', b, 'Bridge blown', '#ff9040'))
            e.events.append(('sound', 'blast'))
        else:
            e.say('The charges on the bridge at %s fail to go off.'
                  % e.place(b))
    e.changed()


def ENTER_COST(e, u, a, b, c):
    """A blown bridge is no bridge: the river costs what it would
    anywhere else, and the canal can't be crossed at all."""
    if ((a, b) if a <= b else (b, a)) not in blown(e):
        return c
    t = e.board.terrain(b)
    mc = u.move_class
    base = t['move'].get(mc, t['move'].get('foot'))
    if base is None:
        return None
    riv = e.board.river(a, b)
    rc = riv['cost'].get(mc, 1) if riv else 0
    if rc is None:
        return None
    return base * e.weather().get('move', 1) + rc


def DRAW_MAP(g, s):
    """A red cross on every blown bridge."""
    gone = blown(g.e)
    if not gone:
        return
    v = g.view
    x0c, y0c, x1c, y1c = v.clip()
    s.set_clip(x0c, y0c, x1c - x0c, y1c - y0c)
    k = max(2, v.geo.dx // 6)
    for a, b in gone:
        (ax, ay), (bx, by) = v.to_screen(a), v.to_screen(b)
        mx, my = (ax + bx) // 2, (ay + by) // 2
        for d in (0, 1):
            s.line(mx - k + d, my - k, mx + k + d, my + k, '#e02010')
            s.line(mx - k + d, my + k, mx + k + d, my - k, '#e02010')
    s.set_clip()


