def _poly(p, n, pts, c):
    """Fill a polygon given in fractions of the icon, a row at a time."""
    pts = [(x * n, y * n) for x, y in pts]
    y0 = int(min(y for _, y in pts))
    y1 = int(max(y for _, y in pts)) + 1
    for y in range(y0, y1):
        yc = y + 0.5
        xs = []
        for (ax, ay), (bx, by) in zip(pts, pts[1:] + pts[:1]):
            if (ay <= yc) != (by <= yc):
                xs.append(ax + (yc - ay) * (bx - ax) / (by - ay))
        xs.sort()
        for a, b in zip(xs[::2], xs[1::2]):
            x0, x1 = int(a + 0.5), int(b + 0.5)
            if x1 > x0:
                p.rect(x0, y, x1 - x0, 1, c)


@grognard.icon('northag')
def draw_icon(p, n):
    """A road bridge over a river going up in a burst of fire, on a
    flat grey plain."""
    p.fill('#b4bcc0')
    p.rect(0, n * 0.48, n, n * 0.52, '#a4a878')            # the plain
    p.rect(0, n * 0.66, n, n * 0.2, '#4a74a8')             # the river
    p.rect(0, n * 0.7, n, n * 0.03, '#6a94c4')
    deck = '#5a5650'
    # the two ends of the bridge, and the gap between them
    p.rect(0, n * 0.56, n * 0.36, n * 0.07, deck)
    p.rect(n * 0.64, n * 0.56, n * 0.36, n * 0.07, deck)
    for x in (0.12, 0.28, 0.72, 0.88):
        p.rect(n * (x - 0.03), n * 0.6, n * 0.06, n * 0.24, '#48443e')
    # the falling span
    _poly(p, n, [(0.36, 0.56), (0.44, 0.6), (0.4, 0.78), (0.33, 0.63)],
          deck)
    _poly(p, n, [(0.64, 0.56), (0.57, 0.62), (0.61, 0.8), (0.67, 0.62)],
          deck)
    # the burst
    p.disc(n * 0.5, n * 0.46, n * 0.2, '#e86a20')
    p.disc(n * 0.47, n * 0.44, n * 0.13, '#f4a838')
    p.disc(n * 0.52, n * 0.47, n * 0.06, '#fff0a0')
    p.disc(n * 0.36, n * 0.3, n * 0.08, '#6a625a')
    p.disc(n * 0.62, n * 0.26, n * 0.1, '#7a726a')
    p.disc(n * 0.5, n * 0.2, n * 0.09, '#8a827a')


