def _east_german(h):
    return MAP[h[1]][h[0]] in 'gG'


def _sides(first):
    """Every hexside between a hex where first(h) is true and a
    neighbour on the map where it isn't."""
    out = []
    for c in range(COLS):
        for r in range(ROWS):
            if not first((c, r)):
                continue
            for n in hexgrid.neighbours((c, r)):
                if 0 <= n[0] < COLS and 0 <= n[1] < ROWS and \
                        not first(n):
                    out.append((hid((c, r)), hid(n)))
    return out


