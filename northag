def ON_END_TURN(e):
    """If the Soviets hold Hanover, or get enough of their army off the
    west edge, NORTHAG's front is broken and SACEUR asks for nuclear
    release: the conventional war, and the game, is over."""
    held = e.control.get(parse(HANOVER)) == 'wp'
    out = e.exited.get('wp', 0) >= BREAKTHROUGH
    if held or out:
        e.finish('wp', 'Soviet victory: breakthrough. %s I British Corps '
                 'is broken, the road to the Ruhr is open, and SACEUR '
                 'asks for the release of nuclear weapons. %s'
                 % ('Hanover has fallen.' if held else
                    'Soviet tanks are over the Weser.', _score(e)))


def COMBAT_SHIFTS(e, target, attackers, support):
    """Surprise on the first day; at night the British, on ground they
    know and have dug, cost every Soviet attack a column."""
    out = []
    if not attackers:
        return out
    if e.side == 'wp':
        if e.turn == 1:
            out.append((1, 'surprise and the air offensive'))
        elif night(e):
            out.append((-1, 'prepared positions at night'))
    return out


def CAN_SUPPORT(e, u):
    """Helicopters fly by day, and not in fog."""
    if u.kind != 'helo':
        return True
    return e.weather()['id'] not in ('night', 'fog')


def _score(e):
    return 'Soviets %d VP, NATO %d.' % (e.vp('wp'), e.vp('nato'))


def VICTORY(e):
    """Taking Hanover, or getting four steps over the Weser, wins at
    once (ON_END_TURN).  Otherwise the margin decides."""
    m = e.vp('wp') - e.vp('nato')
    if m >= MARGIN + 8:
        return 'wp', ('Soviet victory. %s Braunschweig and the plain are '
                      'lost and the British corps is in pieces before '
                      'Hanover.' % _score(e))
    if m >= MARGIN:
        return 'wp', ('Soviet marginal victory. %s The 3rd Shock Army is '
                      'deep into Lower Saxony, but the Leine holds, for '
                      'now.' % _score(e))
    if m > MARGIN - 8:
        return 'nato', ('NATO marginal victory. %s The British have given '
                        'ground and not broken, and the Americans are '
                        'coming.' % _score(e))
    return 'nato', ('NATO victory. %s The 3rd Shock Army has burnt itself '
                    'out on the plain, and the war stops short of the '
                    'nuclear threshold.' % _score(e))


