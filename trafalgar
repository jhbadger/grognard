def ship(uid, nation, guns, hx, long, name=None, flag=None, **kw):
    a, d, steps, vp = RATES[nation][guns]
    side = 'gb' if nation == 'gb' else 'cf'
    colour = {'gb': GB_FLAG if flag else GB, 'fr': FR, 'sp': SP}[nation]
    spec = dict(id=uid, name=name or uid.upper()[:6], side=side,
                type='ship', size='', a=a, d=d, m=3 if side == 'gb' else 1,
                steps=steps, hex=hx, colour=colour,
                vp=vp + (2 if flag else 0),
                long='%s (%d guns)%s' % (long, guns,
                                         ', ' + flag if flag else ''))
    spec.update(kw)
    return spec


