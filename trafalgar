def COMBAT_SHIFTS(e, target, attackers, support):
    """Raking: a broadside fired into a ship's bow or stern runs the
    length of her decks.  The Combined Fleet is sailing north, so a
    British ship attacking from the hex directly ahead of (north of) or
    astern of (south of) a Combined ship gains a column.  And a British
    ship that didn't fire in her own turn is still coming down bow-on,
    or turning, and can't reply: Combined attacks on her gain a
    column."""
    out = []
    defenders = [u for u in e.at(target) if u.side != e.side]
    if not defenders:
        return out
    if e.side == 'gb':
        ahead = {hexgrid.neighbour(target, 0), hexgrid.neighbour(target, 3)}
        if any(u.hex in ahead for u in attackers):
            out.append((1, 'raking'))
    elif not any(u.attacked for u in defenders):
        out.append((1, 'bow-on'))
    return out


def ON_END_TURN(e):
    """The moment the Victory is in close action, a marksman in the
    enemy's tops may find Nelson."""
    v = e.units['victory']
    if v.alive and v.attacked and not e.flags.get('nelson') and \
            e.rng.random() < 0.5:
        e.flags['nelson'] = e.turn
