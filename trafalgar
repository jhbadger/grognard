# ----------------------------------------------------------- winning

def struck(e, side):
    return [u for u in e.units.values() if u.side == side and
            u.status == 'dead']


def VICTORY(e):
    """Nelson wanted annihilation, not a victory.  Count the Combined
    ships taken, less two for every British ship lost."""
    cf, gb = struck(e, 'cf'), struck(e, 'gb')
    n = len(cf) - 2 * len(gb)
    score = '%d French and Spanish ships taken, %d British.' % (
        len(cf), len(gb))
    if n >= 18:
        return 'gb', ('British decisive victory. %s The Combined Fleet is '
                      'destroyed; there will be no invasion.' % score)
    if n >= 16:
        return 'gb', ('British victory. %s The Combined Fleet limps back '
                      'into Cádiz, broken.' % score)
    if n >= 10:
        return 'cf', ('Combined Fleet marginal victory. %s A bloody day, '
                      'but the fleet survives to fight again.' % score)
    return 'cf', ('Combined Fleet victory. %s The British attack has '
                  'failed, and Villeneuve is a hero.' % score)


# ------------------------------------------------- the wind widget

@grognard.widget('wind')
class Wind(grognard.Widget):
    """A compass card with the wind arrow."""

    def height(self, g, w):
        return 44

    def draw(self, g, s, r):
        x, y, w, h = r
        panel(g, s, r)
        cx, cy, rr = x + w // 2, y + 4 + (h - 17) // 2, (h - 17) // 2
        s.rect(x + 4, y + 4, w - 8, h - 17, rgb('#2a4a6a'))
        ink = rgb('#e8e0c8')
        s.line(cx - rr - 6, cy, cx + rr + 6, cy, ink)
        for k in range(1, 3):
            s.line(cx + rr + 6 - k, cy - k, cx + rr + 6 - k, cy + k, ink)
        for k in (-3, 3):
            s.line(cx - rr - 6, cy + k, cx - rr - 2, cy, ink)
        s.text(x + w // 2, y + h - 12, fit('Wind from W', w - 4),
               ch(g, 'text'), align='center')


@grognard.symbol('ship')
def s_ship(p, x, y, w, h, c):
    """A ship of the line: a hull and three masts under plain sail."""
    base = y + h - 3
    p.rect(x + 1, base, w - 2, 1, c)
    p.rect(x + 2, base + 1, w - 4, 1, c)
    sw = max(1, w // 9)
    for k in (0.28, 0.5, 0.72):
        mx = int(x + (w - 1) * k)
        p.rect(mx, y + 1, 1, base - y - 1, c)
        p.rect(mx - sw, y + 2, 2 * sw + 1, max(1, (base - y - 3) // 2), c)


