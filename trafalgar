def _units():
    out = []
    line = line_hexes()
    row = {}
    for i, (h, s) in enumerate(zip(line, COMBINED)):
        uid, nation, guns, long = s[:4]
        flag = s[4] if len(s) > 4 else None
        name = s[5] if len(s) > 5 else None
        out.append(ship(uid, nation, guns, h, long, name=name, flag=flag,
                        formation=("Dumanoir's van" if i < 10 else
                                   "Villeneuve's centre" if i < 17 else
                                   "Gravina's rear"),
                        release=VAN_TURN if i < 10 else 0))
        row[uid] = hexgrid.parse(h)[1]
    # Nelson's column steers for the Bucentaure, Collingwood's for the
    # Santa Ana; the Royal Sovereign is well ahead of her column.
    for col, (target, head, gaps) in (
            (WEATHER_COLUMN, ('bucentaure', 13, ())),
            (LEE_COLUMN, ('santaana', 16, (1,)))):
        r = row[target] - 1
        c = head
        for k, s in enumerate(col):
            uid, guns, long = s[:3]
            flag = s[3] if len(s) > 3 else None
            name = s[4] if len(s) > 4 else None
            if k in gaps:
                c -= 1
            out.append(ship(uid, 'gb', guns, hexgrid.hid((c, r)), long,
                            name=name, flag=flag,
                            formation=("Nelson's column" if col is
                                       WEATHER_COLUMN else
                                       "Collingwood's column")))
            c -= 1
    out.append(ship('africa', 'gb', 64, '1602', 'Africa',
                    formation='Detached to the north'))
    return out


