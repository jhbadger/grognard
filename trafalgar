# The Combined Fleet's line, van (north) to rear (south): how many ships
# abreast in each row (a 2 is a ship with another to leeward of her; a 0
# a gap).  The line bows to leeward in the middle.
LINE = [1, 2, 0, 2, 1, 0, 2, 2, 0, 1, 2, 0, 2, 1, 0, 2, 2, 0, 1, 2, 0,
        2, 2, 0, 1, 2, 0, 2, 1]


def line_hexes():
    out = []
    for k, n in enumerate(LINE):
        c = 21 + round(2 * math.sin(math.pi * k / (len(LINE) - 1)))
        for j in range(n):
            out.append(hexgrid.hid((c + j, k + 1)))
    return out


