# What it costs to sail each way with the wind in the west, by the
# direction sailed (hexgrid.DIR_NAMES): before the wind on a broad reach
# (north-east and south-east) is quickest; with the wind on the beam
# (north and south) slower; and nothing sails into it (north-west and
# south-west, 30 degrees off the wind).
SAILING = {'NE': 1, 'SE': 1, 'N': 1.5, 'S': 1.5, 'NW': None, 'SW': None}


def ENTER_COST(e, unit, a, b, c):
    """Ships go where the wind lets them."""
    if getattr(unit, 'move_class', None) != 'sail':
        return c
    k = SAILING[hexgrid.DIR_NAMES[hexgrid.direction(a, b)]]
    return None if k is None else c * k


