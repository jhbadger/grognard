@grognard.icon('trafalgar')
def draw_icon(p, n):
    """A ship of the line under sail, with powder smoke."""
    p.fill('#8ab0d0')
    p.rect(0, n * 0.7, n, n * 0.3, '#2a5a8a')
    for x, r in ((0.15, 0.12), (0.85, 0.14), (0.75, 0.1)):
        p.disc(n * x, n * 0.62, n * r, '#e8e8e0')
    p.rect(n * 0.18, n * 0.6, n * 0.64, n * 0.1, '#1a1208')
    p.rect(n * 0.22, n * 0.63, n * 0.56, n * 0.025, '#e0c060')
    p.rect(n * 0.24, n * 0.7, n * 0.52, n * 0.04, '#1a1208')
    for k, mx in enumerate((0.32, 0.5, 0.68)):
        p.rect(n * (mx - 0.01), n * 0.12, n * 0.02, n * 0.48, '#3a2a1a')
        for j, (yy, ww) in enumerate(((0.16, 0.1), (0.28, 0.13),
                                      (0.42, 0.15))):
            p.rect(n * (mx - ww / 2 - 0.0), n * yy, n * ww, n * 0.1,
                   '#f4f0e0')
    p.rect(n * 0.5, n * 0.06, n * 0.08, n * 0.05, '#c02020')


