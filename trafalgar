def TURN_NAME(t):
    """Half-hour turns from half past eleven."""
    m = 11 * 60 + 30 + (t - 1) * 30
    h = m // 60
    return ('21 Oct 1805', '%d:%02d %s' % ((h - 1) % 12 + 1, m % 60,
                                           'AM' if h < 12 else 'PM'))


