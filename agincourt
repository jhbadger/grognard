def _line(e, h):
    """Whether h is in the English line, where a unit began the day."""
    return any(u.spec.get('hex') and hexgrid.parse(u.spec['hex']) == h
               for u in e.units.values() if u.side == 'en')


class Constable(ai.AI):
    """The stock computer player, taught the shape of the day: the
    English hold their places in the line, and the French press on
    toward the king's banner rather than waiting under the arrows."""

    def score(self, u, h):
        s = super().score(u, h)
        e = self.e
        if self.side == 'en':
            if u.spec.get('hex') and hexgrid.parse(u.spec['hex']) == h:
                s += 6
            elif _line(e, h):
                s += 3
        elif not u.supports and u.kind != 'raiders':
            s -= hexgrid.distance(h, BANNER) * 0.8
            if any(e.at(n, 'en') for n in hexgrid.neighbours(h)):
                s += 5
        return s


