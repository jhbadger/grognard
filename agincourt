def unit(uid, side, kind, a, d, m, hx, long, colour, formation, steps=2,
         **kw):
    """A battle or a body of archers: attack, defence, movement and
    where it starts (None to arrive later, with arrive and at)."""
    spec = dict(id=uid, name=kw.pop('name', uid.upper()), side=side,
                type=kind, size=kw.pop('size', 'III'), a=a, d=d, m=m,
                steps=steps, hex=hx, long=long, colour=colour,
                formation=formation)
    spec.update(kw)
    return spec


def archers(n, hx, formation):
    return unit('arch%d' % n, 'en', 'longbow', 5, 3, 3, hx,
                'Longbowmen with stakes, mallets and swords', ARCHER,
                formation, range=2, name='ARCH %d' % n)


def maa(uid, a, d, hx, long, colour, formation, name, **kw):
    side = 'en' if colour in (ENGLAND, KING) else 'fr'
    return unit(uid, side, 'maa', a, d, kw.pop('m', 4 if side == 'fr'
                                                else 3),
                hx, long, colour, formation, steps=kw.pop('steps', 3),
                name=name, **kw)


def knights(uid, a, hx, long, colour, formation, name, **kw):
    return unit(uid, 'fr', 'knight', a, 3, 5, hx, long, colour, formation,
                name=name, **kw)


