@grognard.symbol('bow')
def s_bow(p, x, y, w, h, c):
    """Archers: a bow drawn, with an arrow on the string."""
    cx, cy = x + w * 0.4, y + (h - 1) / 2
    r = max(2, h // 2 - 1)
    p.line(cx, cy - r, cx, cy + r, c)                       # string
    for i in range(r + 1):                                  # stave
        dx = int(round((r * r - i * i) ** 0.5 * 0.7))
        p.set(cx + dx, cy - i, c)
        p.set(cx + dx, cy + i, c)
    p.line(cx - 1, cy, x + w - 1, cy, c)                    # arrow


@grognard.symbol('cart')
def s_cart(p, x, y, w, h, c):
    """The baggage: a cart on two wheels."""
    base = y + h - 3
    p.line(x + 1, base - h // 3, x + w - 2, base - h // 3, c)
    p.line(x + 1, base - h // 3, x + 1, base, c)
    p.line(x + w - 2, base - h // 3, x + w - 2, base, c)
    p.line(x + 1, base, x + w - 2, base, c)
    r = max(1.5, h / 6)
    p.oval(x + w * 0.3, base + 1, r, r, c)
    p.oval(x + w * 0.7, base + 1, r, r, c)


