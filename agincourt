@grognard.icon('agincourt')
def draw_icon(p, n):
    """A row of stakes in the mud and a sky full of arrows."""
    p.fill('#c4c8cc')
    p.rect(0, n * 0.62, n, n * 0.38, '#7a6448')
    p.rect(0, n * 0.78, n, n * 0.22, '#5e4a34')
    for k in range(6):
        x = n * (0.1 + k * 0.16)
        p.line(x, n * 0.85, x + n * 0.08, n * 0.6, '#c8a878',
               max(1, n // 32))
    for k in range(9):
        x = n * (0.06 + k * 0.11)
        y = n * (0.1 + (k * 37 % 5) * 0.06)
        for s in range(6):
            p.rect(x + s * n * 0.014, y + s * n * 0.02, n * 0.018,
                   n * 0.018, '#2a2018')
    p.rect(n * 0.06, n * 0.48, n * 0.1, n * 0.12, '#2e4c9a')
    p.rect(n * 0.84, n * 0.48, n * 0.1, n * 0.12, '#b8302a')


