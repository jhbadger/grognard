def _score(e):
    return 'French %d VP, English %d.' % (e.vp('fr'), e.vp('en'))


def VICTORY(e):
    """The French score two for every English step destroyed, the
    king's banner (6) and Maisoncelle (4) if they hold them at the end,
    Henry (8), York (3), Gloucester (2) and the baggage (4); the English
    one for every French step and each great lord (3, or 2).  The French
    must finish THRESHOLD ahead (set from games between computer
    players: ./agincourt --simulate 60)."""
    m = e.vp('fr') - e.vp('en')
    if m >= THRESHOLD + 10:
        return 'fr', ('French victory. %s The English line is broken, '
                      'and the king of England is a prisoner.' % _score(e))
    if m >= THRESHOLD:
        return 'fr', ('French marginal victory. %s The English are thrown '
                      'back on Maisoncelle, and will never see Calais.'
                      % _score(e))
    if m > THRESHOLD - 12:
        return 'en', ('English marginal victory. %s The French draw off '
                      'into the dusk, and the road to Calais is open.'
                      % _score(e))
    return 'en', ('English victory. %s The flower of French chivalry '
                  'lies in heaps in the mud, and the heralds name it the '
                  'battle of Agincourt.' % _score(e))


