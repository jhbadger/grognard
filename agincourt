def _in_mud(e, u):
    return u.hex is not None and e.board.terrain_name(u.hex) == 'mud'


def _stakes(e, a, b):
    side = e.board.river(a, b)
    return bool(side) and side.get('name') == HEXSIDES['stakes']['name']


def COMBAT_SHIFTS(e, target, attackers, support):
    """Stakes, mud and the press:
    - horsemen attacking across the stakes lose another column (the
      stakes themselves cost one);
    - an attack by PRESS units or more loses a column (no room to swing
      a weapon);
    - French men-at-arms who all moved this turn and stand in the mud
      lose a column (winded);
    - arrows shot (with no one attacking) into the mud gain a column;
    - with the king down, the English attack a column worse; with the
      constable dead, the French."""
    out = []
    if e.side == 'fr':
        if any(u.type.get('mounted') and _stakes(e, u.hex, target)
               for u in attackers):
            out.append((-1, 'horses on the stakes'))
        if len(attackers) >= PRESS:
            out.append((-1, 'the press'))
        if attackers and all(u.kind == 'maa' and u.moved and _in_mud(e, u)
                             for u in attackers):
            out.append((-1, 'winded in the mud'))
        if e.flags.get('albret'):
            out.append((-1, 'the constable is dead'))
    else:
        if not attackers and support and \
                e.board.terrain_name(target) == 'mud':
            out.append((1, 'floundering in the mud'))
        if e.flags.get('henry'):
            out.append((-1, 'the king is down'))
    return out


