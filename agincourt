def TURN_NAME(t):
    """Half an hour a turn, from eleven in the morning (11:00 to 2:30:
    no AM or PM, which wouldn't fit on the calendar)."""
    m = 11 * 60 + (t - 1) * 30
    h = m // 60
    return ('25 Oct 1415', '%d:%02d' % ((h - 1) % 12 + 1, m % 60))


