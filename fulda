def u(uid, side, kind, a, d, m, hx, formation, colour, long, **kw):
    spec = dict(id=uid, name=kw.pop('name', uid.upper()), side=side,
                type=kind, size=kw.pop('size', 'III'), a=a, d=d, m=m,
                steps=kw.pop('steps', 2), hex=hx, formation=formation,
                colour=colour, long=long)
    spec.update(kw)
    return spec


def division(prefix, number, formation, colour, kinds, arrive, at):
    """A Soviet division's four regiments, all arriving together."""
    out = []
    for k, kind in enumerate(kinds, 1):
        tank = kind == 'armor'
        out.append(u('%s%d' % (prefix, k), 'wp', kind, 6 if tank else 5,
                     4, 6, None, formation, colour,
                     '%s regiment, %s' % ('A tank' if tank else
                                          'A motor rifle', formation),
                     name='%d/%d' % (number, k), arrive=arrive,
                     at=at[(k - 1) % len(at):] + at[:(k - 1) % len(at)]))
    return out


