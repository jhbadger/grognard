def _poly(p, n, pts, c):
    """Fill a polygon given in fractions of the icon, a row at a time."""
    pts = [(x * n, y * n) for x, y in pts]
    y0 = int(min(y for _, y in pts))
    y1 = int(max(y for _, y in pts)) + 1
    for y in range(y0, y1):
        yc = y + 0.5
        xs = []
        for (ax, ay), (bx, by) in zip(pts, pts[1:] + pts[:1]):
            if (ay <= yc) != (by <= yc):
                xs.append(ax + (yc - ay) * (bx - ax) / (by - ay))
        xs.sort()
        for a, b in zip(xs[::2], xs[1::2]):
            x0, x1 = int(a + 0.5), int(b + 0.5)
            if x1 > x0:
                p.rect(x0, y, x1 - x0, 1, c)


def _star(p, n, cx, cy, r, c):
    import math
    pts = []
    for k in range(10):
        a = -math.pi / 2 + k * math.pi / 5
        rr = r if k % 2 == 0 else r * 0.4
        pts.append((cx + rr * math.cos(a), cy + rr * math.sin(a)))
    _poly(p, n, pts, c)


@grognard.icon('fulda')
def draw_icon(p, n):
    """A Soviet tank in the gap between two dark hills, under a grey
    November sky."""
    p.fill('#b8c0c2')
    p.rect(0, n * 0.3, n, n * 0.3, '#a8b0b2')
    p.disc(n * 0.02, n * 0.74, n * 0.42, '#587448')        # the Vogelsberg
    p.disc(n * 1.0, n * 0.7, n * 0.44, '#4c6640')          # the Rhön
    p.rect(0, n * 0.78, n, n * 0.22, '#8a8458')            # the valley
    ink = '#141a14'
    # tracks and road wheels
    p.rect(n * 0.17, n * 0.7, n * 0.66, n * 0.1, ink)
    p.disc(n * 0.17, n * 0.75, n * 0.05, ink)
    p.disc(n * 0.83, n * 0.75, n * 0.05, ink)
    for k in range(6):
        p.disc(n * (0.22 + k * 0.112), n * 0.755, n * 0.035, '#4a544a')
    # hull, sloped at the front (facing left: west)
    _poly(p, n, [(0.1, 0.62), (0.2, 0.58), (0.88, 0.58), (0.9, 0.66),
                 (0.86, 0.71), (0.16, 0.71)], '#263024')
    # the low, rounded turret and the long gun
    _poly(p, n, [(0.36, 0.58), (0.4, 0.5), (0.48, 0.46), (0.62, 0.46),
                 (0.7, 0.5), (0.72, 0.58)], '#2e3a2a')
    p.line(n * 0.04, n * 0.5, n * 0.4, n * 0.52, '#263024',
           max(2, n // 28))
    _star(p, n, 0.56, 0.525, 0.055, '#d8301e')


