def ON_TURN(e, side):
    if side == 'wp':
        if e.turn == 1:
            e.say('H-hour. The barrage lifts from the border, and the '
                  'first regiments of the 39th Guards come across at '
                  'Rasdorf and Tann.')
        if e.turn == 3:
            e.say('The 79th Guards Tank Division, the second echelon, '
                  'is at the border.')
        if e.turn == 7:
            e.say('The 1st Guards Tank Army is coming up behind the 8th '
                  'Guards Army.')
    else:
        if e.turn == 1:
            e.say('Able Archer is called off. Every unit in V Corps is '
                  'ordered to its war positions, hours too late.')
        if e.turn == 2:
            e.say('The Bundeswehr\'s Panzerbrigade 14 comes down from '
                  'Neustadt, and the rest of the 3rd Armored from '
                  'Friedberg and Kirch-Göns.')
        if e.turn == 5:
            e.say('The 8th Infantry Division is coming up the Kinzig '
                  'from Frankfurt.')


def ON_END_TURN(e):
    """The nuclear threshold.  If the Soviets hold Gelnhausen, or get
    enough of their army off the west edge toward Frankfurt, the Kinzig
    valley is open and NATO must decide whether to use its nuclear
    weapons: the conventional war, and the game, is over."""
    held = e.control.get(grognard.hexgrid.parse(GELNHAUSEN)) == 'wp'
    out = e.exited.get('wp', 0) >= BREAKTHROUGH
    if held or out:
        e.finish('wp', 'Soviet victory: breakthrough. %s The road to '
                 'Frankfurt is open, and SACEUR asks for the release '
                 'of nuclear weapons. The war that was to stay '
                 'conventional is about to end being so. %s'
                 % ('Gelnhausen has fallen.' if held else
                    'Soviet tanks are past Hanau.', _score(e)))


def COMBAT_SHIFTS(e, target, attackers, support):
    """Surprise on the first day; NATO's thermal sights at night; the
    Soviet air offensive on the first day; helicopters can't fly at
    night (CAN_SUPPORT)."""
    out = []
    if not attackers:
        return out
    if e.side == 'wp':
        if e.turn == 1:
            out.append((1, 'surprise and the air offensive'))
        elif night(e):
            out.append((-1, 'NATO thermal sights'))
    return out


def CAN_SUPPORT(e, u):
    """Helicopters fly by day, and not in fog."""
    if u.kind != 'helo':
        return True
    return e.weather()['id'] not in ('night', 'fog')


