def _score(e):
    return 'Soviets %d VP, NATO %d.' % (e.vp('wp'), e.vp('nato'))


def VICTORY(e):
    """Taking Gelnhausen, or getting four steps off the west edge, wins
    at once (ON_END_TURN).  Otherwise the margin decides: each side
    scores the places it holds and the enemy steps it destroys, and the
    Soviets 3 VP a step off the west edge."""
    m = e.vp('wp') - e.vp('nato')
    if m >= MARGIN + 8:
        return 'wp', ('Soviet victory. %s Fulda and the gap are lost, and '
                      'V Corps is broken. NATO must choose between the '
                      'Rhine and the bomb.' % _score(e))
    if m >= MARGIN:
        return 'wp', ('Soviet marginal victory. %s The gap is through, '
                      'but the Kinzig valley holds, for now.' % _score(e))
    if m > MARGIN - 8:
        return 'nato', ('NATO marginal victory. %s V Corps has bent and '
                        'not broken. In Moscow and Washington, someone '
                        'has time to pick up a telephone.' % _score(e))
    return 'nato', ('NATO victory. %s The 8th Guards Army has spent '
                    'itself in the gap, and the war stops short of the '
                    'nuclear threshold.' % _score(e))


