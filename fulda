@grognard.symbol('helo')
def s_helo(p, x, y, w, h, c):
    """Rotary wing: the NATO bow tie."""
    cx, cy = x + (w - 1) / 2, y + (h - 1) / 2
    l, r = x + w // 5, x + w - 1 - w // 5
    t, b = y + h // 4, y + h - 1 - h // 4
    p.line(l, t, r, b, c)
    p.line(l, b, r, t, c)
    p.line(l, t, l, b, c)
    p.line(r, t, r, b, c)
    p.set(cx, cy, c)


