def unit(uid, side, a, d, m, hx, long, colour, formation, steps=2, **kw):
    """A contingent: attack, defence, movement and the hex it starts in
    (None to arrive later, with arrive and at)."""
    spec = dict(id=uid, name=kw.pop('name', uid.upper()), side=side,
                type=kw.pop('type', 'infantry'), size=kw.pop('size', 'III'),
                a=a, d=d, m=m, steps=steps, hex=hx, long=long,
                colour=colour, formation=formation)
    spec.update(kw)
    return spec


def horse(uid, side, a, d, m, hx, long, colour, formation, **kw):
    return unit(uid, side, a, d, m, hx, long, colour, formation,
                type='cavalry', **kw)


def wall(uid, a, d, hx, long, colour, formation, steps=3, **kw):
    """Frankish foot in close order: spears and locked shields (they
    cancel the horsemen's shock, and cavalry alone lose a column against
    them)."""
    return unit(uid, 'fr', a, d, 2, hx, long, colour, formation,
                steps=steps, type='spear', wall=True, **kw)


