def ON_TURN(e, side):
    """The plunder: the first time a Frankish unit stands in the camp,
    at the start of either side's turn, the plunder of Aquitaine is
    scattered and the Franks score PLUNDER VP, whoever holds the camp
    later."""
    if not e.flags.get('plundered') and \
            any(u.side == 'fr' for u in e.at(CAMP)):
        e.flags['plundered'] = True
        e.bonus['fr'] += PLUNDER
        e.say('The Franks are in the camp! The plunder of Aquitaine is '
              'scattered (%d VP).' % PLUNDER)


def ON_ELIMINATE(e, u, where):
    """The emir falls: his army loses heart."""
    if u.id == 'emir':
        e.flags['emir'] = True
        e.say('Abd al-Rahman is dead! The Umayyad army loses heart.')
    elif u.id == 'charles':
        e.flags['charles'] = True
        e.say('Charles has fallen! The Franks waver.')


def COMBAT_SHIFTS(e, target, attackers, support):
    """Horsemen can't break a shield wall: an attack made only by
    cavalry on a hex held by Frankish heavy infantry loses a column.
    With the emir dead the Umayyads attack a column worse; with Charles
    dead, the Franks."""
    out = []
    if e.side == 'um':
        if attackers and all(u.kind == 'cavalry' for u in attackers) and \
                any(u.spec.get('wall') for u in e.at(target, 'fr')):
            out.append((-1, 'shield wall'))
        if e.flags.get('emir'):
            out.append((-1, 'the emir is dead'))
    elif e.flags.get('charles'):
        out.append((-1, 'Charles is dead'))
    return out


