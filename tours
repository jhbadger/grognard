@grognard.icon('tours')
def draw_icon(p, n):
    """A row of round shields and spears on the rise, against an
    evening sky."""
    p.fill('#e8b070')
    p.rect(0, 0, n, n * 0.3, '#c87a4a')
    p.disc(n * 0.5, n * 1.25, n * 0.75, '#6e7a40')
    for k in range(5):
        x = n * (0.14 + k * 0.18)
        p.line(x + n * 0.03, n * 0.12, x + n * 0.03, n * 0.6, '#3a2a1a',
               max(1, n // 48))
        p.rect(x + n * 0.015, n * 0.1, n * 0.03, n * 0.05, '#d8d8d0')
    for k in range(5):
        x = n * (0.14 + k * 0.18)
        p.disc(x, n * 0.62, n * 0.11, '#a8443a')
        p.disc(x, n * 0.62, n * 0.035, '#d8c070')
    p.rect(0, n * 0.82, n, n * 0.18, '#4e5a2a')


