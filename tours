def VICTORY(e):
    """The Umayyads score the crest and Moussais if they hold them at
    the end, one for every step that rides off the north edge for Tours,
    and every Frankish step destroyed (and Charles, 4); the Franks score
    the camp, the plunder if they ever reached it, and every Umayyad step
    (and the emir, 4).  The Umayyads must come out ahead (the margins
    were set from games between computer players: ./tours --simulate
    30)."""
    um, fr = e.vp('um'), e.vp('fr')
    m = um - fr
    score = 'Umayyads %d VP, Franks %d.' % (um, fr)
    if m >= 6:
        return 'um', ('Umayyad victory. %s The Frankish wall breaks, and '
                      'the road to Tours lies open.' % score)
    if m >= 1:
        return 'um', ('Umayyad marginal victory. %s The Franks give '
                      'ground, and Charles must fight again another '
                      'day.' % score)
    if m > -5:
        return 'fr', ('Frankish marginal victory. %s The wall holds, and '
                      'in the night the raiders slip away south.' % score)
    return 'fr', ('Frankish victory. %s The Franks stand like a wall of '
                  'ice; at dawn they find the tents empty, and the '
                  "raiders' power north of the Pyrenees broken." % score)


