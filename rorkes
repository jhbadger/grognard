def unit(uid, side, kind, a, d, hx, formation, colour, long, steps=2,
         **kw):
    spec = dict(id=uid, name=kw.pop('name', uid.upper()), side=side,
                type=kind, size=kw.pop('size', 'I'), a=a, d=d,
                m=kw.pop('m', 3), steps=steps, hex=hx,
                formation=formation, colour=colour, long=long)
    spec.update(kw)
    return spec


def impi(uid, hx, colour, regiment, long, arrive=None, at=None, **kw):
    return unit(uid, 'zu', 'impi', kw.pop('a', 3), kw.pop('d', 2), hx,
                regiment, colour, long, steps=kw.pop('steps', 3), m=5,
                size='II', arrive=arrive, at=at, **kw)


