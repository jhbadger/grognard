class Dabulamanzi(ai.AI):
    """The stock computer player, with sense about fire: the British get
    out of a burning hospital, the sick first."""

    def score(self, u, h):
        s = super().score(u, h)
        if self.side == 'br':
            if h in HOSPITAL and self.e.flags.get('fire'):
                s -= 50
            if u.id == PATIENTS:
                s += 3 * (5 - min(hexgrid.distance(h, x) for x in
                             (hexgrid.parse('1005'), hexgrid.parse('1006'))))
        return s


