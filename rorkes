def dark(e, h):
    """Night, and too far from the burning hospital to see by."""
    if e.weather()['id'] != 'night':
        return False
    if e.flags.get('fire'):
        return min(hexgrid.distance(h, x) for x in HOSPITAL) > LIGHT
    return True


def burning(e, h):
    return e.flags.get('fire') and h in HOSPITAL


def ENTER_COST(e, unit, a, b, cost):
    """No one goes into the hospital once its roof is alight.  The sick,
    once carried out, stay behind the biscuit boxes."""
    if burning(e, b):
        return None
    if getattr(unit, 'id', None) == PATIENTS and b not in STORE:
        return None
    return cost


def volleys(e):
    """At the start of each Zulu turn, every Zulu unit within 2 hexes of
    a British rifle section, outside the bush, is fired on: it loses a
    step on a 1 or 2 (a 1 in the dark, away from the firelight).  Each
    unit fired on costs a box of cartridges."""
    rifles = [u.hex for u in e.alive('br') if u.kind == 'redcoats']
    hits = 0
    for z in e.alive('zu'):
        if e.flags['ammo'] <= 0:
            break
        if not e.board.terrain(z.hex).get('los', True):
            continue
        if not any(hexgrid.distance(z.hex, r) <= VOLLEY for r in rifles):
            continue
        e.flags['ammo'] -= 1
        if e.rng.randint(1, 6) <= (1 if dark(e, z.hex) else 2):
            e.take_losses([z], 1)
            hits += 1
    if hits:
        e.say('Volleys from the barricade: the Zulus lose %d step%s.'
              % (hits, '' if hits == 1 else 's'))


def carry_out(e):
    """Once the Zulus are at the hospital walls (or the roof is alight),
    Hook and Williams hack holes through the inner walls and pass the
    sick out of a window: at the start of each British turn the sick in
    the hospital move to a free yard hex next to them, if there is
    one."""
    sick = e.units[PATIENTS]
    if not sick.alive or sick.hex not in HOSPITAL:
        return
    if not e.flags.get('fire') and not any(
            e.at(n, 'zu') for h in HOSPITAL for n in hexgrid.neighbours(h)):
        return
    for n in STORE + sorted(INSIDE - WEST - set(STORE)):
        if not e.at(n, 'zu') and e.room(n, sick):
            sick.hex = n
            e.changed()
            e.say('Private Hook and Private Williams hack through the '
                  'inner walls with a pick; the sick are passed out of a '
                  'window and carried across the yard, under fire, to the '
                  'storehouse.')
            return
    e.say('The sick are trapped in the hospital: there is no room for '
          'them behind the biscuit boxes.')


def ON_TURN(e, side):
    f = e.flags
    f.setdefault('ammo', AMMO)
    if side == 'zu':
        if e.turn == 1:
            e.say("Captain Stephenson's company of the Natal Native "
                  'Contingent climbs the barricade and runs; a corporal '
                  'is shot as he goes. The wall is too long for the men '
                  'left: Chard starts a line of biscuit boxes across the '
                  'yard.')
        if f.get('fire'):
            for u in [u for u in e.alive('br') if u.hex in HOSPITAL]:
                e.say('The roof falls in on %s.' % u.long)
                e.take_losses([u], 1)
        volleys(e)
        if not f.get('fire') and e.turn >= FIRE_FROM and \
                any(n in HOSPITAL for z in e.alive('zu')
                    for n in hexgrid.neighbours(z.hex)):
            f['fire'] = True
            e.say('The Zulus set the hospital thatch alight. Anyone left '
                  'inside at the start of the next Zulu turn will be '
                  'caught in it; but the blaze lights the ground round '
                  'the station.')
    else:
        carry_out(e)
        if f['ammo'] <= 0 and not f.get('dry'):
            f['dry'] = True
            e.say('The last box of cartridges is broken open. From now on '
                  'it is the bayonet.')
        else:
            e.say('Boxes of cartridges left: %d.' % max(0, f['ammo']))
        if e.turn == TURNS:
            e.say('Dawn. The Zulus are drawing off over Shiyane, and on '
                  "the far side of the river Chelmsford's column is in "
                  'sight.')
    if not e.alive('br'):
        e.finish('zu', 'Zulu victory. The station is taken and burned, '
                       'and no one is left alive to tell of it.')


def ON_ELIMINATE(e, u, where):
    if u.id in LEADERS:
        e.say('%s is killed. The men at the wall waver.' % u.long)
    elif u.id == PATIENTS:
        e.say('The last of the sick are lost.')


def COMBAT_SHIFTS(e, target, attackers, support):
    """An officer in the hex attacked costs the Zulus a column, and one
    leading an attack gains the British one.  Zulu attacks in the dark,
    away from the firelight, lose a column; once the cartridges are gone
    they gain one."""
    out = []
    if e.side == 'zu':
        if any(u.id in LEADERS for u in e.at(target, 'br')):
            out.append((-1, 'officers'))
        if attackers and dark(e, target):
            out.append((-1, 'darkness'))
        if e.flags.get('ammo', AMMO) <= 0:
            out.append((1, 'no cartridges'))
    elif any(u.id in LEADERS for u in attackers) and len(attackers) > 1:
        out.append((1, 'officers'))
    return out


