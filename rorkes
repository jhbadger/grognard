@grognard.icon('rorkes')
def draw_icon(p, n):
    """The station at night: the burning hospital roof behind a wall of
    mealie bags."""
    p.fill('#1e2438')
    p.disc(n * 0.5, n * 1.3, n * 0.75, '#4a4a2a')
    p.rect(n * 0.22, n * 0.42, n * 0.56, n * 0.26, '#c8b490')
    for i in range(6):
        p.disc(n * (0.28 + i * 0.09), n * (0.38 - (i % 2) * 0.05),
               n * 0.07, '#e8742a')
        p.disc(n * (0.28 + i * 0.09), n * (0.33 - (i % 2) * 0.05),
               n * 0.04, '#f8c84a')
    for i in range(5):
        p.rect(n * (0.08 + i * 0.17), n * 0.7, n * 0.15, n * 0.08,
               '#e0d4a8')
        p.rect(n * (0.16 + i * 0.17), n * 0.79, n * 0.15, n * 0.08,
               '#d0c498')
    p.rect(n * 0.46, n * 0.52, n * 0.06, n * 0.12, '#b0302a')


