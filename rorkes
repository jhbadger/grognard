def TURN_NAME(t):
    """An hour a turn, from half past four."""
    m = 16 * 60 + 30 + (t - 1) * 60
    day = '22 Jan 1879' if m < 24 * 60 else '23 Jan 1879'
    m %= 24 * 60
    return (day, '%d:%02d %s' % ((m // 60 - 1) % 12 + 1, m % 60,
                                 'AM' if m < 12 * 60 else 'PM'))


