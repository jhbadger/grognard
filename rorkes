def _sides(a_set, b_set):
    """Every hexside between a hex of a_set and one of b_set."""
    out = []
    for a in sorted(a_set):
        for n in hexgrid.neighbours(a):
            if n in b_set and 0 <= n[0] < 16 and 0 <= n[1] < len(MAP):
                out.append('%s/%s' % (hexgrid.hid(a), hexgrid.hid(n)))
    return out


def _outside():
    return {(c, r) for r in range(len(MAP)) for c in range(16)} - INSIDE


