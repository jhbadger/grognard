@grognard.symbol('leader')
def s_leader(p, x, y, w, h, c):
    """An officer: a five-pointed star."""
    import math
    cx, cy = x + (w - 1) / 2, y + (h - 1) / 2
    r = max(2, min(w, h) / 2 - 1)
    pts = []
    for i in range(10):
        a = -math.pi / 2 + i * math.pi / 5
        rr = r if i % 2 == 0 else r * 0.42
        pts.append((cx + rr * math.cos(a), cy + rr * math.sin(a)))
    for i in range(10):
        (x0, y0), (x1, y1) = pts[i], pts[(i + 1) % 10]
        p.line(x0, y0, x1, y1, c)


@grognard.symbol('patients')
def s_patients(p, x, y, w, h, c):
    """The sick: a cross."""
    cx, cy = x + (w - 1) / 2, y + (h - 1) / 2
    r = max(2, min(w, h) // 2 - 1)
    for k in (-1, 0, 1):
        p.line(cx - r, cy + k, cx + r, cy + k, c)
        p.line(cx + k, cy - r, cx + k, cy + r, c)


@grognard.symbol('shield')
def s_shield(p, x, y, w, h, c):
    """Zulu warriors: a tall cowhide shield with a spear behind it."""
    cx, cy = x + (w - 1) / 2, y + (h - 1) / 2
    p.oval(cx, cy, max(1.5, w / 6), max(2, h / 2 - 1), c)
    p.line(cx, y, cx, y + h - 1, c)
    p.line(x + 1, y + h - 1, x + w - 2, y, c)


