def VICTORY(e):
    """The Zulus score the ground they hold and British losses, the
    British Zulu losses.  The Zulus win outright with the storehouse;
    otherwise the British must finish WIN ahead (set from games between
    computer players: ./rorkes --simulate 60)."""
    zu, br = e.vp('zu'), e.vp('br')
    m = br - zu
    score = 'Zulus %d VP, British %d.' % (zu, br)
    if e.control.get(hexgrid.parse('1005')) == 'zu' or m <= -WIN_BIG:
        return 'zu', ('Zulu victory. %s The storehouse is taken, and the '
                      'way into Natal is open.' % score)
    if m < WIN:
        return 'zu', ('Zulu marginal victory. %s The barricade is broken, '
                      'and the survivors hold out in the storehouse.'
                      % score)
    if m < WIN_BIG:
        return 'br', ('British marginal victory. %s The station holds, but '
                      'few of its defenders are left on their feet.'
                      % score)
    sick = e.units[PATIENTS].alive
    return 'br', ('British victory. %s The station holds%s. Eleven '
                  'Victoria Crosses will be given for this night.'
                  % (score, ', and the sick are saved' if sick else ''))


