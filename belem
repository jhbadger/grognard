def unit(uid, side, a, d, hx, long, colour, steps=2, m=3, **kw):
    """A company: attack, defence, and the hex it starts in (None to
    arrive later, with arrive and at)."""
    spec = dict(id=uid, name=kw.pop('name', uid.upper()), side=side,
                type=kw.pop('type', 'infantry'), size=kw.pop('size', 'I'),
                a=a, d=d, m=m, steps=steps, hex=hx, long=long,
                colour=colour)
    spec.update(kw)
    return spec


def guns(uid, side, a, rng, hx, long, colour, m=2, **kw):
    return unit(uid, side, a, 2, hx, long, colour, steps=1, m=m,
                type='artillery', range=rng, size='***', **kw)


def third(k, name):
    """A company of the third regiment, in two copies: one for each side
    it might come out for (see ON_TURN)."""
    out = []
    for side, colour in (('pat', PAT), ('pt', PT)):
        out.append(unit('r3%d_%s' % (k, side), side, 3, 3, None,
                        '%s company of the 3rd regiment' % name, colour,
                        name='3/%s' % name[0], arrive=99, at='1105',
                        regular=side == 'pt', formation='3rd regiment'))
    return out


