def ON_TURN(e, side):
    """The third regiment wavers.  On each of turns 2 to 4, at the start
    of the Patriots' turn, one of its companies turns out: for the
    Patriots with a chance of one in four, and one more in four for each
    of the artillery park and the Largo das Mercês they hold, one fewer
    if a Loyalist unit stands next to the barracks.  Otherwise it turns
    out for the governor, at the start of the Loyalists' turn."""
    if side != 'pat' or e.turn not in WAVER:
        return
    k = WAVER.index(e.turn)
    pat, pt = e.units['r3%d_pat' % k], e.units['r3%d_pt' % k]
    if pat.status != 'pending' or pt.status != 'pending':
        return
    chance = 1 + sum(e.control.get(h) == 'pat' for h in (PARK, MERCES))
    if any(u.side == 'pt' for n in hexgrid.neighbours(QUARTEL3)
           for u in e.at(n)):
        chance -= 1
    if e.rng.random() * 4 < chance:
        pat.arrive = e.turn
        e.say('%s turns out for Dom Pedro!' % pat.long)
        e.arrivals('pat')
    else:
        pt.arrive = e.turn
        e.say('%s stays loyal to the King.' % pt.long)


def COMBAT_SHIFTS(e, target, attackers, support):
    """In the dark nobody knows who is friend and who is foe: attacks
    before first light lose a column.  Rebels attacking their own
    officers hesitate: a Patriot attack on a hex with a Loyalist
    regiment in it loses a column until full daylight (Boaventura told
    his men to hold their fire)."""
    out = []
    if e.weather()['id'] == 'night':
        out.append((-1, 'darkness'))
    elif e.side == 'pat' and e.weather()['id'] == 'dawn' and \
            any(u.spec.get('regular') for u in e.at(target)):
        out.append((-1, 'hold your fire'))
    return out


