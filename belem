@grognard.icon('belem')
def draw_icon(p, n):
    """A rocket bursting over the walls of the artillery park, and a gun
    in the gateway."""
    import math
    p.fill('#1e2a48')
    for x, y, c in ((0.3, 0.2, '#f4d860'), (0.7, 0.16, '#7ccc6a'),
                    (0.52, 0.3, '#f8f0c0')):
        for k in range(8):
            a = k * math.pi / 4
            p.line(n * x, n * y, n * (x + math.cos(a) * 0.1),
                   n * (y + math.sin(a) * 0.1), c, max(1, n // 40))
    p.rect(0, n * 0.55, n, n * 0.45, '#c4b496')
    for k in range(6):
        p.rect(n * (0.02 + k * 0.17), n * 0.49, n * 0.1, n * 0.07,
               '#c4b496')
    p.rect(n * 0.34, n * 0.66, n * 0.32, n * 0.34, '#3a2a1a')
    p.rect(n * 0.36, n * 0.76, n * 0.3, n * 0.06, '#1a1a1a')
    p.disc(n * 0.44, n * 0.88, n * 0.07, '#6a4a2a')
    p.rect(n * 0.0, n * 0.95, n, n * 0.05, '#7a6a50')


