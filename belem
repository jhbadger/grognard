def VICTORY(e):
    """What the plotters wanted was the province.  The palace or the fort
    in Patriot hands at the end is a Patriot victory: the junta gives way
    and Pará declares for Dom Pedro four months early.  The park and the
    Largo das Mercês both held is a marginal one: the governor has to
    treat.  One of them a Loyalist marginal victory, and neither (what
    happened) a Loyalist victory."""
    pat, pt = e.vp('pat'), e.vp('pt')
    score = 'Patriots %d VP, Loyalists %d.' % (pat, pt)
    ctl = e.control.get
    if ctl(PALACE) == 'pat' or ctl(FORT) == 'pat':
        return 'pat', ('Patriot victory. %s The junta gives way, and Pará '
                       'declares for Dom Pedro.' % score)
    held = [h for h in (PARK, MERCES) if ctl(h) == 'pat']
    if len(held) == 2:
        return 'pat', ('Patriot marginal victory. %s The rising holds out, '
                       'and the governor must treat with it.' % score)
    if held:
        return 'pt', ('Loyalist marginal victory. %s The rising is broken, '
                      'though not yet beaten.' % score)
    return 'pt', ('Loyalist victory. %s The rising is crushed; its '
                  'leaders are taken, to be shipped to Lisbon.' % score)


