def _score(e):
    return 'British %d VP, Germans %d.' % (e.vp('br'), e.vp('de'))


def VICTORY(e):
    """The British score Tanga (8) and the station (4) if they hold
    them at the end, and every German step destroyed; the Germans every
    British step.  The British must finish THRESHOLD ahead (set from
    games between computer players: ./tanga --simulate 60)."""
    m = e.vp('br') - e.vp('de')
    if m >= THRESHOLD + 8:
        return 'br', ('British victory. %s Tanga is taken, and the '
                      'railway into the highlands lies open.' % _score(e))
    if m >= THRESHOLD:
        return 'br', ('British marginal victory. %s The British hold a '
                      'foothold in the town, but Lettow-Vorbeck holds the '
                      'railway.' % _score(e))
    if m > THRESHOLD - 8:
        return 'de', ('German marginal victory. %s In the night Aitken '
                      'orders the force back to the ships.' % _score(e))
    return 'de', ('German victory. %s The expedition flees to the beach, '
                  'leaving its rifles, its machine guns and its wounded, '
                  'and Lettow-Vorbeck arms his askari with them.'
                  % _score(e))


