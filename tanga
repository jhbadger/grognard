@grognard.symbol('mg')
def s_mg(p, x, y, w, h, c):
    """Machine guns: the infantry cross and a gun barrel under it."""
    p.line(x, y, x + w - 1, y + h - 1, c)
    p.line(x, y + h - 1, x + w - 1, y, c)
    p.rect(x + w // 4, y + h // 2 - 1, w // 2, 2, c)


@grognard.symbol('ship')
def s_ship(p, x, y, w, h, c):
    """A cruiser: a long hull, a deckhouse and two funnels."""
    base = y + h - 3
    p.rect(x + 1, base, w - 2, 2, c)
    p.rect(x + w // 3, base - h // 4, w // 3, h // 4, c)
    for k in (0.42, 0.58):
        p.rect(int(x + (w - 1) * k), base - h // 2, 1, h // 4, c)


