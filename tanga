# -------------------------------------------------------------- the bees

def SETUP(e):
    """Hide the hives: a few plantation and bush hexes, dealt out
    afresh each game, that neither side can see."""
    spots = [h for h in sorted(e.board.hexes)
             if e.board.terrain_name(h) in ('plantation', 'bush')]
    e.flags['hives'] = [hexgrid.hid(h) for h in e.rng.sample(spots, HIVES)]


def _swarm(e, at):
    """The bees come out: every unit in the hex and next to it is stung
    and scatters (it can't move or fight until the end of its next
    turn), and shaky troops may run."""
    hit = [u for u in e.alive()
           if hexgrid.distance(u.hex, at) <= 1]
    for u in hit:
        u.disabled = True
        u.recovering = False
        u.mp = 0
    e.events.append(('sound', 'bees'))
    e.events.append(('popup', at, 'Bees!', (240, 200, 40)))
    e.say('The bees! A swarm pours out of the trees at %s, and friend '
          'and foe alike throw down their rifles and run.' % e.place(at))
    for u in hit:
        if u.side == 'br' and u.type.get('shaky') and \
                e.rng.randint(1, 6) <= SHAKY_PANIC:
            e.take_losses([u], 1)
            if u.alive:
                e.say('%s break and run for the beach.' % u.long)


def ON_MOVE(e, u, path):
    """Moving into a hidden hive may rouse it."""
    hives = e.flags.get('hives', [])
    for h in path[1:]:
        k = hexgrid.hid(h)
        if k in hives and e.rng.randint(1, 3) <= STING:
            hives.remove(k)
            _swarm(e, h)
            return


def ON_TURN(e, side):
    """The hours of the afternoon."""
    if side == 'br' and e.turn == 1:
        e.say('Noon. The whole force goes forward from Ras Kasone into '
              'the plantations.')
    elif side == 'de' and e.turn == 1:
        e.say('Lettow-Vorbeck rides his bicycle along the railway '
              'cutting, listening for the trains.')
    elif side == 'de' and e.turn == 7:
        e.say('Dusk. Lettow-Vorbeck orders the bugles to sound the '
              'charge all along the line.')


def ON_ELIMINATE(e, u, where):
    if u.id == 'lettow':
        e.flags['lettow'] = True
        e.say('Lettow-Vorbeck is down! The askari fight on alone.')
    elif u.id == 'fox':
        e.say('The Fox is hit and stands out to sea.')


def COMBAT_SHIFTS(e, target, attackers, support):
    """Bush fighting:
    - an attack made only by shaky battalions loses a column;
    - the Loyal North Lancs and the Kashmiris gain one in the town
      (they fight house to house);
    - at dusk and after, the Germans gain a column (the charge);
    - with Lettow-Vorbeck down they lose one."""
    out = []
    if e.side == 'br':
        if attackers and all(u.type.get('shaky') for u in attackers):
            out.append((-1, 'shaky troops'))
        if attackers and e.board.terrain_name(target) in ('town', 'city') \
                and any(u.spec.get('steady') for u in attackers):
            out.append((1, 'house to house'))
    else:
        if attackers and e.turn >= 7:
            out.append((1, 'the charge'))
        if e.flags.get('lettow'):
            out.append((-1, 'Lettow-Vorbeck is down'))
    return out


