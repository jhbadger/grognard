@grognard.icon('tanga')
def draw_icon(p, n):
    """A swarm of bees over the bush, and the sea beyond."""
    p.fill('#e8d8a0')
    p.rect(0, n * 0.28, n, n * 0.1, '#3a7aa8')
    p.rect(0, n * 0.38, n, n * 0.62, '#6e8a44')
    for k in range(6):
        p.disc(n * (0.1 + k * 0.17), n * 0.5, n * 0.11, '#56702e')
    p.rect(0, n * 0.78, n, n * 0.22, '#465e28')
    import math
    for k in range(14):
        a = k * 2.4
        x = n * (0.5 + 0.28 * math.cos(a) * (0.4 + (k % 5) * 0.15))
        y = n * (0.55 + 0.2 * math.sin(a) * (0.4 + (k % 4) * 0.18))
        p.disc(x, y, max(1, n * 0.03), '#f0b820')
        p.rect(x - n * 0.012, y - n * 0.008, n * 0.024, n * 0.016,
               '#2a2010')


