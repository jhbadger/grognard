def _cutting():
    """The railway cutting in front of the town: every side between the
    sixth column and the seventh, from the harbour south."""
    out = []
    for r in range(1, 9):
        for n in hexgrid.neighbours((5, r)):
            if n[0] == 6 and 1 <= n[1] <= 8:
                out.append('%s/%s' % (hexgrid.hid((5, r)), hexgrid.hid(n)))
    return out


