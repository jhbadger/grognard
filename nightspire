def u(uid, side, a, d, m, hx, kind, formation, colour, long, **kw):
    spec = dict(id=uid, name=kw.pop('name', uid.upper()), side=side,
                type=kind, a=a, d=d, m=m, steps=kw.pop('steps', 2),
                hex=hx, formation=formation, colour=colour, long=long)
    spec.update(kw)
    return spec


def hero(uid, side, d, m, hx, lead, colour, long, **kw):
    return u(uid, side, 0, d, m, hx, kw.pop('type', 'hero'),
             kw.pop('formation', 'Heroes'), colour, long, steps=1,
             lead=lead, **kw)


