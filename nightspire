@grognard.icon('nightspire')
def draw_icon(p, n):
    """A sheep on a green hill before a black tower under a purple sky."""
    p.fill('#4a3a6a')
    p.disc(n * 0.8, n * 0.2, n * 0.08, '#e8e0c0')          # the moon
    p.rect(n * 0.52, n * 0.18, n * 0.2, n * 0.6, '#16121c')  # the tower
    for i in range(3):
        p.rect(n * (0.52 + i * 0.075), n * 0.12, n * 0.05, n * 0.07,
               '#16121c')
    p.rect(n * 0.6, n * 0.32, n * 0.04, n * 0.06, '#e0c040')
    p.disc(n * 0.5, n * 1.25, n * 0.62, '#5a8a40')          # the hill
    for x, y in ((0.26, 0.66), (0.36, 0.62), (0.44, 0.68), (0.32, 0.74),
                 (0.22, 0.74), (0.42, 0.76)):
        p.disc(n * x, n * y, n * 0.09, '#f2eee2')           # wool
    p.disc(n * 0.52, n * 0.62, n * 0.07, '#26202a')         # head
    for x in (0.24, 0.3, 0.38, 0.44):
        p.rect(n * x, n * 0.8, n * 0.03, n * 0.1, '#26202a')


