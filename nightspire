# ------------------------------------------------------ the computer

class Host(ai.AI):
    """The stock computer player, with heroes who keep with the
    strongest stack near the fighting (the Witch-King stays home),
    sheep who look for an escort on the way west, and sorcerers who
    cast once everyone has moved."""

    def begin(self):
        super().begin()
        self.declined = set()

    def next_move(self):
        act = super().next_move()
        if act == ('end',) and self.e.phase == 'move':
            c = self.next_cast()
            if c:
                return c
        return act

    def next_cast(self):
        e = self.e
        for uid in sorted(CASTERS):
            u = e.units[uid]
            if u.side != self.side or not u.alive or uid in self.declined \
                    or has_cast(e, uid):
                continue
            self.declined.add(uid)
            best = self.spell_for(u)
            if best is None:
                continue
            key, t = best
            if t is not None:
                e.flags.setdefault('aim', {})[uid] = t.id
            for label, k, why in e.actions(u):
                if k == key and not why:
                    return ('act', uid, key)
        return None

    def spell_for(self, u):
        e = self.e
        p = power(e, u.id)
        spells = CASTERS[u.id]['spells']
        best = None
        for t in targets(e, u):
            d = distance(u.hex, t.hex)
            for k in ('sheep', 'bolt'):
                sp = SPELLS[k]
                if k not in spells or p < sp['cost'] or d > sp['range']:
                    continue
                chance = (7 - need(e, u, t, k)) / 6.0
                if k == 'sheep':
                    v = worth(t) * chance
                else:
                    v = chance * (1.5 + (8 if t.kind in HEROES and
                                         t.steps == 1 else 0))
                    if 'sheep' in spells and p - 1 < SPELLS['sheep']['cost']\
                            and p >= SPELLS['sheep']['cost']:
                        v -= 1.5            # don't spend the sheep's power
                if best is None or v > best[0]:
                    best = (v, k, t)
        if 'raise' in spells and p >= SPELLS['raise']['cost'] and \
                e.flags.get('raised', 0) < RAISE_MAX and \
                raise_hex(e, u) is not None:
            v = 2.0 - (1.5 if targets(e, u) else 0)
            if best is None or v > best[0]:
                best = (v, 'raise', None)
        if best is None or best[0] < 1.0:
            return None
        return best[1], best[2]

    def score(self, u, h):
        e = self.e
        if u.kind in HEROES:
            return self.hero_score(u, h)
        s = super().score(u, h)
        if u.kind == 'sheep':
            # west, with an escort, and away from the wolves
            s -= h[0] * 1.5
            if any(x.attack > 0 and not x.supports for x in e.at(h, u.side)
                   if x is not u):
                s += 6
        return s

    def hero_score(self, u, h):
        e = self.e
        if u.id == KING:
            return -distance(h, parse(CITADEL)) * 6 + (0.3 if h == u.hex
                                                        else 0)
        friends = [x for x in e.at(h, u.side) if x is not u and
                   x.attack > 0 and not x.supports and
                   x.kind not in HEROES]
        strength = sum(x.attack for x in friends)
        s = min(strength, 16) * 0.5 if friends else -25 - \
            self.threat.get(h, 0) * 0.1
        known = [k for _, k in self.enemies()]
        d = min([distance(h, k) for k in known] or [12])
        if u.id in CASTERS:
            s += 6 if 2 <= d <= 3 else 3 if d == 1 else -d
        else:
            s += 6 if d == 1 else -d
        s -= e.board.terrain(h).get('shift', 0)
        if h == u.hex:
            s += 0.3
        return s


