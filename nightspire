def fate_of(e, s):
    if s.status == 'dead':
        return 'eaten'
    if s.status == 'exited':
        return 'safe'
    if s.status == 'gone':
        return 'restored'
    return 'grazing'


def epilogue(e):
    """What became of the sheep, and of the Witch-King."""
    flock = [u for u in e.units.values() if u.kind == 'sheep']
    lines = []
    plain = [s for s in flock if s.spec['was'] not in SHEEP_TALES]
    if plain:
        n = {}
        for s in plain:
            f = fate_of(e, s)
            n[f] = n.get(f, 0) + 1
        bits = []
        for f, words in (('safe', 'driven to safety'),
                         ('eaten', 'eaten'),
                         ('restored', 'turned back'),
                         ('grazing', 'still grazing')):
            if n.get(f):
                bits.append('%d %s' % (n[f], words))
        lines.append('%d regiment%s became sheep: %s.' % (
            len(plain), '' if len(plain) == 1 else 's', ', '.join(bits)))
    for s in flock:
        tale = SHEEP_TALES.get(s.spec['was'])
        if tale:
            lines.append(tale[fate_of(e, s)])
    if e.flags.get('king_dead'):
        lines.append('Malgrith the Witch-King is dead.')
    elif e.units[KING].alive:
        lines.append('Malgrith the Witch-King still watches from his '
                     'tower.')
    return ' '.join(lines)


def VICTORY(e):
    """The margin decides: each side scores the enemy steps it
    destroys, the places it holds, sheep (eaten for the Dark Host,
    saved for the Alliance) and heroes slain; the Witch-King is worth
    10 to whoever kills him.  The Dark Host must finish MARGIN ahead
    (set from ./nightspire --simulate 60)."""
    m = e.vp('wk') - e.vp('al')
    if m >= MARGIN + 10:
        w, t = 'wk', 'Dark victory. The Alliance is broken.'
    elif m >= MARGIN:
        w, t = 'wk', ('Dark marginal victory. The Alliance falls back on '
                      'Aldermere to count its dead, and its sheep.')
    elif m > MARGIN - 10:
        w, t = 'al', ('Allied marginal victory. Nightspire still stands, '
                      'but its horde is spent.')
    else:
        w, t = 'al', 'Allied victory. The Dark Host is broken.'
    return w, '%s %s %s' % (t, _score(e), epilogue(e))


