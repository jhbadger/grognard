# ----------------------------------------------------------------- spells
# A sorcerer casts at most one spell a turn, in the movement phase, at
# an enemy unit his side can see.  Power comes back a point a turn.

SPELLS = {
    'sheep': dict(name='Sheep', cost=3, need=4, range=3),
    'bolt':  dict(name='Bolt', cost=1, need=4, range=2),
    'raise': dict(name='Raise', cost=3),
}
RAISE_MAX = 3               # bands of the dead raised in a game, at most
CASTERS = {
    'malgrith':   dict(power=6, spells=['sheep', 'bolt', 'raise'], need=-1),
    'vesska':     dict(power=3, spells=['sheep', 'bolt']),
    'morrowgast': dict(power=3, spells=['sheep', 'raise']),
}
HEROES = ('hero', 'mage')


def power(e, uid):
    return e.flags.setdefault('power', {}).get(uid, CASTERS[uid]['power'])


def spend(e, uid, n):
    e.flags.setdefault('power', {})[uid] = power(e, uid) - n
    e.flags.setdefault('cast', {})[uid] = e.turn


def has_cast(e, uid):
    return e.flags.get('cast', {}).get(uid) == e.turn


def worth(t):
    """How much the Witch-King would like to see t become a sheep."""
    return (t.attack + t.defense) * t.steps / 2.0 + \
        (8 if t.kind in HEROES else 0)


def targets(e, u):
    """Enemy units u's side can see within 3 hexes of u, nearest first
    (sheep are not worth a spell)."""
    seen = e.visible(u.side)
    out = [t for t in e.alive() if t.side != u.side and t.kind != 'sheep'
           and t.id in seen and distance(u.hex, t.hex) <= 3]
    out.sort(key=lambda t: (distance(u.hex, t.hex), t.id))
    return out


def aimed(e, u, ts):
    """The target u's spells are aimed at: the one chosen, or the one
    most worth it."""
    want = e.flags.get('aim', {}).get(u.id)
    for t in ts:
        if t.id == want:
            return t
    return max(ts, key=lambda t: (worth(t), t.id)) if ts else None


def called(t):
    """A unit as the log names it: 'Prince Aldric of Aldermere', 'the
    Knights of the Silver Lance', 'the King's Spears'."""
    if t.kind in HEROES:
        return t.long
    return 'the ' + (t.long[4:] if t.long.startswith('The ') else t.long)


def warded(e, t):
    w = e.units.get(WARDEN)
    return bool(w and w.alive and distance(w.hex, t.hex) <= 2)


def need(e, caster, t, spell):
    """The roll a spell needs: 4 or more on a die; the Witch-King 3;
    one more near Elowen."""
    n = SPELLS[spell]['need'] + CASTERS[caster.id].get('need', 0)
    if warded(e, t):
        n += 1
    return max(2, min(6, n))


def raise_hex(e, u):
    """Where the dead would rise for u: its own hex or one next to it
    with room, not next to the enemy if it can help it."""
    from grognard.units import Unit
    probe = Unit(dict(id='?', side=u.side, type='skeleton'), e.types)
    eh = e.enemy_hexes(u.side)
    cands = [u.hex] + [n for n in neighbours(u.hex) if e.board.on_map(n)
                       and e.enter_cost(probe, u.hex, n) is not None]
    ok = [h for h in cands if h not in eh and e.room(h, probe)]
    ok.sort(key=lambda h: (any(n in eh for n in neighbours(h)), h != u.hex,
                           h))
    return ok[0] if ok else None


def ACTIONS(e, u):
    if u.id not in CASTERS or e.phase != 'move':
        return []
    ts = targets(e, u)
    t = aimed(e, u, ts)
    p = power(e, u.id)
    out = [('Power %d/%d' % (p, CASTERS[u.id]['power']), 'power',
            'power comes back a point a turn'),
           ('At: %s' % t.name if t else 'No target', 'aim',
            None if len(ts) > 1 else 'nothing else in reach' if ts else
            'no enemy in sight within 3 hexes')]
    for k in CASTERS[u.id]['spells']:
        sp = SPELLS[k]
        why = None
        if has_cast(e, u.id):
            why = 'has cast a spell this turn'
        elif p < sp['cost']:
            why = 'needs %d power, has %d' % (sp['cost'], p)
        elif k == 'raise':
            if e.flags.get('raised', 0) >= RAISE_MAX:
                why = 'the barrows are empty'
            elif raise_hex(e, u) is None:
                why = 'no room for the dead to rise'
        elif t is None:
            why = 'no enemy in sight within 3 hexes'
        elif distance(u.hex, t.hex) > sp['range']:
            why = 'out of range: %d hexes' % sp['range']
        out.append(('%s (%d)' % (sp['name'], sp['cost']), k, why))
    return out


def ACT(e, u, key):
    ts = targets(e, u)
    t = aimed(e, u, ts)
    if key == 'aim':
        i = ts.index(t)
        t = ts[(i + 1) % len(ts)]
        e.flags.setdefault('aim', {})[u.id] = t.id
        e.say('%s turns to %s at %s, %d hexes off (needs %d+).' % (
            u.name.title(), called(t), e.place(t.hex), distance(u.hex, t.hex),
            need(e, u, t, 'sheep')), u.side)
        return
    sp = SPELLS[key]
    spend(e, u.id, sp['cost'])
    e.events.append(('sound', 'spell'))
    if key == 'raise':
        h = raise_hex(e, u)
        e.flags['raised'] = e.flags.get('raised', 0) + 1
        r = e.spawn(dict(side=u.side, type='skeleton', name='RISEN',
                         long='Risen dead of the Ash Wastes', a=3, d=3,
                         m=3, steps=2, hex=hid(h), colour=UNDEAD,
                         formation='The risen dead', posture='attack'))
        r.mp = 0
        r.attacked = True
        e.say('%s raises the dead: skeletons climb out of the ash at %s.'
              % (u.long, e.place(h)))
        e.events.append(('popup', h, 'risen', '#c0c8e0'))
        return
    roll = e.rng.randint(1, 6)
    n = need(e, u, t, key)
    t.seen = True
    if roll < n:
        e.say('%s casts %s at %s: rolled %d, needed %d. The spell '
              'fails.' % (u.long, sp['name'].lower(), called(t), roll, n))
        e.events.append(('popup', t.hex, 'resisted', '#c0c0ff'))
        return
    if key == 'bolt':
        e.say('%s hurls a bolt of black fire at %s (rolled %d).'
              % (u.long, called(t), roll))
        e.events.append(('popup', t.hex, 'blasted', '#ff80ff'))
        e.take_losses([t], 1)
        return
    e.say('%s casts the sheep spell at %s (rolled %d).' % (
        u.long, called(t), roll))
    ovinate(e, t)


FATES = ['is eaten', 'ends up as mutton', 'is roasted on an orc spit',
         'is eaten, wool and all', 'goes into a troll stew']


def ovinate(e, t):
    """t becomes a sheep: a new unit of the Alliance's in its place, worth
    points to the Dark Host if it is killed, and to the Alliance if it is
    driven off the west edge."""
    h = t.hex
    hero = t.kind in HEROES
    s = e.spawn(dict(
        id='sheep-' + t.id, side=t.side, type='sheep',
        name=t.name if hero else 'SHEEP', a=0, d=1, m=4, steps=1,
        long=('A sheep that was %s' % called(t)) if hero else
        'A flock that was %s' % called(t),
        vp=HERO_SHEEP_VP if hero else SHEEP_VP, hex=hid(h),
        colour='#bccc98', formation='The flock', was=t.id,
        fate=e.rng.choice(FATES)))
    s.mp = 0
    s.seen = True
    e.remove(t)
    e.flags.setdefault('sheep', []).append(t.id)
    if hero:
        e.say('%s is now a sheep!' % t.long)
    else:
        e.say('Baa! The spell turns %s into a flock of sheep.' % called(t))
    e.events.append(('sound', 'baa'))
    e.events.append(('popup', h, 'Baa!', '#ffffff'))


def unbind(e):
    """The Witch-King is dead, and his spells die with him: every sheep
    still on the map is itself again."""
    back = []
    for s in [x for x in e.alive() if x.kind == 'sheep']:
        u = e.units[s.spec['was']]
        h = s.hex
        e.remove(s)
        u.status = 'map'
        u.hex = h
        u.mp = 0
        u.moved = u.attacked = u.fired = True
        back.append(u)
        e.flags.setdefault('restored', []).append(u.id)
        e.events.append(('popup', h, 'restored', '#ffe080'))
    e.changed()
    if back:
        e.say('His spells die with him: %d sheep %s %s again.' % (
            len(back), 'is' if len(back) == 1 else 'are',
            'itself' if len(back) == 1 else 'themselves'))


# ----------------------------------------------------------- the turns

def ON_TURN(e, side):
    if side == 'wk':
        for uid, c in CASTERS.items():
            u = e.units[uid]
            if u.alive and power(e, uid) < c['power']:
                e.flags.setdefault('power', {})[uid] = power(e, uid) + 1
    if e.turn == 1:
        if side == 'al':
            e.say("Prince Aldric's banners go up over Aldermere. In "
                  "Silverwood the elves string their bows.")
        else:
            e.say('In Nightspire the Witch-King opens his book of '
                  'spells. His horde is already on the road west.')
    if e.turn == 2 and side == 'al':
        e.say('Horns in the Ironhills: the dwarves of Ironhold are '
              'coming.')
    if e.weather()['id'] == 'night' and side == 'wk' and \
            e.weather(e.turn - 1)['id'] != 'night':
        e.say('Night falls, and the dead walk.')


def ON_ELIMINATE(e, u, where):
    if u.id == KING:
        e.flags['king_dead'] = e.turn
        e.say('The Witch-King is dead, and the dead falter.')
        for x in [x for x in e.alive('wk') if x.type.get('undead')]:
            e.take_losses([x], 1)
        unbind(e)


def ON_END_TURN(e):
    if e.control.get(parse(CITADEL)) == 'al':
        e.finish('al', 'Allied victory: Nightspire has fallen. The '
                 'banners of Aldermere, Silverwood and Ironhold fly '
                 'over the Witch-King\'s tower. %s %s'
                 % (_score(e), epilogue(e)))
    elif e.control.get(parse(CITY)) == 'wk':
        e.finish('wk', 'Dark victory: Aldermere burns. The Witch-King '
                 'has his revenge, and the Alliance has nothing to go '
                 'home to. %s %s' % (_score(e), epilogue(e)))


def lead(e, side, hexes):
    """The heroes of side in hexes: the column shift they give, at most
    2, and their names."""
    hs = [u for u in e.alive(side) if u.kind in HEROES and u.hex in hexes]
    n = min(2, sum(u.spec.get('lead', 0) for u in hs))
    return n, ', '.join(u.name.title() for u in hs)


FORTRESSES = ('citadel', 'tower', 'city')


def COMBAT_SHIFTS(e, target, attackers, support):
    """Heroes lead: those with the attackers add their columns, those
    with the defenders take them away.  Brokk is good at walls, and at
    night the dead fight harder."""
    out = []
    me, them = e.side, e.enemy(e.side)
    if attackers:
        n, names = lead(e, me, {u.hex for u in attackers})
        if n:
            out.append((n, names))
        b = e.units.get(SAPPER)
        if b and b.alive and b.side == me and \
                b.hex in {u.hex for u in attackers} and \
                e.board.terrain_name(target) in FORTRESSES:
            out.append((1, "Brokk's sappers"))
        if me == 'wk' and e.weather()['id'] == 'night' and \
                any(u.type.get('undead') for u in attackers):
            out.append((1, 'the dead by night'))
    n, names = lead(e, them, {target})
    if n:
        out.append((-n, names))
    return out


