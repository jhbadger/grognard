def SCORE(e, side):
    """The Germans score objectives, exits and American losses; the
    Americans score German losses, Assenois, where the relief came in,
    and 5 VP for holding Bastogne."""
    vp = e.vp(side)
    if side == 'us' and e.control.get(grognard.parse('1310')) == 'us':
        vp += 5
    return vp


def VICTORY(e):
    """The margin decides: the Germans must do much better than hold
    their own (the margins are set from games between computer players:
    ./crossroads --simulate 20)."""
    de, us = SCORE(e, 'de'), SCORE(e, 'us')
    m = de - us
    score = 'Germans %d VP, Americans %d.' % (de, us)
    if m >= 15:
        return 'de', ('German victory. %s Bastogne is bypassed and the '
                      'panzers are across the Ourthe.' % score)
    if m >= 11:
        return 'de', 'German marginal victory. %s' % score
    if m >= 4:
        return 'us', ('American marginal victory: the Germans needed 11 VP '
                      'more than the Americans, and got %d. %s Bastogne '
                      'holds.' % (m, score))
    return 'us', ('American victory. %s "Nuts!" Bastogne holds and the '
                  'siege is broken.' % score)


