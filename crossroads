@grognard.icon('crossroads')
def draw_icon(p, n):
    """A seven-pointed star of roads on snow, and a red objective at the
    middle."""
    import math
    p.fill('#dfe5e6')
    c = n / 2
    for k in range(7):
        a = math.radians(k * 360 / 7 - 90)
        p.line(c, c, c + math.cos(a) * n, c + math.sin(a) * n,
               '#4a3a28', max(2, n // 9))
        p.line(c, c, c + math.cos(a) * n, c + math.sin(a) * n,
               '#d8c8a0', max(1, n // 16))
    p.disc(c, c, n * 0.2, '#b02020')
    p.disc(c, c, n * 0.12, '#f0e0c0')


